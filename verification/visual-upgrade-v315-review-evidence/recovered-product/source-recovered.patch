+}
+@media (pointer: coarse) {
+  button, .mini button, .coordinate-aid-bar button, select, input[type="text"], input[type="number"] { min-height: 44px; }
+  aside details > summary { padding-block: 7px; }
+}
+@media (prefers-reduced-motion: reduce) { button { transition: none; } }
