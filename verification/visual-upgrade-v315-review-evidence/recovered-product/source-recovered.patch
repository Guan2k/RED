+footer { color: #91a78f; font-size: 11px; line-height: 1.8; padding-bottom: 20px; }
+@media (max-width: 1100px) and (min-width: 851px) {
+  main { grid-template-columns: minmax(0, 1fr) 290px; padding: 12px; gap: 12px; }
