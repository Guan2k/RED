let selectionClickCandidate=null,lastSelectionClick=0,doubleClickSelection=false;
function resetSelectionClicks(){clearOrdinaryCommand();selectionClickCandidate=null;lastSelectionClick=0;doubleClickSelection=false}
function cancelPendingSelection(){if(commandBlocked()||!(placement||attackMode||ordinaryCommandMode||appendCommandMode||drag))return;resetSelectionClicks();placement=null;attackMode=false;drag=null;clearOrdinaryCommand();updateUI()}
$('cancelPending').onclick=cancelPendingSelection;
// Explicit ordinary and append modes share a release-committed point gesture.
// No pointerdown/click/dblclick dispatch; cancellation before release cannot issue.
const ORDINARY_COMMAND_HINT='普通指令：点空地移动、敌军指定攻击、矿点采矿或友军护航／跟随；按原兵种规则执行。取消可退出。';
const APPEND_COMMAND_HINT='追加队列：点空地追加路线、点敌军追加攻击目标；仅符合原队列规则的战斗车接收，矿车、维修车和工厂保留原命令。松开点选后退出；取消可退出。';
function appendCommandReason(){return commandBlocked()?'当前不能下令：尚未开始、重新部署确认或战局结束':!state.entities.some(e=>selection.has(e.id)&&e.team===0&&e.hp>0&&!e.build&&defs[e.type].speed&&defs[e.type].damage)?'先选择存活且已完成的友方战斗车辆':''}
function ordinaryCommandReason(){return commandBlocked()?'当前不能下令：尚未开始、重新部署确认或战局结束':!state.entities.some(e=>selection.has(e.id)&&e.team===0&&e.hp>0&&(defs[e.type].speed||e.type==='factory'&&!e.build))?'先选择存活友方车辆或已完工工厂':''}
function clearOrdinaryCommand(){cancelCoordinateConstructionActivation();cancelCoordinateCommandActivation();clearOrdinaryPreviewMirror();cancelFactoryExitActivation();if(ordinaryCommandActivation)ordinaryCommandActivation.canceled=true;if(appendCommandActivation)appendCommandActivation.canceled=true;let pending=ordinaryCommandMode||appendCommandMode||ordinaryCommandGesture;ordinaryCommandMode=false;appendCommandMode=false;ordinaryCommandGesture=null;if(pending){selectionClickCandidate=null;lastSelectionClick=0;doubleClickSelection=false}}
// Reset-only retirement: keep stale-click tombstones while releasing the outgoing battle.
function retireCanceledCommandActivationReferences(){for(let a of [ordinaryCommandActivation,appendCommandActivation,coordinateAttackActivation,factoryExitActivation,coordinateCommandActivation,coordinateAppendActivation])if(a?.canceled)a.battle=null;if(factoryExitActivation?.canceled){factoryExitActivation.factory=null;factoryExitActivation.order=null}}
function updateOrdinaryCommandControl(){if(ordinaryCommandMode&&commandBlocked())clearOrdinaryCommand();let reason=ordinaryCommandReason(),button=$('ordinaryCommand');button.disabled=!!reason;button.title=reason||ORDINARY_COMMAND_HINT;button.setAttribute('aria-pressed',String(ordinaryCommandMode));button.style.borderColor=ordinaryCommandMode?'#f4cf81':''}
function updateAppendCommandControl(){if(appendCommandMode&&commandBlocked())clearOrdinaryCommand();let reason=appendCommandReason(),button=$('appendCommand');button.disabled=!!reason;button.title=reason||APPEND_COMMAND_HINT;button.setAttribute('aria-pressed',String(appendCommandMode));button.style.borderColor=appendCommandMode?'#f4cf81':''}
function armAppendCommand(){if(appendCommandReason())return;resetSelectionClicks();placement=null;attackMode=false;drag=null;appendCommandMode=true;updateUI()}
function armOrdinaryCommand(){if(ordinaryCommandReason())return;resetSelectionClicks();placement=null;attackMode=false;drag=null;ordinaryCommandMode=true;updateUI()}
// Explicit keyboard-reachable ordinary coordinates; field edits never issue orders.
function coordinateCommandPoint(){let x=$('coordinateCommandX').value,y=$('coordinateCommandY').value;if(!/^[0-9]+$/.test(x)||!/^[0-9]+$/.test(y))return null;x=Number(x);y=Number(y);return Number.isSafeInteger(x)&&Number.isSafeInteger(y)&&x>=0&&x<=WIDTH&&y>=0&&y<=HEIGHT?{x,y}:null}
function coordinateCommandReason(){return ordinaryCommandReason()||(!coordinateCommandPoint()?'请填写纯数字整数：X为0–1200，Y为0–800；不接受空白、符号、小数或指数':'')}
function updateCoordinateCommandControl(){updateCoordinateAttackControl();updateCoordinateAppendControl();let blocked=commandBlocked(),reason=coordinateCommandReason();$('coordinateCommandX').disabled=blocked;$('coordinateCommandY').disabled=blocked;$('coordinateCommandExecute').disabled=!!reason;setReadonlyPanelProperty($('coordinateCommandStatus'),'textContent',reason||'坐标有效；仅点击执行按钮才下令，以操作时的选区、目标和命令回执为准');setReadonlyPanelProperty($('coordinateCommandExecute'),'title',reason||'替换式普通指令，不追加队列；不保证抵达')}
function resetCoordinateCommandFields(){for(let id of ['coordinateCommandX','coordinateCommandY'])$(id).value='';$('coordinateCommandPanel').open=false;cancelCoordinateCommandActivation()}
function cancelCoordinateCommandActivation(e){if(!e)cancelCoordinateAppendActivation();if(!e)cancelCoordinateAttackActivation();let a=coordinateCommandActivation;if(a&&(!e||a.kind==='pointer'&&a.pointerId===e.pointerId))a.canceled=true}
function validCoordinateCommandActivation(){let a=coordinateCommandActivation;return !a||a.battle===state&&!a.canceled&&!a.consumed&&(a.kind==='pointer'?a.released:a.key!==' '||a.released)}
function executeCoordinateCommand(){if(!validCoordinateCommandActivation()||coordinateCommandReason())return;let p=coordinateCommandPoint();if(!p)return;if(coordinateCommandActivation)coordinateCommandActivation.consumed=true;resetSelectionClicks();placement=null;attackMode=false;drag=null;issue(p,false,false);updateUI()}
for(let id of ['coordinateCommandX','coordinateCommandY'])$(id).oninput=()=>{cancelCoordinateCommandActivation();updateCoordinateCommandControl()};
$('coordinateCommandExecute').onclick=executeCoordinateCommand;
$('coordinateCommandExecute').onpointerdown=e=>{if(e.isPrimary===false||e.button!==0||coordinateCommandReason())return;let a=coordinateCommandActivation;if(a?.kind==='pointer'&&!a.released&&!a.canceled&&a.pointerId!==e.pointerId)return;cancelCoordinateAttackActivation();coordinateCommandActivation={kind:'pointer',pointerId:e.pointerId,battle:state,released:false,consumed:false,canceled:false}};
$('coordinateCommandExecute').onpointerup=e=>{let a=coordinateCommandActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.isPrimary!==false&&e.button===0)a.released=true};
$('coordinateCommandExecute').onpointercancel=cancelCoordinateCommandActivation;
$('coordinateCommandExecute').onlostpointercapture=e=>{if(coordinateCommandActivation&&!coordinateCommandActivation.released)cancelCoordinateCommandActivation(e)};
$('coordinateCommandExecute').onkeydown=e=>{if(e.isComposing||e.keyCode===229||!['Enter',' '].includes(e.key)||coordinateCommandReason())return;if(e.repeat){e.preventDefault();if(!coordinateCommandActivation)coordinateCommandActivation={kind:'key',key:e.key,battle:state,released:false,consumed:true,canceled:true};return}cancelCoordinateAttackActivation();coordinateCommandActivation={kind:'key',key:e.key,battle:state,released:false,consumed:false,canceled:false}};
$('coordinateCommandExecute').onkeyup=e=>{let a=coordinateCommandActivation;if(a?.kind==='key'&&a.key===e.key)a.released=true};
$('coordinateCommandExecute').onblur=()=>{if(coordinateCommandActivation&&!coordinateCommandActivation.consumed)coordinateCommandActivation.canceled=true};
window.addEventListener('pointerup',e=>{if(e.target!==$('coordinateCommandExecute'))cancelCoordinateCommandActivation(e)});
// Coordinate append shares parsing but never changes ordinary replacement semantics.
