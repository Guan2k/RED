function controlGroupDescription(i,members=controlGroupMembers(i)){if(!Number.isInteger(i)||i<0||i>2)return '';let number=i+1;if(!members.length)return '编队'+number+'：暂无存活成员\n先选择己方车辆，再按Ctrl/⌘+'+number+'保存；也可Ctrl+点击此按钮';let counts=new Map(),hp=0,max=0;for(let e of members){counts.set(defs[e.type].name,(counts.get(defs[e.type].name)||0)+1);hp+=Math.max(0,e.hp);max+=e.max}return '编队'+number+'：当前存活'+members.length+'个成员\n'+[...counts].map(([name,count])=>name+'×'+count).join('、')+'\n合计生命'+Math.ceil(hp)+'/'+max+'（不表示每辆车均健康）\n点击或按'+number+'召回；Ctrl+点击或Ctrl/⌘+'+number+'保存当前选择'}
// All save routes preserve an existing group when no live friendly vehicle is selected; recall stays unchanged.
function controlGroupAddition(i){if(!Number.isInteger(i)||i<0||i>2)return null;let members=controlGroupMembers(i).filter(e=>defs[e.type]?.speed),ids=members.map(e=>e.id),seen=new Set(ids),added=[];for(let e of state.entities)if(selection.has(e.id)&&e.team===0&&e.hp>0&&defs[e.type]?.speed&&!seen.has(e.id)){seen.add(e.id);ids.push(e.id);added.push(e.id)}return{ids,added}}
