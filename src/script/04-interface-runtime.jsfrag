function idleCombatUnits(){let candidates=state.entities.filter(e=>e.team===0&&e.hp>0&&defs[e.type].speed&&defs[e.type].damage&&!e.build&&!e.attackQueue&&!e.hold&&!e.patrol&&!e.guardArea&&!e.escortId&&!e.goal&&!(e.target&&get(e.target))&&!e.cool);if(!candidates.length)return candidates;let enemies=state.entities.filter(e=>e.team!==0&&e.hp>0);if(!enemies.length)return candidates;if(candidates.length*enemies.length<4096)return candidates.filter(e=>!enemies.some(b=>withinRange(e,b,defs[e.type].range+50)));let minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;for(let b of enemies){if(b.x<minX)minX=b.x;if(b.x>maxX)maxX=b.x;if(b.y<minY)minY=b.y;if(b.y>maxY)maxY=b.y}return candidates.filter(e=>{let r=defs[e.type].range+50;return e.x-maxX>=r||e.x-minX<=-r||e.y-maxY>=r||e.y-minY<=-r||!enemies.some(b=>withinRange(e,b,r))})}
function ownHarvesters(){return state.entities.filter(e=>e.team===0&&e.hp>0&&e.type==='harvester')}
function allDamagedCombatUnits(){return state.entities.filter(e=>canSetFirePriority(e)&&e.hp<e.max)}
function selectAllDamagedCombat(){if(commandBlocked())return;let units=allDamagedCombatUnits();if(!units.length){tell('当前没有受损战斗车，保留原选择与待点选操作');updateUI();return}resetSelectionClicks();selection=new Set(units.map(e=>e.id));placement=null;attackMode=false;drag=null;clearOrdinaryCommand();tell('已从全图选择 '+units.length+' 辆受损战斗车（含轻伤）；原命令保留，不自动撤退或修理');updateUI()}
function damagedCombatUnits(){return state.entities.filter(e=>e.team===0&&e.hp>0&&e.hp<=e.max*.5&&!e.build&&defs[e.type].speed&&defs[e.type].damage)}
const selectionFilterTypes=Object.freeze({combat:Object.freeze({id:'filterSelectionCombat',label:'战斗车'}),damaged:Object.freeze({id:'filterSelectionDamaged',label:'受损战斗车'}),tank:Object.freeze({id:'filterSelectionTank',label:'坦克'}),scout:Object.freeze({id:'filterSelectionScout',label:'侦察车'}),artillery:Object.freeze({id:'filterSelectionArtillery',label:'火炮'}),repair:Object.freeze({id:'filterSelectionRepair',label:'维修车'}),harvester:Object.freeze({id:'filterSelectionHarvester',label:'矿车'})});
function selectionFilterView(selected){let types={tank:[],scout:[],artillery:[],repair:[],harvester:[]},combat=selected.filter(canSetFirePriority),damaged=combat.filter(e=>e.hp<e.max),critical=null;for(let e of selected){if(e.team!==0||e.hp<=0||e.build||!Object.hasOwn(types,e.type))continue;types[e.type].push(e);if(canSetFirePriority(e)&&e.hp<e.max&&(!critical||e.hp/e.max<critical.hp/critical.max||e.hp/e.max===critical.hp/critical.max&&e.id<critical.id))critical=e}return{types,combat,damaged,critical}}
function applySelectionFilter(kind){if(commandBlocked())return;let view=selectionFilterView(state.entities.filter(e=>selection.has(e.id))),targets=kind==='damaged'?view.damaged:kind==='combat'?view.combat:kind==='critical'?(view.critical?[view.critical]:[]):typeof kind==='string'&&Object.hasOwn(view.types,kind)?view.types[kind]:[];if(!targets.length||targets.length===selection.size)return;selection=new Set(targets.map(e=>e.id));resetSelectionClicks();placement=null;attackMode=false;drag=null;clearOrdinaryCommand();updateUI()}
function updateSelectionFilters(selected){let view=selectionFilterView(selected),blocked=commandBlocked();for(let [kind,config]of Object.entries(selectionFilterTypes)){let b=$(config.id),count=(kind==='damaged'?view.damaged:kind==='combat'?view.combat:view.types[kind]).length;setReadonlyPanelProperty(b,'textContent','仅选'+config.label+' '+count);b.disabled=blocked||!count||count===selection.size;setReadonlyPanelProperty(b,'title',kind==='damaged'?'仅保留当前选区内存活、已完工且生命低于自身满值的己方战斗车（坦克、侦察车、火炮），含轻伤；只改变选择，不扩大到全图，不改命令或编队，不自动撤退或修理。':'仅保留当前选区内存活且已完成的己方'+config.label+(kind==='combat'?'（坦克、侦察车、火炮）':'')+'；不扩大到全图，不改命令或编队成员。')}let b=$('filterSelectionCritical');b.disabled=blocked||!view.critical||selection.size<=1;setReadonlyPanelProperty(b,'title','只在当前选区选一辆受损战斗车（含轻伤）：最低生命比例优先，同率按编号；不选满血车辆，不是战略优先推荐。不撤退、不修理，原命令与编队成员保留。')}
// This choice holds both battle and entity identity; recycled numeric IDs never retarget it.
let selectionRemovalTarget=null,selectionRemovalActivation=null,selectionRemovalRows=new Map(),selectionRemovalMessage='';
function selectionRemovalEligible(e){return !!(e&&e.team===0&&e.hp>0&&get(e.id)===e&&selection.has(e.id))}
function selectionRemovalCurrent(){let t=selectionRemovalTarget;return !commandBlocked()&&t?.battle===state&&$('selectionRemoveTarget').value===String(t.entity.id)&&selectionRemovalEligible(t.entity)?t.entity:null}
function cancelSelectionRemovalActivation(){if(selectionRemovalActivation){selectionRemovalActivation.canceled=true;selectionRemovalActivation.target=null}}
function clearSelectionRemovalChoice(){cancelSelectionOnlyActivation();selectionRemovalTarget=null;cancelSelectionRemovalActivation();$('selectionRemoveTarget').value=''}
function selectionRemovalLabel(e){return defs[e.type].name+' #'+e.id+' · X '+Math.round(e.x)+' · Y '+Math.round(e.y)}
function updateSelectionRemoval(selected){let blocked=commandBlocked(),candidates=selected.filter(selectionRemovalEligible),wanted=new Set(candidates);if(!selectionRemovalCurrent())clearSelectionRemovalChoice();let select=$('selectionRemoveTarget');for(let [e,node]of selectionRemovalRows)if(!wanted.has(e)){node.remove();selectionRemovalRows.delete(e)}for(let e of candidates){let node=selectionRemovalRows.get(e);if(!node){node=document.createElement('option');node.value=String(e.id);node.setAttribute('data-selection-remove-option','true');selectionRemovalRows.set(e,node);select.appendChild(node)}let label=selectionRemovalLabel(e);if(node.textContent!==label)node.textContent=label}select.value=selectionRemovalCurrent()?String(selectionRemovalTarget.entity.id):'';select.disabled=blocked||!candidates.length;$('selectionRemoveExecute').disabled=!selectionRemovalCurrent();updateSelectionOnlyControl();setReadonlyPanelProperty($('selectionRemoveStatus'),'textContent',blocked?'当前不可移出：尚未开战、重开菜单或战局结束。':selectionRemovalMessage|| (selectionRemovalCurrent()?'已指定：'+defs[selectionRemovalTarget.entity.type].name+' #'+selectionRemovalTarget.entity.id+'；选择操作按钮才执行。':candidates.length?'先在下拉框选择具体单位；不会自动选择下一辆。':'当前没有可移出的己方单位。'))}
$('selectionRemoveTarget').onchange=()=>{cancelSelectionOnlyActivation();cancelSelectionRemovalActivation();selectionRemovalMessage='';let value=$('selectionRemoveTarget').value,e=state.entities.find(e=>String(e.id)===value&&selectionRemovalEligible(e));selectionRemovalTarget=!commandBlocked()&&e?{battle:state,entity:e}:null;updateUI()};
function selectionRemovalActivationValid(){let a=selectionRemovalActivation;return !a||!a.canceled&&!a.consumed&&a.target===selectionRemovalTarget&&(a.kind==='pointer'?a.released:a.key!==' '||a.released)}
function executeSelectionRemoval(){let e=selectionRemovalCurrent();if(!e||!selectionRemovalActivationValid())return;if(selectionRemovalActivation)selectionRemovalActivation.consumed=true;selection.delete(e.id);selectionRemovalMessage='已从选区移出 '+selectionRemovalLabel(e)+'；原命令与编队保留。';clearSelectionRemovalChoice();updateUI()}
$('selectionRemoveExecute').onclick=executeSelectionRemoval;
$('selectionRemoveExecute').onpointerdown=e=>{if(e.isPrimary===false||e.button!==0||!selectionRemovalCurrent())return;let a=selectionRemovalActivation;if(a?.kind==='pointer'&&!a.released&&!a.canceled&&a.pointerId!==e.pointerId)return;cancelSelectionOnlyActivation();selectionRemovalActivation={kind:'pointer',pointerId:e.pointerId,target:selectionRemovalTarget,released:false,consumed:false,canceled:false}};
$('selectionRemoveExecute').onpointerup=e=>{let a=selectionRemovalActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.isPrimary!==false&&e.button===0)a.released=true};
$('selectionRemoveExecute').onpointercancel=cancelSelectionRemovalActivation;
$('selectionRemoveExecute').onlostpointercapture=()=>{if(selectionRemovalActivation&&!selectionRemovalActivation.released)cancelSelectionRemovalActivation()};
$('selectionRemoveExecute').onkeydown=e=>{if(e.isComposing||e.keyCode===229||!['Enter',' '].includes(e.key)||!selectionRemovalCurrent())return;if(e.repeat){e.preventDefault();if(!selectionRemovalActivation)selectionRemovalActivation={canceled:true};return}cancelSelectionOnlyActivation();selectionRemovalActivation={kind:'key',key:e.key,target:selectionRemovalTarget,released:false,consumed:false,canceled:false}};
$('selectionRemoveExecute').onkeyup=e=>{let a=selectionRemovalActivation;if(a?.kind==='key'&&a.key===e.key)a.released=true};
$('selectionRemoveExecute').onblur=()=>{if(selectionRemovalActivation&&!selectionRemovalActivation.consumed)cancelSelectionRemovalActivation()};
window.addEventListener('pointerup',e=>{let a=selectionRemovalActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.target!==$('selectionRemoveExecute'))cancelSelectionRemovalActivation()});
window.addEventListener('blur',cancelSelectionRemovalActivation);
document.addEventListener('visibilitychange',()=>{if(document.hidden)cancelSelectionRemovalActivation()});
window.addEventListener('keydown',e=>{if(e.key==='Escape'&&!e.isComposing&&e.keyCode!==229)cancelSelectionRemovalActivation()});
// Explicit singleton selection shares only the validated dropdown target, not activation tokens.
let selectionOnlyActivation=null;
function selectionOnlyCurrent(){let e=selectionRemovalCurrent();return e&&selection.size>1?e:null}
function cancelSelectionOnlyActivation(){if(selectionOnlyActivation){selectionOnlyActivation.canceled=true;selectionOnlyActivation.target=null}}
function selectionOnlyActivationValid(){let a=selectionOnlyActivation;return !a||!a.canceled&&!a.consumed&&a.target===selectionRemovalTarget&&(a.kind==='pointer'?a.released:a.key!==' '||a.released)}
function updateSelectionOnlyControl(){let e=selectionOnlyCurrent();$('selectionOnlyExecute').disabled=!e;setReadonlyPanelProperty($('selectionOnlyExecute'),'title',e?'仅保留 '+selectionRemovalLabel(e)+' 在选区；原命令与编队保留':selectionRemovalCurrent()?'此单位已是唯一选中，无需缩选':'先在下拉框选择当前已选的己方单位')}
function executeSelectionOnly(){let e=selectionOnlyCurrent();if(!e||!selectionOnlyActivationValid())return;if(selectionOnlyActivation)selectionOnlyActivation.consumed=true;selection=new Set([e.id]);resetSelectionClicks();placement=null;attackMode=false;drag=null;clearOrdinaryCommand();selectionRemovalMessage='已仅选 '+selectionRemovalLabel(e)+'；原命令与编队保留。';clearSelectionRemovalChoice();updateUI()}
$('selectionOnlyExecute').onclick=executeSelectionOnly;
$('selectionOnlyExecute').onpointerdown=e=>{if(e.isPrimary===false||e.button!==0||!selectionOnlyCurrent())return;let a=selectionOnlyActivation;if(a?.kind==='pointer'&&!a.released&&!a.canceled&&a.pointerId!==e.pointerId)return;cancelSelectionRemovalActivation();selectionOnlyActivation={kind:'pointer',pointerId:e.pointerId,target:selectionRemovalTarget,released:false,consumed:false,canceled:false}};
$('selectionOnlyExecute').onpointerup=e=>{let a=selectionOnlyActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.isPrimary!==false&&e.button===0)a.released=true};
$('selectionOnlyExecute').onpointercancel=cancelSelectionOnlyActivation;
$('selectionOnlyExecute').onlostpointercapture=()=>{if(selectionOnlyActivation&&!selectionOnlyActivation.released)cancelSelectionOnlyActivation()};
$('selectionOnlyExecute').onkeydown=e=>{if(e.isComposing||e.keyCode===229||!['Enter',' '].includes(e.key)||!selectionOnlyCurrent())return;if(e.repeat){e.preventDefault();if(!selectionOnlyActivation)selectionOnlyActivation={canceled:true};return}cancelSelectionRemovalActivation();selectionOnlyActivation={kind:'key',key:e.key,target:selectionRemovalTarget,released:false,consumed:false,canceled:false}};
$('selectionOnlyExecute').onkeyup=e=>{let a=selectionOnlyActivation;if(a?.kind==='key'&&a.key===e.key)a.released=true};
$('selectionOnlyExecute').onblur=()=>{if(selectionOnlyActivation&&!selectionOnlyActivation.consumed)cancelSelectionOnlyActivation()};
window.addEventListener('pointerup',e=>{let a=selectionOnlyActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.target!==$('selectionOnlyExecute'))cancelSelectionOnlyActivation()});
window.addEventListener('blur',cancelSelectionOnlyActivation);
document.addEventListener('visibilitychange',()=>{if(document.hidden)cancelSelectionOnlyActivation()});
window.addEventListener('keydown',e=>{if(e.key==='Escape'&&!e.isComposing&&e.keyCode!==229)cancelSelectionOnlyActivation()});
// Fresh reverse assignment view; reuse the UI's selection snapshot and never cache across refreshes.
function selectedMinerFollowers(selected){let view={units:[],combat:0,repair:0};if(selection.size!==1||selected.length!==1)return view;let miner=selected[0];if(miner.team!==0||miner.type!=='harvester'||miner.hp<=0||miner.build)return view;for(let e of state.entities){if(e.team!==0||e.hp<=0||e.build||e.escortId!==miner.id||!validEscort(e,miner))continue;if(canSetFirePriority(e)){view.units.push(e);view.combat++}else if(e.type==='repair'){view.units.push(e);view.repair++}}return view}
// One completed paid order at one selected factory; never assign or advance it.
let factorySpawnSnapshot=null;
function factorySpawnCheckFactory(){if(selection.size!==1)return null;let e=get(selection.values().next().value);return e&&e.team===0&&e.type==='factory'&&!e.build?e:null}
function updateFactorySpawnCheck(){let factory=factorySpawnCheckFactory(),blocked=commandBlocked();if(!factory||blocked||factorySpawnSnapshot&&(factorySpawnSnapshot.battle!==state||factorySpawnSnapshot.factory!==factory))factorySpawnSnapshot=null;setReadonlyPanelProperty($('factorySpawnCheckRow'),'hidden',!factory);setReadonlyPanelProperty($('checkFactorySpawn'),'disabled',!factory||blocked);let snapshot=factorySpawnSnapshot,lines=snapshot?['本厂出厂空间检查快照 · 工厂 #'+factory.id+' · 检查时坐标 X '+Math.round(snapshot.x)+' · Y '+Math.round(snapshot.y),'检查时游戏时间 '+snapshot.at.toFixed(2)+' 秒'+(snapshot.paused?'（当时暂停）':''),...snapshot.results.map(row=>defs[row.type].name+'：'+(row.point?'有开放候选点（X '+Math.round(row.point.x)+' · Y '+Math.round(row.point.y)+'）':'暂无开放候选点')),'坐标四舍五入；结果不会自动刷新。移动或建造后请重新检查。','仅检查当时出厂空间，不检查资金、电力或排产；不保证完工时能出厂或后续道路畅通。']:[blocked?'当前不能检查：尚未开战、重开菜单或战局结束。':'点击检查五种车型的当前出厂空间；只读，不下单或移动车辆。'];setReadonlyPanelProperty($('factorySpawnCheckStatus'),'textContent',lines.join('\n'))}
function checkFactorySpawn(){let factory=factorySpawnCheckFactory();if(!factory||commandBlocked()){updateFactorySpawnCheck();return false}let results=['tank','scout','artillery','repair','harvester'].map(type=>{let p=spawnPosition(factory,type,0);return{type,point:p?{x:p.x,y:p.y}:null}});factorySpawnSnapshot={battle:state,factory,x:factory.x,y:factory.y,at:state.t,paused:state.paused,results};updateFactorySpawnCheck();return true}
$('checkFactorySpawn').onclick=checkFactorySpawn;$('checkFactorySpawn').onkeydown=e=>{if(e.key==='Enter'&&e.repeat&&!e.isComposing&&e.keyCode!==229)e.preventDefault()};
function factoryExitSelectionContext(){let factory=selection.size===1?get(selection.values().next().value):null;if(!factory||factory.team!==0||factory.type!=='factory'||factory.build)return{factory:null,order:null,reason:'先单独选择已完工的己方工厂'};let order=state.queue.find(q=>q.factoryId===factory.id);return{factory,order,reason:commandBlocked()?'当前不能选择：尚未开始、重新部署确认或战局结束':!order?'本厂当前没有已绑定的已付订单':order.left>0||!order.waitingForExit?'本厂没有已完成且等待出口的订单':''}}
// Exact current collision inputs, one entity pass. No clock-based cache and no
// use of waitingForExit as a geometry claim. At most one gated factory is cached.
function factoryExitGeometryKey(factory,type){return JSON.stringify([state.mapChoice,WIDTH,HEIGHT,defs[type].r,factory.id,factory.x,factory.y,factory.r,state.entities.filter(e=>e.hp>0).map(e=>[e.id,!!defs[e.type].speed,e.team,e.x,e.y,e.r])])}
function factoryExitSelectionView(fresh=false){let view=factoryExitSelectionContext();if(view.reason)return view;let {factory,order}=view,key=fresh?null:factoryExitGeometryKey(factory,order.type),cache=factoryExitInspectionCache,inspection;if(!fresh&&cache&&cache.battle===state&&cache.factory===factory&&cache.order===order&&cache.type===order.type&&cache.key===key)inspection=cache.inspection;else{inspection=factorySpawnSearch(factory,order.type,0,true);if(!fresh)factoryExitInspectionCache={battle:state,factory,order,type:order.type,key,inspection}}return{...view,...inspection,reason:inspection.open?'当前已有开放出厂点，无需选择占位车辆':!inspection.staticCount?'当前候选点均受边界、建筑或地形阻挡':!inspection.candidate?'当前没有仅由友军占位的候选点：可用候选均有敌军占位':''}}
function cancelFactoryExitActivation(){if(factoryExitActivation)factoryExitActivation.canceled=true}
function factoryExitActivationMatches(a,view=factoryExitSelectionContext()){return !!a&&a.battle===state&&!view.reason&&a.factory===view.factory&&a.order===view.order&&a.type===view.order.type}
function updateFactoryExitSelectionControl(){let view=factoryExitSelectionView(),button=$('selectFactoryExitOccupants');if(factoryExitActivation&&!factoryExitActivationMatches(factoryExitActivation,view))cancelFactoryExitActivation();setReadonlyPanelProperty($('factoryExitSelectionRow'),'hidden',!view.factory);setReadonlyPanelProperty(button,'disabled',!!view.reason);setReadonlyPanelProperty(button,'title',view.reason||'按现有出厂搜索顺序，仅选择第一个静态有效且无敌军占位候选点上的全部友军；请另行移动，不保证立即出厂');setReadonlyPanelProperty($('factoryExitSelectionStatus'),'textContent',view.reason||'当前候选点占位友军 '+view.candidate.ids.length+' 辆；仅选择，请自行下达移动命令。'+(state.paused?'当前暂停，需恢复模拟。':'')+(!powered()?'当前缺电，生产仍需恢复供电。':'')+'不保证移开后立即出厂。');if(!view.factory)factoryExitInspectionCache=null}
function selectFactoryExitOccupants(){let view=factoryExitSelectionView(true);if(view.reason){if(view.factory)tell(view.reason+'；保留当前选择');updateUI();return false}let {factory,candidate}=view;resetSelectionClicks();selection=new Set(candidate.ids);placement=null;attackMode=false;drag=null;clearOrdinaryCommand();tell('已选择工厂（'+Math.round(factory.x)+'，'+Math.round(factory.y)+'）一个出厂候选点上的 '+candidate.ids.length+' 辆占位友军；原命令保持，请另行下达移动命令，不保证立即出厂');updateUI();return true}
function validFactoryExitActivation(){let a=factoryExitActivation;return !a||factoryExitActivationMatches(a)&&!a.canceled&&!a.consumed&&(a.kind==='pointer'?a.released:a.key!==' '||a.released)}
$('selectFactoryExitOccupants').onclick=()=>{if(!validFactoryExitActivation())return;if(factoryExitActivation)factoryExitActivation.consumed=true;selectFactoryExitOccupants()};
$('selectFactoryExitOccupants').onpointerdown=e=>{if(e.isPrimary===false||e.button!==0)return;let previous=factoryExitActivation;if(previous?.kind==='pointer'&&!previous.released&&!previous.canceled&&previous.pointerId!==e.pointerId)return;let view=factoryExitSelectionView();factoryExitActivation={kind:'pointer',pointerId:e.pointerId,battle:state,factory:view.factory,order:view.order,type:view.order?.type,released:false,consumed:false,canceled:!!view.reason}};
$('selectFactoryExitOccupants').onpointerup=e=>{let a=factoryExitActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.isPrimary!==false&&e.button===0){if(!factoryExitActivationMatches(a))a.canceled=true;a.released=true}};
$('selectFactoryExitOccupants').onpointercancel=e=>{if(factoryExitActivation?.kind==='pointer'&&factoryExitActivation.pointerId===e.pointerId)cancelFactoryExitActivation()};
$('selectFactoryExitOccupants').onlostpointercapture=e=>{if(factoryExitActivation?.kind==='pointer'&&factoryExitActivation.pointerId===e.pointerId&&!factoryExitActivation.released)cancelFactoryExitActivation()};
$('selectFactoryExitOccupants').onkeydown=e=>{if(e.isComposing||e.keyCode===229||!['Enter',' '].includes(e.key))return;if(e.repeat){e.preventDefault();if(!factoryExitActivation)factoryExitActivation={kind:'key',key:e.key,battle:state,consumed:true,canceled:true};return}let view=factoryExitSelectionView();factoryExitActivation={kind:'key',key:e.key,battle:state,factory:view.factory,order:view.order,type:view.order?.type,released:false,consumed:false,canceled:!!view.reason}};
$('selectFactoryExitOccupants').onkeyup=e=>{let a=factoryExitActivation;if(a?.kind==='key'&&a.key===e.key){if(!factoryExitActivationMatches(a))a.canceled=true;a.released=true}};
$('selectFactoryExitOccupants').onblur=cancelFactoryExitActivation;
window.addEventListener('pointerup',e=>{if(e.target!==$('selectFactoryExitOccupants')&&factoryExitActivation?.kind==='pointer'&&factoryExitActivation.pointerId===e.pointerId)cancelFactoryExitActivation()});
// Resolve from current selection and live entities on both render and activation; never retain a target handle.
function selectedDeliveryRefinery(){if(selection.size!==1)return null;let miner=get(selection.values().next().value);if(!miner||miner.team!==0||miner.type!=='harvester'||miner.build)return null;let context=harvesterWorkContext(),phase=harvesterWorkState(miner,context);return phase==='returning'||phase==='delivery'?nearest(miner,context.refineries(0)):null}
function selectDeliveryRefinery(){if(commandBlocked())return;let target=selectedDeliveryRefinery();if(!target)return;resetSelectionClicks();selection=new Set([target.id]);placement=null;attackMode=false;drag=null;clearOrdinaryCommand();updateUI()}
function updateDeliveryRefinerySelection(){let target=selectedDeliveryRefinery(),blocked=commandBlocked(),button=$('selectDeliveryRefinery');setReadonlyPanelProperty($('deliveryRefineryRow'),'hidden',blocked||!target);setReadonlyPanelProperty(button,'textContent',target?'选择当前交矿精炼厂 · #'+target.id+'（'+Math.round(target.x)+','+Math.round(target.y)+'）':'选择当前交矿精炼厂');setReadonlyPanelProperty(button,'disabled',blocked||!target)}
function selectedEscortTarget(){if(selection.size!==1)return null;let owner=get(selection.values().next().value);if(!owner||owner.team!==0||owner.build)return null;let target=escortDisplayTarget(owner);return target&&!target.build?target:null}
function selectEscortTarget(){if(commandBlocked())return;let target=selectedEscortTarget();if(!target)return;resetSelectionClicks();selection=new Set([target.id]);placement=null;attackMode=false;drag=null;clearOrdinaryCommand();updateUI()}
function updateEscortTargetSelection(){let target=selectedEscortTarget(),button=$('selectEscortTarget');setReadonlyPanelProperty(button,'textContent',target?'选择护航／跟随目标 · '+defs[target.type].name+' #'+target.id:'选择护航／跟随目标');setReadonlyPanelProperty(button,'disabled',commandBlocked()||!target)}
function selectMinerFollowers(){if(commandBlocked()||selection.size!==1)return;let miner=get(selection.values().next().value),view=selectedMinerFollowers(miner?[miner]:[]);if(!view.units.length)return;resetSelectionClicks();selection=new Set(view.units.map(e=>e.id));placement=null;attackMode=false;drag=null;clearOrdinaryCommand();updateUI()}
function updateMinerFollowersSelection(selected){let view=selectedMinerFollowers(selected),button=$('selectMinerFollowers');setReadonlyPanelProperty(button,'textContent','选此矿车护航／跟随 · 战斗 '+view.combat+' · 维修 '+view.repair);setReadonlyPanelProperty(button,'disabled',commandBlocked()||!view.units.length)}
function selectDamagedCombat(){if(commandBlocked())return;let units=damagedCombatUnits();if(!units.length){tell('当前没有生命不超过50%的己方战斗车辆');return}resetSelectionClicks();selection=new Set(units.map(e=>e.id));placement=null;attackMode=false;drag=null;clearOrdinaryCommand();tell('已选择 '+units.length+' 辆重伤战车；原命令保留，可自行下达撤离命令');updateUI()}
function selectAlertMiner(){if(commandBlocked())return;let notice=currentHarvesterAlert();if(!notice)return;resetSelectionClicks();selection=new Set([notice.id]);placement=null;attackMode=false;drag=null;clearOrdinaryCommand();updateUI()}
function selectMiners(){if(commandBlocked())return;let miners=ownHarvesters();resetSelectionClicks();selection=new Set(miners.map(e=>e.id));placement=null;attackMode=false;drag=null;clearOrdinaryCommand();if(!miners.length)tell('当前没有可选的己方采矿车');updateUI()}
function selectIdleCombat(){if(commandBlocked())return;let idle=idleCombatUnits();resetSelectionClicks();selection=new Set(idle.map(e=>e.id));placement=null;attackMode=false;drag=null;clearOrdinaryCommand();tell(idle.length?'已选择 '+idle.length+' 辆闲置战斗部队':'没有闲置战斗部队');updateUI()}
function refineryEconomyInfo(ref){let ores=state.ores.filter(o=>o.amount>0&&dist(o,ref)<=400),refs=structures(0,'refinery').filter(e=>!e.build),miners=ref.team===0&&!ref.build&&refs.includes(ref)?ownHarvesters().filter(e=>nearest(e,refs)===ref):[];return{oreCount:ores.length,oreAmount:ores.reduce((n,o)=>n+o.amount,0),minerCount:miners.length,cargo:miners.reduce((n,e)=>n+e.load,0)}}
function refineryEconomyLines(ref){if(ref.team!==0||ref.type!=='refinery'||ref.hp<=0)return[];let info=refineryEconomyInfo(ref),lines=['近厂余矿：'+info.oreCount+'处 · '+Math.ceil(info.oreAmount),'直线400内的共享矿量，不保证可达'];if(ref.build)lines.push('尚未建成，暂不能交矿');else lines.push('最近本厂：'+info.minerCount+'辆矿车 · 载矿'+Math.round(info.cargo*100)/100,'仅按当前位置统计，不是绑定任务');if(!info.oreCount)lines.push(state.ores.some(o=>o.amount>0)?'附近无余矿，可考虑远矿或前移精炼厂':'全图余矿耗尽：运回载矿，争夺据点');return lines}
const harvesterWorkLabels={manualMove:'手动移动指令',manualEnd:'手动指令待结束',noRefinery:'停工：缺少已建成精炼厂',delivery:'等待交矿结算',returning:'前往精炼厂交矿',exhausted:'停工：矿石已耗尽',gathering:'矿点采集阶段',assignedTravel:'前往指定矿点',autoTravel:'前往自动选择矿点'};
// Read-only next harvest branch. Invalid/depleted assignments fall back without clearing them here.
// Fresh, lazy query snapshot for one synchronous fleet overview only; never retained across renders.
function harvesterWorkContext(){let refs=new Map(),available,ores;return {refineries(team){if(!refs.has(team))refs.set(team,structures(team,'refinery').filter(b=>!b.build));return refs.get(team)},available(){return available??=state.ores.some(o=>o.amount>0)},ores(){return ores??=state.ores.filter(o=>o.amount>0)}}}
function harvesterWorkState(e,context){if(!e||e.type!=='harvester'||e.hp<=0)return null;if(e.build>0)return 'construction';if(e.manual>0)return e.goal?'manualMove':'manualEnd';let ref=nearest(e,context?context.refineries(e.team):structures(e.team,'refinery').filter(b=>!b.build));if(!ref)return 'noRefinery';let available=context?context.available():state.ores.some(o=>o.amount>0);if(e.load>=180||(e.load>0&&(e.returnCargo||!available)))return dist(e,ref)<e.r+ref.r+35?'delivery':'returning';let assigned=assignedOre(e),ore=assigned?.amount>0?assigned:nearest(e,context?context.ores():state.ores.filter(o=>o.amount>0));if(!ore)return 'exhausted';return dist(e,ore)<30?'gathering':assigned?.amount>0?'assignedTravel':'autoTravel'}
function harvesterWorkDescription(e){let work=harvesterWorkState(e);if(!work)return '';let prefix=state.result?'战局结束 · ':!state.started?'尚未开战 · ':state.paused?'游戏暂停 · ':'';return prefix+(work==='construction'?'施工中：尚未采矿':harvesterWorkLabels[work])}
// Read-only harvest objective arithmetic; carried ore is never added to the score.
function harvestGoalView(){let delivered=state.stats.harvested[0],cargo=state.entities.filter(e=>e.team===0&&e.hp>0&&e.type==='harvester'&&!e.build).reduce((sum,e)=>sum+(Number.isFinite(e.load)&&e.load>0?e.load:0),0),remaining=Math.max(0,HARVEST_GOAL-delivered);return {delivered,cargo,remaining,afterCargo:Math.max(0,remaining-cargo),cargoCovers:remaining>0&&cargo>=remaining}}
function harvestShortfallText(value){let amount=Math.max(0,value),ticks=Math.ceil(amount*10);if(ticks/10<amount)ticks++;return battleReportValue(ticks/10)}
function harvestGoalSummary(){let view=harvestGoalView(),prefix=!state.started?'尚未开战':state.result?'战局结束时快照':state.paused||restartPrompt?'暂停快照':'当前快照',hint=view.remaining===0?'实际交付已达目标；战局结果以结算为准。':view.cargoCovers?'现有载矿可补齐差额；'+(state.started&&!state.result&&!restartPrompt?'可用 M 选矿车、G 提前返厂。':'此处仅为快照。'):'现有载矿仍不足以补齐差额。';return '采矿竞赛：我方实际交付 '+battleReportValue(Math.max(0,view.delivered))+'/'+HARVEST_GOAL+' · 敌方 '+Math.floor(state.stats.harvested[1])+'/'+HARVEST_GOAL+'。仅矿车实际交付计分；也可摧毁敌方基地获胜。 '+prefix+'：还需交付 '+harvestShortfallText(view.remaining)+' · 己方矿车载矿 '+battleReportValue(view.cargo)+' · 若全部交付后仍差 '+harvestShortfallText(view.afterCargo)+'。'+hint+'载矿尚未计分，可能损失，须安全送至已完工精炼厂交付；不保证获胜。'}
function harvesterFleetWork(){let context=harvesterWorkContext(),counts=Object.fromEntries(Object.keys(harvesterWorkLabels).map(key=>[key,0])),total=0;for(let e of state.entities){if(e.team!==0||e.hp<=0||e.type!=='harvester'||e.build>0)continue;counts[harvesterWorkState(e,context)]++;total++}return {total,counts}}
function harvesterFleetWorkSummary(view){if(!state.started)return '尚未开战：开局后显示存活己方已完工矿车的工作阶段。';view=view||harvesterFleetWork();let prefix=state.result?'战局结束时快照':state.paused||restartPrompt?'暂停快照':'当前工作阶段';return prefix+' · 矿车共 '+view.total+' 辆'+(view.total?'':'（暂无符合矿车）')+'\n'+Object.entries(harvesterWorkLabels).map(([key,label])=>label+' '+view.counts[key]).join(' · ')}
// Page-only phase choice and feedback. No entity list survives a render or click.
let harvesterWorkSelectionBattle=null;
for(let [key,label]of Object.entries(harvesterWorkLabels)){let option=document.createElement('option');option.value=key;option.textContent=label;$('harvesterWorkPhase').appendChild(option)}
$('harvesterWorkPhase').value=Object.keys(harvesterWorkLabels)[0];
function updateHarvesterWorkOverview(){let view=harvesterFleetWork(),key=$('harvesterWorkPhase').value,valid=Object.hasOwn(harvesterWorkLabels,key),button=$('selectHarvesterWorkPhase');setReadonlyPanelProperty($('harvesterFleetWork'),'textContent',harvesterFleetWorkSummary(view));setReadonlyPanelProperty(button,'textContent','选择此阶段矿车 · '+(valid?view.counts[key]:0));setReadonlyPanelProperty(button,'disabled',commandBlocked()||!valid);setReadonlyPanelProperty(button,'title',commandBlocked()?'当前不能选择：尚未开始、重新部署确认或战局结束':'按点击时重新筛选全图存活、已完工己方矿车；只选择，不改变原命令');if(harvesterWorkSelectionBattle!==state){$('harvesterWorkSelectionStatus').textContent='';harvesterWorkSelectionBattle=state}}
function selectHarvesterWorkPhase(){if(commandBlocked())return;let key=$('harvesterWorkPhase').value;if(!Object.hasOwn(harvesterWorkLabels,key))return;let context=harvesterWorkContext(),miners=state.entities.filter(e=>e.team===0&&e.hp>0&&e.type==='harvester'&&!(e.build>0)&&harvesterWorkState(e,context)===key);if(miners.length){resetSelectionClicks();selection=new Set(miners.map(e=>e.id));placement=null;attackMode=false;drag=null;clearOrdinaryCommand()}updateUI();$('harvesterWorkSelectionStatus').textContent=miners.length?'已选择 '+miners.length+' 辆「'+harvesterWorkLabels[key]+'」矿车；原命令保持，请另行下令。':'当前没有「'+harvesterWorkLabels[key]+'」矿车；保留原选区和原命令。'}
$('harvesterWorkPhase').onchange=()=>{$('harvesterWorkSelectionStatus').textContent='';updateHarvesterWorkOverview()};
$('selectHarvesterWorkPhase').onclick=selectHarvesterWorkPhase;
function factoryRepeatTargetSummary(selected){let factories=selected.filter(e=>e.team===0&&e.hp>0&&e.type==='factory'&&!e.build&&factoryRepeatType(e)!=='off');if(!factories.length)return'';let counts=new Map();for(let e of factories){let label=defs[factoryRepeatType(e)].name+' '+(effectiveFactoryRepeatTarget(e)||'不限');counts.set(label,(counts.get(label)||0)+1)}return'\n有效补单目标（全军同型含订单）：'+[...counts].map(([label,count])=>label+' ×'+count+'厂').join(' / ')}
function sameRepeatFactoriesView(){let anchor=factorySpawnCheckFactory(),type=factoryRepeatType(anchor);if(!anchor||type==='off')return null;return{anchor,type,factories:structures(0,'factory').filter(e=>!e.build&&factoryRepeatType(e)===type)}}
function updateSameRepeatFactories(){let view=sameRepeatFactoriesView(),count=view?.factories.length||0,button=$('selectSameRepeatFactories');setReadonlyPanelProperty($('factoryRepeatSelection'),'hidden',!selectedRallyFactories().length);setReadonlyPanelProperty(button,'textContent','选择同循环车型工厂'+(view?'（'+defs[view.type].name+'）':'')+' · '+count+'厂');setReadonlyPanelProperty(button,'disabled',commandBlocked()||count<2);setReadonlyPanelProperty(button,'title',commandBlocked()?'当前不能选择工厂':!view?'先单选一座已开启本厂循环的存活己方已完工工厂':count<2?'当前只有本厂使用此循环车型，保留选择':'按点击时当前本厂循环车型选择 '+count+' 座存活己方已完工工厂，包含本厂；不改变设置、订单或资金，暂停可用。')}
function selectSameRepeatFactories(){if(commandBlocked())return;let view=sameRepeatFactoriesView();if(!view||view.factories.length<2)return;resetSelectionClicks();selection=new Set(view.factories.map(e=>e.id));placement=null;attackMode=false;drag=null;clearOrdinaryCommand();updateUI()}
function factoryRepeatSummary(selected){let factories=selected.filter(e=>e.team===0&&e.hp>0&&e.type==='factory'&&!e.build);if(!factories.length)return'';let types=new Map();for(let e of factories){let type=factoryRepeatType(e);types.set(type,(types.get(type)||0)+1)}return'\n本厂循环：'+[...types].map(([type,count])=>(type==='off'?'关闭':defs[type].name)+' '+count+' 厂').join(' / ')}
function factoryRallyModeSummary(selected){let factories=selected.filter(e=>e.team===0&&e.hp>0&&e.type==='factory'&&!e.build&&e.rally);if(!factories.length)return'';let held=factories.filter(e=>e.rallyHold===true).length;return'\n新战车集结模式：抵达坚守 '+held+' 厂 / 攻击移动 '+(factories.length-held)+' 厂（仅已完工且有集结点）'}
function manualFireStatus(e){let target=attackDisplayTarget(e);if(!target)return '';let d=defs[e.type],distance=dist(e,target),range=d.minRange&&distance<d.minRange?'处于火炮近距盲区':distance>d.range+target.r?'超出射程':'射程内',reload=e.cool>0?'装填剩余 '+(Math.ceil(e.cool*10)/10).toFixed(1)+' 游戏秒':'装填就绪';return '指定目标：'+range+' · '+reload}
function selectedCombatHealthSummary(selected){let units=selected.filter(canSetFirePriority);if(!units.length)return '';let damaged=0,critical=0,lowest=1;for(let e of units){if(e.hp<e.max)damaged++;if(e.hp<=e.max*.5)critical++;lowest=Math.min(lowest,e.hp/e.max)}let percent=lowest<.001?'<0.1':String(Math.floor(lowest*1000)/10);return '\n所选战斗车伤情：受损 '+damaged+'/'+units.length+' 辆 · 重伤（≤50%） '+critical+' 辆（计入受损）\n最低剩余生命：'+percent+'%（向下保留1位）；仅统计所选存活、已完工己方战斗车'}
function selectedGroundDestinationSummary(selected){if(!state.started||state.result||selected.length!==1)return'';let e=selected[0],p=e?.goal;if(!p||!Number.isFinite(p.x)||!Number.isFinite(p.y)||p.x<0||p.x>WIDTH||p.y<0||p.y>HEIGHT)return'';let mode=groundMovementOrderMode(e);if(!mode)return'';return'\n'+(restartPrompt?'重开菜单快照':state.paused?'暂停快照':'当前地面命令')+'：'+(mode==='ordinary'?'普通移动':'攻击移动')+' · 当前目的地 X '+Math.round(p.x)+' · Y '+Math.round(p.y)+'（四舍五入）'+(e.moveQueue?'；仅当前路段':'')+'；不代表正在位移或已抵达'}
function selectedGroundMovementSummary(selected){if(!state.started||state.result||selected.length<2)return'';let ordinary=0,attack=0;for(let e of selected){if(!Number.isFinite(e?.goal?.x)||!Number.isFinite(e?.goal?.y))continue;let mode=groundMovementOrderMode(e);if(mode==='ordinary')ordinary++;else if(mode==='attack')attack++}if(!ordinary&&!attack)return'';return'\n'+(restartPrompt?'重开菜单快照':state.paused?'暂停快照':'当前地面命令')+'（所选己方战斗车）：普通移动 '+ordinary+' / 攻击移动 '+attack+'；命令状态，不代表正在位移或已抵达'}
function selectedCombatSummary(selected){let units=selected.filter(canSetFirePriority);if(selected.length<2||!units.length||units.length===selected.length)return '';let counts=new Map(),hp=0,max=0;for(let e of units){counts.set(defs[e.type].name,(counts.get(defs[e.type].name)||0)+1);hp+=e.hp;max+=e.max}return '\n战斗车辆（存活己方）：'+units.length+' 辆 · 合计生命 '+Math.ceil(hp)+'/'+max+'\n战斗车型：'+[...counts].map(([name,count])=>name+' ×'+count).join('、')}
function selectionDescription(selected){if(!selected.length)return'尚未选择单位';if(selected.length>1){let counts=new Map();for(let e of selected)counts.set(defs[e.type].name,(counts.get(defs[e.type].name)||0)+1);let hp=selected.reduce((n,e)=>n+Math.max(0,e.hp),0),max=selected.reduce((n,e)=>n+e.max,0),held=selected.filter(e=>e.hold).length,areaGuards=selected.filter(e=>e.guardArea).length,patrolling=selected.filter(e=>e.patrol).length,routed=selected.filter(e=>e.moveQueue).length,following=selected.filter(e=>escortDisplayTarget(e)).length,trafficViews=selected.map(e=>yieldingInspection(e)),coordinated=trafficViews.filter(v=>v?.kind==='coordination').length,yielding=trafficViews.filter(v=>v&&v.kind!=='coordination').length,services=selected.filter(e=>e.team===0&&e.hp>0&&e.type==='repair'),serviceStatus=services.length?'\n自动维修设置：开启 '+services.filter(e=>e.repairEnabled!==false).length+' / 关闭 '+services.filter(e=>e.repairEnabled===false).length+'\n维修策略：重伤优先 '+services.filter(e=>repairPriority(e)==='critical').length+' / 就近 '+services.filter(e=>repairPriority(e)==='nearest').length:'',miners=selected.filter(e=>e.team===0&&e.hp>0&&e.type==='harvester'),mining=miners.length?'\n载矿合计 '+(Math.round(miners.reduce((n,e)=>n+e.load,0)*100)/100)+'/'+(miners.length*defs.harvester.capacity)+' · 指定矿点 '+miners.filter(e=>assignedOre(e)?.amount>0).length+' 辆':'';return selected.length+' 个单位 · 生命 '+Math.ceil(hp)+'/'+max+'\n'+[...counts].map(([name,count])=>name+' ×'+count).join('、')+(held?'\n坚守阵地：'+held+' 辆':'')+arrivalHoldSummary(selected)+(areaGuards?'\n驻点警戒：'+areaGuards+' 辆':'')+(patrolling?'\n往返巡逻：'+patrolling+' 辆':'')+(routed?'\n分段路线：'+routed+' 辆':'')+(coordinated?'\n自动协调：'+coordinated+' 辆':'')+(yielding?'\n临时让行：'+yielding+' 辆':'')+(following?'\n护航/跟随：'+following+' 辆':'')+(selected.some(e=>attackDisplayTarget(e))?'\n指定攻击：'+selected.filter(e=>attackDisplayTarget(e)).length+' 辆':'')+attackQueueSummary(selected)+firePrioritySummary(selected)+serviceStatus+mining+factoryRallyModeSummary(selected)+factoryRepeatSummary(selected)+factoryRepeatTargetSummary(selected)+selectedBuildingHint(selected)}let e=selected[0],d=defs[e.type],yieldView=yieldingInspection(e),lines=[d.name+' · 生命 '+Math.ceil(Math.max(0,e.hp))+'/'+e.max];if(canSetFirePriority(e))lines.push('自动选敌：'+(firePriority(e)==='critical'?'重伤优先（按生命比例）':firePriority(e)==='artillery'?'火炮优先（当前可开火，否则就近）':'就近')+' · 手动指定优先');if(attackTargetLabel(e))lines.push('指定目标：'+attackTargetLabel(e));let fireStatus=manualFireStatus(e);if(fireStatus)lines.push(fireStatus);if(e.attackQueue)lines.push(attackQueueSummary([e]).trim());if(e.holdOnArrival===true)lines.push('抵达后坚守：已预约，普通路线末段完成后生效');if(e.moveQueue)lines.push('分段移动：剩余 '+e.moveQueue.length+' 个路点（含当前）'+(e.attackMove?'，当前段攻击移动':''));if(e.build)lines.push('施工中：剩余 '+Math.ceil(e.build)+' 秒');if(d.damage)lines.push('伤害 '+d.damage+' / '+d.rate+'秒 · 射程 '+(d.minRange?d.minRange+'–':'')+d.range+'（标称）');if(d.splashRadius)lines.push('命中周围50范围内敌方车辆受到最多12溅射伤害，随中心距离递减；不伤友军和周围建筑');if(e.type==='repair')lines.push(...supportOrderInspection(e));if(e.type==='repair')lines.push(repairWorkDescription(e),'维修范围100 · 最多6生命/秒 · 每1资金最多3生命',e.repairEnabled===false?'自动维修暂停':'自动维修开启（消耗资金）','自动目标：'+(repairPriority(e)==='critical'?'重伤优先（按剩余生命比例）':'就近维修')+' · 指定跟随目标优先',escortTargetLabel(e)?'跟随目标：'+escortTargetLabel(e):e.hold?'坚守维修位置':'右键友军战车：跟随并优先维修');else if(e.type==='harvester'){lines.push('载矿 '+e.load+'/180 · '+harvesterWorkDescription(e));let delivery=harvesterDeliveryDescription(e);if(delivery)lines.push(delivery)}if(e.type!=='repair'&&escortTargetLabel(e))lines.push('护航目标：'+escortTargetLabel(e));if(e.type==='harvester'&&assignedOre(e)?.amount>0)lines.push('采矿安排：指定矿点 · 剩余 '+Math.ceil(assignedOre(e).amount)+' · S恢复自动选矿');else if(e.type==='harvester'&&e.team===0&&e.hp>0&&!e.build)lines.push('采矿安排：自动选矿'+(e.manual>0&&!state.result?'；手动指令结束后按自动规则采矿':''));else if(d.speed&&e.type!=='harvester'&&e.type!=='repair')lines.push('速度 '+d.speed+' · '+(e.guardArea?'驻点警戒 · 接敌半径180':yieldView?yieldView.status:validEscort(e,get(e.escortId))?'护航采矿车':e.patrol?'往返巡逻 · 前往'+(e.patrol.next?'B':'A')+'端':e.hold?'坚守阵地':e.target?'攻击指定目标':e.goal?(e.attackMove?'攻击移动':'移动中'):'待命'));else if(e.type==='factory'){if(e.team===0&&!e.build)lines.push(factoryRepeatStatus(e));let work=state.queue.find(q=>q.factoryId===e.id);lines.push('共享生产队列 '+state.queue.length+'/8 · '+(e.rally?'已设置集结点':'未设置集结点'),'本厂：'+(e.build?'施工中，尚不能生产或设置集结点':work?defs[work.type].name+' · '+productionStateLabel(work)+(work.waitingForExit?'':(state.result?' · 结束时剩余':' · 剩余')+Math.ceil(work.left)+'秒'):(state.result?'已结束':'空闲')));if(e.rally){lines.push('新车在中心144范围内找空位；中心不因分散而移动');lines.push(e.rallyHold===true?'新战车：普通移动，抵达后坚守；矿车和维修车不变':'新战车：攻击移动集结（默认）')}}else if(e.type==='power')lines.push(e.build?'建成后提供100电力':'提供100电力');else if(e.type==='turret')lines.push(powered(e.team)?'电力正常':'缺电，无法开火');else if(e.type==='refinery')lines.push('矿车交付矿石的地点',...refineryEconomyLines(e));if(yieldView)lines.push(yieldView.goal);return lines.join('\n')}
let mapPreviewKey='';
function mapPreviewLayout(map,objective){if(map==='meridian'){let ores=meridianLayout.ores.map(([x,y])=>({x,y})),posts=meridianLayout.posts.map(([x,y])=>({x,y})),hq=meridianLayout.entities.filter(e=>e[0]==='hq').map(e=>({x:e[2],y:e[3]}));if(objective==='harvest'){let available=ores.slice();for(let team=0;team<2;team++){let row=meridianLayout.entities.find(e=>e[0]==='refinery'&&e[1]===team),ref={x:row[2],y:row[3]},ore=nearest(ref,available);if(ore){ore.x=ref.x+(team?-130:130);ore.y=ref.y;available=available.filter(o=>o!==ore)}}}return{map:'meridian',ores,posts,hq,rocks:meridianRocks.map(o=>({...o})),stronghold:objective==='stronghold'?nearest({x:600,y:400},posts):null}}if(map==='ring'){let ores=ringLayout.ores.map(([x,y])=>({x,y})),posts=ringLayout.posts.map(([x,y])=>({x,y})),hq=ringLayout.entities.filter(e=>e[0]==='hq').map(e=>({x:e[2],y:e[3]}));if(objective==='harvest'){let available=ores.slice();for(let team=0;team<2;team++){let row=ringLayout.entities.find(e=>e[0]==='refinery'&&e[1]===team),ref={x:row[2],y:row[3]},ore=nearest(ref,available);if(ore){ore.x=ref.x+(team?-130:130);ore.y=ref.y;available=available.filter(o=>o!==ore)}}}return{map:'ring',ores,posts,hq,rocks:ringRocks.map(o=>({...o})),stronghold:objective==='stronghold'?nearest({x:600,y:400},posts):null}}let key=knownMap(map)?map:'classic',orePoints=key==='classic'?[[420,640],[190,380],[540,360],[740,540],[840,130]]:key==='frontier'?[[400,410],[160,160],[600,380],[830,680],[900,740]]:key==='canyon'?[[400,410],[180,170],[380,680],[800,400],[1020,150],[940,730]]:key==='switchback'?[[400,420],[800,420],[300,160],[900,160],[300,680],[900,680]]:[[420,420],[200,140],[400,660],[800,420],[1000,140],[910,715]],postPoints=key==='classic'?[[450,260],[600,400],[750,560]]:key==='frontier'?[[420,180],[600,400],[780,630]]:key==='canyon'?[[450,300],[750,300],[600,500]]:key==='switchback'?[[600,180],[600,500],[600,660]]:(key==='crossroads'?[120,400,680]:[60,400,740]).map(y=>[600,y]),ores=orePoints.map(([x,y])=>({x,y})),posts=postPoints.map(([x,y])=>({x,y})),hq=key==='classic'?[{x:140,y:620},{x:1050,y:125}]:[{x:140,y:400},{x:1050,y:400}];if(objective==='harvest'){let available=ores.slice(),refs=key==='classic'?[{x:290,y:640},{x:1040,y:440}]:[{x:290,y:420},{x:1040,y:715}];for(let team=0;team<2;team++){let ref=refs[team],ore=nearest(ref,available);if(ore){ore.x=ref.x+(team?-130:130);ore.y=ref.y;available=available.filter(o=>o!==ore)}}}return{map:key,ores,posts,hq,rocks:terrainObstacles(key).map(o=>({x:o.x,y:o.y,r:o.r})),stronghold:objective==='stronghold'?nearest({x:600,y:400},posts):null}}
function updateMapPreview(){let map=$('scenario').value,objective=$('objective').value,key=map+'|'+objective;if(mapPreviewKey===key)return;let layout=mapPreviewLayout(map,objective),names=mapLabels,caption=names[layout.map]+' · '+layout.ores.length+'处矿点 · 3座据点'+(objective==='harvest'?' · 采矿竞赛已调整近矿位置':'')+(layout.stronghold?' · 金色外圈为驻守目标':'');$('mapPreviewCaption').textContent=caption;let canvas=$('mapPreview'),c=canvas.getContext?.('2d');if(!c)return;mapPreviewKey=key;canvas.setAttribute('aria-label',caption+'；绿色为我方，橙色为敌方指挥中心');c.clearRect(0,0,360,240);c.fillStyle='#243a2c';c.fillRect(0,0,360,240);c.strokeStyle='#3a5140';c.lineWidth=.5;for(let x=0;x<=360;x+=30){c.beginPath();c.moveTo(x,0);c.lineTo(x,240);c.stroke()}for(let y=0;y<=240;y+=30){c.beginPath();c.moveTo(0,y);c.lineTo(360,y);c.stroke()}for(let o of layout.rocks){c.fillStyle='#686d60';c.beginPath();c.arc(o.x*.3,o.y*.3,o.r*.3,0,Math.PI*2);c.fill()}for(let o of layout.ores){c.fillStyle='#e4c783';c.beginPath();c.arc(o.x*.3,o.y*.3,3.5,0,Math.PI*2);c.fill()}for(let p of layout.posts){c.strokeStyle='#dfdfb0';c.lineWidth=1.5;c.beginPath();c.arc(p.x*.3,p.y*.3,6,0,Math.PI*2);c.stroke()}if(layout.stronghold){c.strokeStyle='#f5cd67';c.lineWidth=2;c.beginPath();c.arc(layout.stronghold.x*.3,layout.stronghold.y*.3,65*.3,0,Math.PI*2);c.stroke()}layout.hq.forEach((p,i)=>{c.fillStyle=i?'#e58c63':'#96d994';c.fillRect(p.x*.3-5,p.y*.3-5,10,10)})}
