function updateControlGroupAdd(i){let view=controlGroupAddition(i),button=$('addControlGroup'+i),count=view?.added.length||0;setReadonlyPanelProperty(button,'textContent','加入所选到编队'+(i+1)+' · +'+count+'辆');setReadonlyPanelProperty(button,'disabled',commandBlocked()||!count);setReadonlyPanelProperty(button,'title',commandBlocked()?'当前不能修改编队':count?'只加入当前所选且尚未入组的存活己方车辆；原存活车辆顺序保留，成功加入时清理失效编号。选区、命令和待点选操作不变。':'当前选择没有尚未加入此编队的存活己方车辆')}
