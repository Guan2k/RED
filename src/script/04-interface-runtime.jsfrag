const SIMULATION_STEP=1/60;
function advanceSimulation(dt){if(!state.started||state.paused||state.result){simulationRemainder=0;return}simulationRemainder+=Math.max(0,Math.min(dt,.05))*(state.gameSpeed||1);while(simulationRemainder+1e-10>=SIMULATION_STEP){simulationRemainder=Math.max(0,simulationRemainder-SIMULATION_STEP);update(SIMULATION_STEP);if(state.paused||state.result){simulationRemainder=0;break}}}
function frame(now){let dt=last?Math.min((now-last)/1000,.05):0;last=now;advanceSimulation(dt);render();uiClock+=dt;if(selectedDeathUiDirty||uiClock>.15){updateUI();if(uiClock>.15)uiClock=0}requestAnimationFrame(frame)}window.addEventListener('blur',()=>{let ordinaryPending=ordinaryCommandMode||appendCommandMode;invalidateProductionOrderGestures();resetSelectionClicks();drag=null;hoverActive=false;if(ordinaryPending)updateUI()});document.addEventListener('visibilitychange',()=>{last=0;simulationRemainder=0;if(document.hidden){let ordinaryPending=ordinaryCommandMode||appendCommandMode;invalidateProductionOrderGestures();resetSelectionClicks();drag=null;hoverActive=false;if(ordinaryPending)updateUI();if(restartPrompt&&state.started&&!state.result)resumeAfterCancel=true;}if(document.hidden&&state.started&&!state.result&&!state.paused&&!restartPrompt){state.paused=true;$('pause').textContent='继续 [空格]';tell('页面转入后台，已自动暂停；返回后可手动继续');updateUI()}});const trafficCoordination=(()=>{
function trafficRecord(list,event){list.push(event);if(list.length>128)list.shift()}
let coordinationPair=null,coordinationEvents=[],coordinationSerial=0;
const coordinationOriginalMove=move;
function coordinationRelease(reason){let token=coordinationPair;if(!token)return;for(let unit of [token.a,token.b]){let nav=navigationMemory.get(unit);if(nav?.coordinationPair===token)delete nav.coordinationPair}trafficRecord(coordinationEvents,{reason,phase:token.phase,t:state.t,serial:token.serial});coordinationPair=null}
// Only the return leg may use a bounded detour; all waypoints keep full static/mobile clearance.
function coordinationLegsClear(segments,walls,returnRoute){return segments.every((s,i)=>{let points=i===2&&returnRoute?returnRoute:[s.to],from=s.from,obstacles=walls.concat([s.wall]);if(!points.length||dist(points[points.length-1],s.to)>1e-6)return false;for(let point of points){if(!Number.isFinite(point.x)||!Number.isFinite(point.y)||!patrolPointSafe({r:s.r},point,obstacles)||!movementSegmentClear(from,point,s.r,obstacles))return false;from=point}return true})}
function coordinationPlanClear(token){let {a,b,pocket,far,goalA,goalB}=token,third=state.entities.filter(e=>e!==a&&e!==b&&e.hp>0&&defs[e.type].speed),walls=movementObstacles().concat(third),futureA={x:goalA.x,y:goalA.y,r:a.r+token.arrivalA};let endB=pocketArrivalPoint(b,goalB,futureA);if(!endB)return false;let segments=[{from:token.startA,to:pocket,r:a.r,wall:{...token.startB,r:b.r}},{from:token.startB,to:far,r:b.r,wall:{...pocket,r:a.r+.1}},{from:pocket,to:goalA,r:a.r,wall:{...far,r:b.r+.1}},{from:far,to:endB,r:b.r,wall:futureA}];if(!coordinationLegsClear(segments,walls,token.returnRoute))return false;token.endB=endB;return true}
function coordinationReturnRoute(a,b,pocket,far){let third=state.entities.filter(e=>e!==a&&e!==b&&e.hp>0&&defs[e.type].speed),route=findMovementRoute({...a,x:pocket.x,y:pocket.y},a.goal,third.concat([{...far,r:b.r+.1}]));if(!route?.length||dist(route[route.length-1],a.goal)>1e-6)return null;let length=0,from=pocket;for(let point of route){length+=dist(from,point);from=point}return length<=Math.min(600,defs[a.type].speed*25)?route:null}
function coordinationEligible(e){return pocketEligible(e)&&!e.attackQueue&&!e.holdOnArrival&&!navigationMemory.get(e)?.yielding}
function coordinationBegin(a,b,pocket,far,returnRoute=null){if(coordinationPair&&!coordinationValid(coordinationPair))coordinationRelease('cancelled-before-proposal');if(coordinationPair||state.shots.length||a===b||!coordinationEligible(a)||!coordinationEligible(b)||a.team!==b.team||a.type!==b.type)return false;let token={serial:++coordinationSerial,state,a,b,team:a.team,type:a.type,goalA:a.goal,goalB:b.goal,gxA:a.goal.x,gyA:a.goal.y,gxB:b.goal.x,gyB:b.goal.y,arrivalA:a.arrivalRadius||5,arrivalB:b.arrivalRadius||5,startA:{x:a.x,y:a.y},startB:{x:b.x,y:b.y},pocket:{...pocket},far:{...far},returnRoute:returnRoute?.map(p=>({...p}))||null,returnIndex:0,phase:1,started:state.t,phaseAt:state.t,progressAt:state.t,progressDistance:null,aDone:false,passThrough:0};if(!coordinationPlanClear(token))return false;for(let unit of [a,b]){let nav=navigationMemory.get(unit)||{goal:{...unit.goal},elapsed:0,startDistance:dist(unit,unit.goal),retry:0,route:null,tracking:null};nav.coordinationPair=token;navigationMemory.set(unit,nav)}coordinationPair=token;return true}
function coordinationValid(token){if(state.shots.length||state!==token.state||state.result||!state.started||state.t-token.started>90||state.t-token.phaseAt>30)return false;for(let [unit,goal,gx,gy,arrival,done]of [[token.a,token.goalA,token.gxA,token.gyA,token.arrivalA,token.aDone],[token.b,token.goalB,token.gxB,token.gyB,token.arrivalB,false]]){if(get(unit.id)!==unit||unit.hp<=0||unit.team!==token.team||unit.type!==token.type||(unit.arrivalRadius||5)!==arrival||goal.x!==gx||goal.y!==gy||unit.target||unit.hold||unit.holdOnArrival||unit.attackMove||unit.escortId||unit.patrol||unit.guardArea||unit.moveQueue||unit.attackQueue)return false;if(done){if(unit.goal!==null||dist(unit,goal)>=arrival)return false}else if(unit.goal!==goal||navigationMemory.get(unit)?.coordinationPair!==token)return false}if(state.entities.some(e=>e.hp>0&&e.team!==token.team&&defs[e.type].damage&&[token.a,token.b].some(u=>dist(e,u)<defs[e.type].range+e.r+50)))return false;return coordinationPlanClear(token)}
function coordinationNext(token,phase){token.phase=phase;token.phaseAt=token.progressAt=state.t;token.progressDistance=null}
move=function(e,p,dt,tracking=null){let token=coordinationPair;if(!token||e!==token.a&&e!==token.b)return coordinationOriginalMove(e,p,dt,tracking);if(!coordinationValid(token)||p!==e.goal||tracking!==null){coordinationRelease('cancelled');return coordinationOriginalMove(e,p,dt,tracking)}let active=token.phase===1||token.phase===3?token.a:token.b;if(e!==active)return false;let destination=token.phase===1?token.pocket:token.phase===2?token.far:token.phase===3?(token.returnRoute?.[token.returnIndex]||token.goalA):token.endB;if(token.phase===2&&dist(e,token.goalB)<token.arrivalB)token.passThrough++;if(token.phase===3&&dist(e,token.goalA)<token.arrivalA){token.aDone=true;coordinationNext(token,4);return true}if(token.phase===4&&dist(e,token.goalB)<token.arrivalB){trafficRecord(coordinationEvents,{reason:'pass-through',count:token.passThrough,serial:token.serial});coordinationRelease('completed');return true}let remaining=dist(e,destination);if(remaining<.1){if(token.phase===1)coordinationNext(token,2);else if(token.phase===2)coordinationNext(token,3);else if(token.phase===3&&token.returnRoute&&token.returnIndex<token.returnRoute.length-1){token.returnIndex++;token.progressAt=state.t;token.progressDistance=null}else coordinationRelease('endpoint-not-accepted');return false}if(dt<=0)return false;if(token.progressDistance===null)token.progressDistance=remaining;if(state.t-token.progressAt>=2){if(token.progressDistance-remaining<4){coordinationRelease('no-progress');return coordinationOriginalMove(e,p,dt,tracking)}token.progressAt=state.t;token.progressDistance=remaining}let amount=Math.min(remaining,defs[e.type].speed*dt),next={x:e.x+(destination.x-e.x)/remaining*amount,y:e.y+(destination.y-e.y)/remaining*amount},walls=movementObstacles().concat(state.entities.filter(o=>o!==e&&o.hp>0&&defs[o.type].speed));if(!movementSegmentClear(e,next,e.r,walls)){coordinationRelease('blocked-step');return coordinationOriginalMove(e,p,dt,tracking)}movementIntent.add(e);goalMovementIntent.add(e);e.angle=Math.atan2(next.y-e.y,next.x-e.x);e.x=next.x;e.y=next.y;return false};

const coordinationOriginalUpdate=update;update=function(dt){if(coordinationPair&&!coordinationValid(coordinationPair))coordinationRelease('cancelled-before-update');return coordinationOriginalUpdate(dt)};

const coordinationOriginalFire=fire;fire=function(e,target){let token=coordinationPair;if(token&&[token.a,token.b].some(u=>u===e||u===target))coordinationRelease('combat');return coordinationOriginalFire(e,target)};

const autoReservationCommands=new Map();
const arrivalReservations=new Map(),reservationEvents=[];
let reservationActor=null,reservationMoves=0;
function reservationValid(e,r){return r.owner===coordinationBatch&&r.state===state&&get(e.id)===e&&e.hp>0&&e.hp>=r.hp&&e.team===r.team&&e.goal===null&&!e.target&&!e.attackMove&&!e.escortId&&!e.patrol&&!e.guardArea&&!e.moveQueue&&!e.attackQueue&&e.hold===r.hold&&e.holdOnArrival===r.holdOnArrival&&e.r===r.r&&e.x===r.x&&e.y===r.y&&!state.result}
function reservationGet(e){let r=arrivalReservations.get(e);if(r&&!reservationValid(e,r)){arrivalReservations.delete(e);trafficRecord(reservationEvents,{id:e.id,reason:'invalid',t:state.t});return null}return r}
function reservationWalls(except){let walls=[];for(let [e,r]of arrivalReservations)if(reservationGet(e)&&e!==except)walls.push({x:r.x,y:r.y,r:r.r,owner:e});return walls}
const reservationOriginalObstacles=movementObstacles;
movementObstacles=function(){let walls=reservationOriginalObstacles();return reservationActor?walls.concat(reservationWalls(reservationActor)):walls};
const reservationOriginalArrival=arriveAtGoal;
arriveAtGoal=function(e){let authorization=autoReservationCommands.get(e),goal=e.goal,radius=e.arrivalRadius||5,ordinary=autoReservationCommands.get(e)?.state===state&&autoReservationCommands.get(e)?.goal===goal&&!!goal&&!e.attackMove&&!e.target&&!e.escortId&&!e.patrol&&!e.guardArea&&!e.moveQueue&&!e.attackQueue;autoReservationCommands.delete(e);reservationOriginalArrival(e);if(ordinary&&e.goal===null&&dist(e,goal)<radius){let safe=patrolPointSafe(e,e,reservationOriginalObstacles())&&state.entities.every(o=>o===e||o.hp<=0||!defs[o.type].speed||dist(e,o)>=e.r+o.r+3-1e-8);if(!safe){trafficRecord(reservationEvents,{id:e.id,reason:'admission-conflict',t:state.t});return}arrivalReservations.set(e,{owner:authorization?.owner,state,goal,radius,x:e.x,y:e.y,r:e.r,hp:e.hp,team:e.team,hold:e.hold,holdOnArrival:e.holdOnArrival});trafficRecord(reservationEvents,{id:e.id,reason:'arrived',t:state.t,x:e.x,y:e.y})}};
const reservationOriginalMove=move;
move=function(e,p,dt,tracking=null){let previous=reservationActor;reservationGet(e);reservationActor=coordinationPair&&(coordinationPair.a===e||coordinationPair.b===e)?null:e;try{reservationMoves++;return reservationOriginalMove(e,p,dt,tracking)}finally{reservationActor=previous}};
const reservationOriginalFire=fire;
fire=function(e,target){for(let unit of [e,target])if(arrivalReservations.delete(unit))trafficRecord(reservationEvents,{id:unit.id,reason:'combat',t:state.t});return reservationOriginalFire(e,target)};
function reservationBindNavigation(){if(navigationMemory.reservationBound)return;let nativeDelete=navigationMemory.delete;navigationMemory.delete=function(e){if(arrivalReservations.delete(e))trafficRecord(reservationEvents,{id:e.id,reason:'navigation-invalidated',t:state.t});return nativeDelete.call(this,e)};navigationMemory.reservationBound=true}
reservationBindNavigation();
const reservationOriginalUpdate=update;
update=function(dt){reservationBindNavigation();for(let [e,r]of arrivalReservations)reservationGet(e);return reservationOriginalUpdate(dt)};
const reservationOriginalShotDamage=applyShotDamage;
applyShotDamage=function(target,damage,team,destroyedHQ){if(target.hp>0&&damage>0&&arrivalReservations.delete(target))trafficRecord(reservationEvents,{id:target.id,reason:'shot-damage',t:state.t});return reservationOriginalShotDamage(target,damage,team,destroyedHQ)};

let coordinationBatch=null,coordinationBatchEvents=[];
function batchRelease(reason){if(!coordinationBatch)return;if(coordinationPair)coordinationRelease('batch-'+reason);for(let record of coordinationBatch.records){let nav=navigationMemory.get(record.e);if(nav?.coordinationBatch===coordinationBatch)delete nav.coordinationBatch}trafficRecord(coordinationBatchEvents,{reason,index:coordinationBatch.index,t:state.t});coordinationBatch=null}
function batchUnitValid(record){let e=record.e;return get(e.id)===e&&e.hp>0&&e.hp>=record.hp&&e.team===record.team&&e.type===record.type&&(e.arrivalRadius||5)===record.radius&&!e.target&&!e.hold&&!e.holdOnArrival&&!e.attackMove&&!e.escortId&&!e.patrol&&!e.guardArea&&!e.moveQueue&&!e.attackQueue&&record.goal.x===record.x&&record.goal.y===record.y&&(e.goal===record.goal&&(!record.owner||(navigationMemory.get(e)===record.nav&&record.nav.coordinationBatch===record.owner))||e.goal===null&&!!reservationGet(e))}
function batchValid(batch){return state===batch.state&&state.started&&!state.result&&!state.shots.length&&state.t-batch.started<90&&batch.records.every(batchUnitValid)&&!state.entities.some(e=>e.hp>0&&e.team!==batch.records[0].team&&defs[e.type].damage&&batch.records.some(r=>dist(e,r.e)<defs[e.type].range+e.r+50))}
function batchBegin(proposals){if(coordinationBatch||coordinationPair||(proposals.length<1||proposals.length>2)||new Set(proposals.flatMap(p=>[p.a,p.b])).size!==proposals.length*2||proposals.some(p=>p.a.team!==0||p.b.team!==0||get(p.a.id)!==p.a||get(p.b.id)!==p.b||p.a.type!==p.b.type||!coordinationEligible(p.a)||!coordinationEligible(p.b)))return false;if(!proposals.every(p=>coordinationPlanClear({a:p.a,b:p.b,pocket:p.pocket,far:p.far,returnRoute:p.returnRoute,goalA:p.a.goal,goalB:p.b.goal,arrivalA:p.a.arrivalRadius||5,startA:{x:p.a.x,y:p.a.y},startB:{x:p.b.x,y:p.b.y}})))return false;let records=proposals.flatMap(p=>[p.a,p.b]).map(e=>({e,goal:e.goal,x:e.goal.x,y:e.goal.y,radius:e.arrivalRadius||5,team:e.team,type:e.type,hp:e.hp}));let batch={state,proposals,records,index:0,started:state.t,serial:null};if(!batchValid(batch))return false;let first=proposals[0];if(!coordinationBegin(first.a,first.b,first.pocket,first.far,first.returnRoute))return false;batch.serial=coordinationPair.serial;for(let record of records){let e=record.e,nav=navigationMemory.get(e)||{goal:{...e.goal},elapsed:0,startDistance:dist(e,e.goal),retry:0,route:null,tracking:null};nav.coordinationBatch=batch;navigationMemory.set(e,nav);record.nav=nav;record.owner=batch}coordinationBatch=batch;return true}
const batchNativeMove=move;
move=function(e,p,dt,tracking=null){let batch=coordinationBatch;if(batch&&!batchValid(batch)){batchRelease('invalid-before-move');batch=null}if(batch&&batch.proposals.slice(batch.index+1).some(q=>q.a===e||q.b===e))return false;return batchNativeMove(e,p,dt,tracking)};
const batchNativeUpdate=update;
update=function(dt){let batch=coordinationBatch;if(batch){if(!batchValid(batch)){batchRelease('invalid-before-update')}else if(!coordinationPair){let complete=coordinationEvents.some(e=>e.serial===batch.serial&&e.reason==='completed');if(!complete)batchRelease('pair-interrupted');else if(++batch.index===batch.proposals.length)batchRelease('completed');else{let next=batch.proposals[batch.index];if(coordinationBegin(next.a,next.b,next.pocket,next.far,next.returnRoute)){batch.serial=coordinationPair.serial;trafficRecord(coordinationBatchEvents,{reason:'next-pair',index:batch.index,t:state.t})}else batchRelease('next-plan-rejected')}}}return batchNativeUpdate(dt)};
const batchNativeFire=fire;
fire=function(e,target){if(coordinationBatch?.records.some(r=>r.e===e||r.e===target))batchRelease('combat');return batchNativeFire(e,target)};
const batchOriginalShotDamage=applyShotDamage;
applyShotDamage=function(target,damage,team,destroyedHQ){if(target.hp>0&&damage>0&&coordinationBatch?.records.some(r=>r.e===target))batchRelease('shot-damage');return batchOriginalShotDamage(target,damage,team,destroyedHQ)};

let stallObserverState=state,stallObservations=new Map(),stallReadyQueue=[],stallObserverStats={attempts:0,maxRecords:0,maxVisits:0,disabledSteps:0};
function resetStallObserver(){stallObserverState=state;stallObservations.clear();stallReadyQueue=[]}
function forgetStall(e){stallObservations.delete(e);stallReadyQueue=stallReadyQueue.filter(x=>x!==e)}
function stallIdentityValid(e,r,present){return state===r.state&&present.has(e)&&coordinationEligible(e)&&!navigationMemory.get(e)?.coordinationBatch&&!navigationMemory.get(e)?.coordinationPair&&e.team===0&&e.goal===r.goal&&e.goal.x===r.gx&&e.goal.y===r.gy&&(e.arrivalRadius||5)===r.arrival&&dist(e,e.goal)>=r.arrival}
function readyStalledUnits(){if(state!==stallObserverState)resetStallObserver();if(state.entities.length>128||!state.started||state.result||state.shots.length){resetStallObserver();return[]}let present=new Set(state.entities);return stallReadyQueue.filter(e=>{let r=stallObservations.get(e);if(!r||!stallIdentityValid(e,r,present)){forgetStall(e);return false}return r.windows>=3})}
const stallNativeMove=move;
move=function(e,p,dt,tracking=null){if(state!==stallObserverState)resetStallObserver();if(navigationMemory.get(e)?.coordinationBatch||navigationMemory.get(e)?.coordinationPair)forgetStall(e);if(state.entities.length<=128&&dt>0&&!state.paused&&!state.result&&!state.shots.length&&tracking===null&&p===e.goal&&e.team===0&&coordinationEligible(e)&&!navigationMemory.get(e)?.coordinationBatch&&!navigationMemory.get(e)?.coordinationPair){let present=new Set([e]),r=stallObservations.get(e);if(!r||!stallIdentityValid(e,r,present)){forgetStall(e);r={state,goal:p,gx:p.x,gy:p.y,arrival:e.arrivalRadius||5,at:state.t,x:e.x,y:e.y,minX:e.x,maxX:e.x,minY:e.y,maxY:e.y,distance:dist(e,p),attempts:0,windows:0};stallObservations.set(e,r)}r.attempts++;stallObserverStats.attempts++;stallObserverStats.maxRecords=Math.max(stallObserverStats.maxRecords,stallObservations.size)}return stallNativeMove(e,p,dt,tracking)};
const stallNativeUpdate=update;
update=function(dt){if(state!==stallObserverState)resetStallObserver();let result=stallNativeUpdate(dt);if(state.entities.length>128||!state.started||state.result||state.shots.length){resetStallObserver();stallObserverStats.disabledSteps++;return result}if(dt<=0||state.paused)return result;let present=new Set(state.entities),visits=0;for(let [e,r]of stallObservations){visits++;if(!stallIdentityValid(e,r,present)){forgetStall(e);continue}r.minX=Math.min(r.minX,e.x);r.maxX=Math.max(r.maxX,e.x);r.minY=Math.min(r.minY,e.y);r.maxY=Math.max(r.maxY,e.y);let remaining=dist(e,r.goal),span=Math.hypot(r.maxX-r.minX,r.maxY-r.minY);if(span>=4||r.distance-remaining>=4){r.windows=0;stallReadyQueue=stallReadyQueue.filter(x=>x!==e)}if(state.t-r.at<2-1e-8)continue;let stalled=r.attempts>0&&span<4&&r.distance-remaining<4;r.windows=stalled?r.windows+1:0;if(r.windows>=3&&!stallReadyQueue.includes(e))stallReadyQueue.push(e);if(!stalled)stallReadyQueue=stallReadyQueue.filter(x=>x!==e);r.at=state.t;r.x=r.minX=r.maxX=e.x;r.y=r.minY=r.maxY=e.y;r.distance=remaining;r.attempts=0}stallObserverStats.maxVisits=Math.max(stallObserverStats.maxVisits,visits);return result};
const stallNativeFire=fire;fire=function(e,target){forgetStall(e);forgetStall(target);return stallNativeFire(e,target)};
const stallNativeDamage=applyShotDamage;applyShotDamage=function(target,damage,team,destroyedHQ){if(target.hp>0&&damage>0)forgetStall(target);return stallNativeDamage(target,damage,team,destroyedHQ)};

let autoState=state,autoJob=null,autoCooldown=new Map(),autoEvents=[];
let autoStats={comparisons:0,geometry:0,maxComparisonsPerStep:0,maxCandidateGeometryPerStep:0,accepted:0,maxPeerVisitsPerStep:0};
function autoReset(){autoState=state;autoJob=null;autoCooldown.clear();autoReservationCommands.clear()}
function autoKey(a,b){return a.id<b.id?a.id+':'+b.id:b.id+':'+a.id}
function autoCold(a,b){if(a.id>b.id)[a,b]=[b,a];let r=autoCooldown.get(autoKey(a,b));return r&&r.until>state.t&&r.a===a&&r.b===b&&r.ga===a.goal&&r.gb===b.goal&&a.goal?.x===r.ax&&a.goal?.y===r.ay&&b.goal?.x===r.bx&&b.goal?.y===r.by}
function autoMarkCold(a,b,ga=a.goal,gb=b.goal,ax=ga.x,ay=ga.y,bx=gb.x,by=gb.y){if(a.id>b.id){[a,b]=[b,a];[ga,gb]=[gb,ga];[ax,bx]=[bx,ax];[ay,by]=[by,ay]}if(autoCooldown.size>=128)autoCooldown.delete(autoCooldown.keys().next().value);autoCooldown.set(autoKey(a,b),{a,b,ga,gb,ax,ay,bx,by,until:state.t+8})}
function autoReciprocal(a,b){return a!==b&&a.type===b.type&&dist(a,b)<=a.r+b.r+4&&dist(a.goal,b.goal)>=a.r+b.r+8&&dist(a,b.goal)<a.r+b.r+3&&dist(b,a.goal)<a.r+b.r+3&&((a.goal.x-a.x)*(b.goal.x-b.x)+(a.goal.y-a.y)*(b.goal.y-b.y))<0}
function autoAdmit(job){
   let proposals=job.proposals;
   if(proposals.every(p=>autoReciprocal(p.a,p.b))&&batchBegin(proposals)){
    for(let p of proposals)for(let e of [p.a,p.b]){forgetStall(e);autoReservationCommands.set(e,{state,goal:e.goal,owner:coordinationBatch})}
    autoStats.accepted++;trafficRecord(autoEvents,{reason:'accepted',t:state.t,ids:proposals.map(p=>[p.a.id,p.b.id])});
   }else{for(let p of proposals)autoMarkCold(p.a,p.b);trafficRecord(autoEvents,{reason:'batch-rejected',t:state.t})}
   autoJob=null;
}
function autoStep(){
 if(state!==autoState)autoReset();
 if(state.entities.length>128||!state.started||state.result||state.shots.length){autoReset();return}
 if(state.paused||coordinationBatch||coordinationPair)return;
 let ready=readyStalledUnits(),valid=new Set(ready);
 if(autoJob&&(state.t-autoJob.started>6||autoJob.proposals.some(p=>!valid.has(p.a)||!valid.has(p.b))||(autoJob.candidate&&(!valid.has(autoJob.candidate.a)||!valid.has(autoJob.candidate.b)))))autoJob=null;
 if(!autoJob){if(ready.length<2)return;autoJob={state,started:state.t,units:ready.slice(),i:0,j:0,used:new Set(),proposals:[],candidate:null}}
 let job=autoJob;
 if(job.candidate){
  let {a,b,index}=job.candidate;job.candidate.index++;autoStats.geometry++;autoStats.maxCandidateGeometryPerStep=Math.max(autoStats.maxCandidateGeometryPerStep,1);
  let length=dist(a,b),ux=(b.x-a.x)/length,uy=(b.y-a.y)/length,back=[80,50,110][Math.floor((index%6)/2)],sign=index%2?1:-1;
  let pocket={x:a.x-ux*back-uy*50*sign,y:a.y-uy*back+ux*50*sign},far={x:a.x-ux*(back+50),y:a.y-uy*(back+50)};
  let proposal={a,b,pocket,far},token={a,b,pocket,far,goalA:a.goal,goalB:b.goal,arrivalA:a.arrivalRadius||5,startA:{x:a.x,y:a.y},startB:{x:b.x,y:b.y}};
  let inBounds=[pocket,far].every(p=>p.x>=a.r+3&&p.x<=WIDTH-a.r-3&&p.y>=a.r+3&&p.y<=HEIGHT-a.r-3),safe=inBounds&&coordinationPlanClear(token);
  if(index>=6&&inBounds&&!safe){let route=coordinationReturnRoute(a,b,pocket,far);if(route){token.returnRoute=route;if(coordinationPlanClear(token)){proposal.returnRoute=route;safe=true}}}
  if(safe){job.proposals.push(proposal);job.used.add(a);job.used.add(b);job.candidate=null;job.i=0;job.j=0}
  else if(job.candidate.index>=12){autoMarkCold(a,b);job.candidate=null}
  if(job.proposals.length===2)autoAdmit(job);
  return;
 }
 let comparisons=0,visits=0;
 while(job.i<Math.min(12,job.units.length)&&visits<16){
  visits++;let a=job.units[job.i],b=job.units[job.j++];
  if(job.j>=job.units.length){
   stallReadyQueue=stallReadyQueue.filter(e=>e!==a);if(valid.has(a))stallReadyQueue.push(a);
   job.i++;job.j=0;
  }
  if(a===b||!valid.has(a)||!valid.has(b)||job.used.has(a)||job.used.has(b))continue;
  comparisons++;autoStats.comparisons++;
  if(!autoCold(a,b)&&autoReciprocal(a,b)){job.candidate={a,b,index:0};break}
 }
 autoStats.maxPeerVisitsPerStep=Math.max(autoStats.maxPeerVisitsPerStep,visits);autoStats.maxComparisonsPerStep=Math.max(autoStats.maxComparisonsPerStep,comparisons);
 if(job.i>=Math.min(12,job.units.length)&&!job.candidate){if(job.proposals.length===1)autoAdmit(job);else autoJob=null;}
}
const autoNativeUpdate=update;
update=function(dt){if(state.entities.length>128){if(coordinationBatch)batchRelease('auto-entity-cap');autoReset()}let result=autoNativeUpdate(dt);if(dt>0)autoStep();return result};
const autoNativeBatchRelease=batchRelease;
batchRelease=function(reason){let batch=coordinationBatch;if(batch){if(reason!=='completed')for(let p of batch.proposals){let a=batch.records.find(r=>r.e===p.a),b=batch.records.find(r=>r.e===p.b);autoMarkCold(p.a,p.b,a.goal,b.goal,a.x,a.y,b.x,b.y)}for(let r of batch.records){if(autoReservationCommands.get(r.e)?.owner===batch)autoReservationCommands.delete(r.e);let arrived=arrivalReservations.get(r.e);if(arrived&&arrived.owner===batch&&arrived.state===batch.state&&arrived.goal===r.goal){arrivalReservations.delete(r.e);trafficRecord(reservationEvents,{id:r.e.id,reason:'batch-scope-ended',t:state.t})}}}return autoNativeBatchRelease(reason)};
function trafficCanShift(e,x,y){if(!arrivalReservations.size)return true;if(reservationGet(e)&&(x!==e.x||y!==e.y))return false;for(let wall of reservationWalls(e)){let gap=e.r+wall.r+3,dx=x-wall.x,dy=y-wall.y,next=dx*dx+dy*dy,ox=e.x-wall.x,oy=e.y-wall.y;if(next<gap*gap&&next<ox*ox+oy*oy-1e-9)return false}return true}
function clearTraffic(reason){if(coordinationBatch)batchRelease(reason);if(coordinationPair)coordinationRelease(reason);arrivalReservations.clear();autoReset();resetStallObserver();autoState=null;stallObserverState=null}
// Read-only presentation: never call the cleanup-bearing simulation validators here.
function inspectionPlanClear(token){
 let {a,b,pocket,far,goalA,goalB}=token,walls=reservationOriginalObstacles(),futureA={x:goalA.x,y:goalA.y,r:a.r+token.arrivalA},endB=null;
 if(movementSegmentClear(goalB,goalB,b.r,[futureA]))endB=goalB;
 else if(token.arrivalB>5&&token.arrivalB<=16&&patrolPointSafe(b,goalB,walls)){
  let away=Math.atan2(goalB.y-futureA.y,goalB.x-futureA.x),blocked=walls.concat([futureA]);
  outer:for(let radius of [token.arrivalB-.5,token.arrivalB*.5])for(let offset of [0,Math.PI/4,-Math.PI/4,Math.PI/2,-Math.PI/2,Math.PI]){let p={x:goalB.x+Math.cos(away+offset)*radius,y:goalB.y+Math.sin(away+offset)*radius};if(dist(p,goalB)<token.arrivalB&&patrolPointSafe(b,p,blocked)){endB=p;break outer}}
 }
 if(!endB)return false;
 walls=walls.concat(state.entities.filter(e=>e!==a&&e!==b&&e.hp>0&&defs[e.type].speed));
 return coordinationLegsClear([{from:token.startA,to:pocket,r:a.r,wall:{...token.startB,r:b.r}},{from:token.startB,to:far,r:b.r,wall:{...pocket,r:a.r+.1}},{from:pocket,to:goalA,r:a.r,wall:{...far,r:b.r+.1}},{from:far,to:endB,r:b.r,wall:futureA}],walls,token.returnRoute);
}
function inspect(e){
 let batch=coordinationBatch;
 // Nonparticipants do not scan the world or perform geometry.
 if(!e||!batch)return null;
 let record=batch.records.find(r=>r.e===e);if(!record)return null;
 let token=coordinationPair;
 if(!state.started||state.result||restartPrompt||state!==batch.state||state.entities.length>128||state.shots.length||!Number.isFinite(state.t)||state.t<batch.started||state.t-batch.started>=90||!token||token.state!==state||token.serial!==batch.serial||![1,2,3,4].includes(token.phase)||!Number.isInteger(batch.index)||batch.index<0||batch.index>=batch.proposals.length||batch.proposals.length<1||batch.proposals.length>2||batch.records.length!==batch.proposals.length*2)return null;
 let proposal=batch.proposals[batch.index];
 if(token.a!==proposal.a||token.b!==proposal.b||token.pocket.x!==proposal.pocket.x||token.pocket.y!==proposal.pocket.y||token.far.x!==proposal.far.x||token.far.y!==proposal.far.y||![token.started,token.phaseAt].every(Number.isFinite)||state.t<token.started||state.t<token.phaseAt||state.t-token.started>90||state.t-token.phaseAt>30)return null;
 let present=new Set(state.entities),members=new Set();
 for(let r of batch.records){
  let u=r.e,nav=navigationMemory.get(u),arrived=arrivalReservations.get(u),authorization=autoReservationCommands.get(u);
  if(members.has(u)||!present.has(u)||get(u.id)!==u||u.hp<=0||u.hp<r.hp||u.team!==0||u.team!==r.team||u.type!==r.type||!canSetFirePriority(u)||u.build||(u.arrivalRadius||5)!==r.radius||r.radius<=0||r.radius>16||u.target||u.hold||u.holdOnArrival||u.attackMove||u.escortId||u.patrol||u.guardArea||u.moveQueue||u.attackQueue||nav?.yielding||r.owner!==batch||r.goal.x!==r.x||r.goal.y!==r.y||![u.x,u.y,u.r,u.hp,r.x,r.y,r.radius].every(Number.isFinite))return null;
  members.add(u);
  if(u.goal===r.goal){if(nav!==r.nav||nav?.coordinationBatch!==batch||authorization?.state!==state||authorization.owner!==batch||authorization.goal!==r.goal)return null}
  else if(u.goal===null){if(!arrived||arrived.owner!==batch||arrived.state!==state||arrived.goal!==r.goal||arrived.radius!==r.radius||arrived.team!==u.team||arrived.hp>u.hp||arrived.hold!==u.hold||arrived.holdOnArrival!==u.holdOnArrival||arrived.r!==u.r||arrived.x!==u.x||arrived.y!==u.y||dist(u,r.goal)>=r.radius)return null}
  else return null;
 }
 if(batch.proposals.some(p=>p.a===p.b||!members.has(p.a)||!members.has(p.b)||p.a.type!==p.b.type)||new Set(batch.proposals.flatMap(p=>[p.a,p.b])).size!==batch.proposals.length*2)return null;
 for(let [u,goal,gx,gy,radius,done]of [[token.a,token.goalA,token.gxA,token.gyA,token.arrivalA,token.aDone],[token.b,token.goalB,token.gxB,token.gyB,token.arrivalB,false]]){
  let r=batch.records.find(r=>r.e===u);if(u.team!==token.team||u.type!==token.type||goal!==r.goal||gx!==r.x||gy!==r.y||radius!==r.radius)return null;
  if(done){if(token.phase!==4||u.goal!==null)return null}else if(u.goal!==goal||navigationMemory.get(u)?.coordinationPair!==token)return null;
 }
 if((token.phase===4)!==token.aDone||state.entities.some(u=>u.hp>0&&u.team!==0&&defs[u.type].damage&&batch.records.some(r=>dist(u,r.e)<defs[u.type].range+u.r+50))||!inspectionPlanClear(token))return null;
 let group=batch.proposals.findIndex(p=>p.a===e||p.b===e),stage,status;
 if(group>batch.index){if(e.goal!==record.goal)return null;stage='waiting-group';status='等待前组完成'}
 else if(group<batch.index){if(e.goal!==null)return null;stage='arrived-group';status='已抵达，等待其他组完成'}
 else{let a=e===token.a;stage='phase-'+token.phase+(a?'-a':'-b');status=[['退到旁侧空位','等待友车让开'],['在旁侧等待','先通过到暂留位置'],['返回原目标','等待友车返回'],['已抵达，等待本组完成','返回原目标']][token.phase-1][a?0:1]}
 return {kind:'coordination',stage,status:'自动协调：'+status+(state.paused?'（暂停）':''),goal:'原目标：('+Math.round(record.x)+', '+Math.round(record.y)+')',group:group+1,groups:batch.proposals.length};
}
return {clear:clearTraffic,canShift:trafficCanShift,inspect,status:()=>({pairActive:!!coordinationPair,batchActive:!!coordinationBatch,batchIndex:coordinationBatch?.index??null,phase:coordinationPair?.phase??null,registrations:autoReservationCommands.size,reservations:arrivalReservations.size,observations:stallObservations.size,stats:{...autoStats},events:autoEvents.slice(),batchEvents:coordinationBatchEvents.slice(),pairEvents:coordinationEvents.slice(),reservationEvents:reservationEvents.slice()})};
})();

updateUnitReference();reset();refreshSaveSlotStatus();battleSaveProgressTick();requestAnimationFrame(frame);
