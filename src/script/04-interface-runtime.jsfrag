function coordinateAppendReason(){return appendCommandReason()||(!coordinateCommandPoint()?'请填写纯数字整数：X为0–1200，Y为0–800':'')}
function updateCoordinateAppendControl(){let reason=coordinateAppendReason();$('coordinateAppendExecute').disabled=!!reason;setReadonlyPanelProperty($('coordinateAppendExecute'),'title',reason||'追加到队尾，不替换当前任务；最多8项，以原命令回执为准');setReadonlyPanelProperty($('coordinateAppendStatus'),'textContent',reason||'坐标有效；追加仍按当前目标、队列容量与兼容规则检查')}
