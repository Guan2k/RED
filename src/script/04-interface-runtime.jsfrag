// A separate paid construction action; ordinary coordinate commands retain their own contract.
let coordinateConstructionContext=null,coordinateConstructionActivation=null;
function coordinateConstructionType(){return ['power','refinery','factory','turret'].includes(placement)?placement:null}
function coordinateConstructionPoint(){let x=$('coordinateConstructionX').value,y=$('coordinateConstructionY').value;if(!/^[0-9]+$/.test(x)||!/^[0-9]+$/.test(y))return null;x=Number(x);y=Number(y);return Number.isSafeInteger(x)&&Number.isSafeInteger(y)&&x>=0&&y>=0&&x<=WIDTH&&y<=HEIGHT?{x,y}:null}
function cancelCoordinateConstructionActivation(){if(coordinateConstructionActivation){coordinateConstructionActivation.canceled=true;coordinateConstructionActivation.context=null}}
function refreshCoordinateConstructionContext(){let type=coordinateConstructionType(),blocked=commandBlocked();if(blocked||!type||coordinateConstructionContext?.battle!==state||coordinateConstructionContext.type!==type){cancelCoordinateConstructionActivation();coordinateConstructionContext=!blocked&&type?{battle:state,type}:null}return coordinateConstructionContext}
function coordinateConstructionView(){let type=coordinateConstructionType(),p=coordinateConstructionPoint();return type&&p?constructionPreview(type,p):null}
function updateCoordinateConstructionControl(){refreshCoordinateConstructionContext();let type=coordinateConstructionType(),blocked=commandBlocked(),p=coordinateConstructionPoint(),view=coordinateConstructionView();$('coordinateConstructionX').disabled=blocked;$('coordinateConstructionY').disabled=blocked;let b=$('coordinateConstructionExecute');b.disabled=blocked||!view?.canBuild;setReadonlyPanelProperty(b,'textContent',type?'放置'+defs[type].name+' · 花费'+defs[type].cost+'资金':'按坐标放置所选建筑');setReadonlyPanelProperty($('coordinateConstructionStatus'),'textContent',blocked?'当前不能下达建造命令。':!type?'先在基地建设卡片选择待放置建筑。':!p?defs[type].name+' · 报价'+defs[type].cost+'资金；请填写纯数字整数：X为0–1200，Y为0–800。':constructionPreviewLines(view).join('\n'))}
function resetCoordinateConstructionFields(){for(let id of ['coordinateConstructionX','coordinateConstructionY'])$(id).value='';$('coordinateConstructionPanel').open=false;coordinateConstructionContext=null;cancelCoordinateConstructionActivation()}
function coordinateConstructionActivationMatches(a){let context=refreshCoordinateConstructionContext();return !!context&&a.context===context&&a.x===$('coordinateConstructionX').value&&a.y===$('coordinateConstructionY').value&&a.cost===defs[context.type].cost}
function validCoordinateConstructionActivation(){let a=coordinateConstructionActivation;return !a||!a.canceled&&!a.consumed&&coordinateConstructionActivationMatches(a)&&(a.kind==='pointer'?a.released:a.key!==' '||a.released)}
function executeCoordinateConstruction(){if(!refreshCoordinateConstructionContext()||!validCoordinateConstructionActivation())return;let p=coordinateConstructionPoint();if(!p)return;if(coordinateConstructionActivation)coordinateConstructionActivation.consumed=true;place(p);updateUI()}
function beginCoordinateConstructionActivation(kind,detail){let context=refreshCoordinateConstructionContext();if(!context||!coordinateConstructionView()?.canBuild)return;coordinateConstructionActivation={kind,...detail,context,x:$('coordinateConstructionX').value,y:$('coordinateConstructionY').value,cost:defs[context.type].cost,released:false,consumed:false,canceled:false}}
for(let id of ['coordinateConstructionX','coordinateConstructionY'])$(id).oninput=()=>{cancelCoordinateConstructionActivation();updateCoordinateConstructionControl()};
$('coordinateConstructionPanel').ontoggle=updateCoordinateConstructionControl;
$('coordinateConstructionExecute').onclick=executeCoordinateConstruction;
$('coordinateConstructionExecute').onpointerdown=e=>{if(e.isPrimary===false||e.button!==0)return;let a=coordinateConstructionActivation;if(a?.kind==='pointer'&&!a.released&&!a.canceled&&a.pointerId!==e.pointerId)return;beginCoordinateConstructionActivation('pointer',{pointerId:e.pointerId})};
$('coordinateConstructionExecute').onpointerup=e=>{let a=coordinateConstructionActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.isPrimary!==false&&e.button===0)a.released=true};
$('coordinateConstructionExecute').onpointercancel=e=>{let a=coordinateConstructionActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId)cancelCoordinateConstructionActivation()};
$('coordinateConstructionExecute').onlostpointercapture=e=>{let a=coordinateConstructionActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&!a.released)cancelCoordinateConstructionActivation()};
$('coordinateConstructionExecute').onkeydown=e=>{if(e.isComposing||e.keyCode===229||!['Enter',' '].includes(e.key))return;if(e.repeat){e.preventDefault();if(!coordinateConstructionActivation)coordinateConstructionActivation={canceled:true};return}beginCoordinateConstructionActivation('key',{key:e.key})};
$('coordinateConstructionExecute').onkeyup=e=>{let a=coordinateConstructionActivation;if(a?.kind==='key'&&a.key===e.key)a.released=true};
$('coordinateConstructionExecute').onblur=()=>{if(coordinateConstructionActivation&&!coordinateConstructionActivation.consumed)cancelCoordinateConstructionActivation()};
window.addEventListener('pointerup',e=>{let a=coordinateConstructionActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.target!==$('coordinateConstructionExecute'))cancelCoordinateConstructionActivation()});
window.addEventListener('blur',cancelCoordinateConstructionActivation);
document.addEventListener('visibilitychange',()=>{if(document.hidden)cancelCoordinateConstructionActivation()});
function ordinaryMapPoint(p){return Number.isFinite(p.x)&&Number.isFinite(p.y)&&p.x>=0&&p.x<=WIDTH&&p.y>=0&&p.y<=HEIGHT}
