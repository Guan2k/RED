$('coordinateAppendExecute').onlostpointercapture=e=>{if(coordinateAppendActivation&&!coordinateAppendActivation.released)cancelCoordinateAppendActivation(e)};
$('coordinateAppendExecute').onkeydown=e=>{if(e.isComposing||e.keyCode===229||!['Enter',' '].includes(e.key)||coordinateAppendReason())return;if(e.repeat){e.preventDefault();if(!coordinateAppendActivation)coordinateAppendActivation={kind:'key',key:e.key,battle:state,x:$('coordinateCommandX').value,y:$('coordinateCommandY').value,released:false,consumed:true,canceled:true};return}cancelCoordinateAttackActivation();coordinateAppendActivation={kind:'key',key:e.key,battle:state,x:$('coordinateCommandX').value,y:$('coordinateCommandY').value,released:false,consumed:false,canceled:false}};
$('coordinateAppendExecute').onkeyup=e=>{let a=coordinateAppendActivation;if(a?.kind==='key'&&a.key===e.key)a.released=true};
$('coordinateAppendExecute').onblur=()=>{if(coordinateAppendActivation&&!coordinateAppendActivation.consumed)cancelCoordinateAppendActivation()};
