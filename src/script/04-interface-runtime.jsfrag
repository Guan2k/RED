function cancelOrdinaryActivation(e){let a=ordinaryCommandActivation;if(a&&(!e||a.kind==='pointer'&&a.pointerId===e.pointerId))a.canceled=true}
$('ordinaryCommand').onclick=()=>{if(!validOrdinaryActivation()||ordinaryCommandReason())return;if(ordinaryCommandActivation)ordinaryCommandActivation.consumed=true;armOrdinaryCommand()};
$('ordinaryCommand').onpointerdown=e=>{if(e.isPrimary===false||e.button!==0||ordinaryCommandReason())return;let a=ordinaryCommandActivation;if(a&&a.kind==='pointer'&&!a.released&&!a.canceled&&a.pointerId!==e.pointerId)return;ordinaryCommandActivation={kind:'pointer',pointerId:e.pointerId,battle:state,released:false,consumed:false,canceled:false}};
$('ordinaryCommand').onpointerup=e=>{let a=ordinaryCommandActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.isPrimary!==false&&e.button===0)a.released=true};
$('ordinaryCommand').onpointercancel=cancelOrdinaryActivation;
$('ordinaryCommand').onlostpointercapture=e=>{if(ordinaryCommandActivation&&!ordinaryCommandActivation.released)cancelOrdinaryActivation(e)};
$('ordinaryCommand').onkeydown=e=>{if(e.isComposing||e.keyCode===229||!['Enter',' '].includes(e.key)||ordinaryCommandReason())return;if(e.repeat){e.preventDefault();if(!ordinaryCommandActivation)ordinaryCommandActivation={kind:'key',key:e.key,battle:state,released:false,consumed:true,canceled:true};return}ordinaryCommandActivation={kind:'key',key:e.key,battle:state,released:false,consumed:false,canceled:false}};
$('ordinaryCommand').onkeyup=e=>{let a=ordinaryCommandActivation;if(a?.kind==='key'&&a.key===e.key)a.released=true};
$('ordinaryCommand').onblur=()=>{if(ordinaryCommandActivation&&!ordinaryCommandActivation.consumed)cancelOrdinaryActivation()};
function validAppendActivation(){let a=appendCommandActivation;return !a||a.battle===state&&!a.canceled&&!a.consumed&&(a.kind==='pointer'?a.released:a.key!==' '||a.released)}
function cancelAppendActivation(e){let a=appendCommandActivation;if(a&&(!e||a.kind==='pointer'&&a.pointerId===e.pointerId))a.canceled=true}
$('appendCommand').onclick=()=>{if(!validAppendActivation()||appendCommandReason())return;if(appendCommandActivation)appendCommandActivation.consumed=true;armAppendCommand()};
$('appendCommand').onpointerdown=e=>{if(e.isPrimary===false||e.button!==0||appendCommandReason())return;let a=appendCommandActivation;if(a&&a.kind==='pointer'&&!a.released&&!a.canceled&&a.pointerId!==e.pointerId)return;appendCommandActivation={kind:'pointer',pointerId:e.pointerId,battle:state,released:false,consumed:false,canceled:false}};
$('appendCommand').onpointerup=e=>{let a=appendCommandActivation;if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.isPrimary!==false&&e.button===0)a.released=true};
$('appendCommand').onpointercancel=cancelAppendActivation;
$('appendCommand').onlostpointercapture=e=>{if(appendCommandActivation&&!appendCommandActivation.released)cancelAppendActivation(e)};
$('appendCommand').onkeydown=e=>{if(e.isComposing||e.keyCode===229||!['Enter',' '].includes(e.key)||appendCommandReason())return;if(e.repeat){e.preventDefault();if(!appendCommandActivation)appendCommandActivation={kind:'key',key:e.key,battle:state,released:false,consumed:true,canceled:true};return}appendCommandActivation={kind:'key',key:e.key,battle:state,released:false,consumed:false,canceled:false}};
$('appendCommand').onkeyup=e=>{let a=appendCommandActivation;if(a?.kind==='key'&&a.key===e.key)a.released=true};
