function validCoordinateAppendActivation(){let a=coordinateAppendActivation;return !a||a.battle===state&&a.x===$('coordinateCommandX').value&&a.y===$('coordinateCommandY').value&&!a.canceled&&!a.consumed&&(a.kind==='pointer'?a.released:a.key!==' '||a.released)}
function executeCoordinateAppend(){if(!validCoordinateAppendActivation()||coordinateAppendReason())return;let p=coordinateCommandPoint();if(!p)return;if(coordinateAppendActivation)coordinateAppendActivation.consumed=true;resetSelectionClicks();placement=null;attackMode=false;drag=null;issue(p,false,true);updateUI()}
