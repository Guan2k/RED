function rect(x,y,w,h,c){ctx.fillStyle=c;ctx.fillRect(x,y,w,h)}function circle(x,y,r,c){ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fillStyle=c;ctx.fill()}function text(s,x,y,c='#d9e9d0',size=12){ctx.fillStyle=c;ctx.font=size+'px system-ui';ctx.fillText(s,x,y)}
function rangePreviewUnits(){let units=state.entities.filter(e=>selection.has(e.id)&&e.hp>0&&(defs[e.type].damage||defs[e.type].repairRange)&&!e.build);return units.length<=6?units:[]}
function escortDisplayTarget(e){let target=get(e.escortId);return e.team===0&&e.hp>0&&validEscort(e,target)?target:null}
function escortTargetLabel(e){let target=escortDisplayTarget(e);return target?defs[target.type].name+'（'+Math.round(target.x)+','+Math.round(target.y)+'）':null}
function selectedEscortLinks(){let vehicles=state.entities.filter(e=>e.team===0&&e.hp>0&&defs[e.type].speed&&selection.has(e.id));if(vehicles.length>6)return[];return vehicles.map(e=>({unit:e,target:escortDisplayTarget(e)})).filter(link=>link.target)}
function drawEscortOrders(){let links=selectedEscortLinks();if(!links.length)return;ctx.save();ctx.strokeStyle='#78dce8';ctx.lineWidth=1.5;ctx.setLineDash([2,5]);ctx.textAlign='left';ctx.textBaseline='alphabetic';let marked=new Set();for(let {unit,target} of links){ctx.beginPath();ctx.moveTo(unit.x,unit.y);ctx.lineTo(target.x,target.y);ctx.stroke();if(!marked.has(target.id)){marked.add(target.id);ctx.beginPath();ctx.arc(target.x,target.y,target.r+10,0,Math.PI*2);ctx.stroke();text('跟随目标',clamp(target.x+target.r+12,8,WIDTH-68),clamp(target.y-target.r-12,14,HEIGHT-8),'#78dce8',11)}}ctx.restore()}
function drawMiningOrders(){let miners=state.entities.filter(e=>e.team===0&&e.hp>0&&selection.has(e.id)&&assignedOre(e)?.amount>0);if(!miners.length||miners.length>6)return;ctx.save();ctx.strokeStyle='#e4c783';ctx.lineWidth=1.5;ctx.setLineDash([3,7]);let marked=new Set();for(let e of miners){let ore=assignedOre(e);ctx.beginPath();ctx.moveTo(e.x,e.y);ctx.lineTo(ore.x,ore.y);ctx.stroke();if(!marked.has(e.oreIndex)){marked.add(e.oreIndex);ctx.beginPath();ctx.arc(ore.x,ore.y,35,0,Math.PI*2);ctx.stroke()}}ctx.restore()}
function drawSelectionRanges(){ctx.save();for(let e of rangePreviewUnits()){let d=defs[e.type];ctx.strokeStyle=rangeInactive(e)?'#96a69c80':'#b8df9999';ctx.lineWidth=1.5;ctx.setLineDash([7,5]);ctx.beginPath();ctx.arc(e.x,e.y,d.range||d.repairRange,0,Math.PI*2);ctx.stroke();if(d.minRange){ctx.strokeStyle='#ee9778aa';ctx.setLineDash([3,5]);ctx.beginPath();ctx.arc(e.x,e.y,d.minRange,0,Math.PI*2);ctx.stroke()}}ctx.restore()}
function constructionProgressView(e){if(!e||e.hp<=0||!['power','refinery','factory','turret'].includes(e.type)||!Number.isFinite(e.build)||e.build<=0)return null;let total=defs[e.type].time;if(!Number.isFinite(total)||total<=0)return null;let progress=clamp(1-e.build/total,0,1);return{remaining:e.build,total,progress,percent:Math.min(99,Math.floor(progress*100))}}
function drawConstructionProgress(e){let view=constructionProgressView(e);if(!view||e.r<=8)return;let x=e.x-e.r+6,w=e.r*2-12;ctx.save();ctx.beginPath();ctx.rect(e.x-e.r+4,e.y-e.r+4,e.r*2-8,e.r*2-8);ctx.clip();rect(x-1,e.y+e.r-9,w+2,5,'#102019');rect(x,e.y+e.r-8,w*view.progress,3,'#e9c579');ctx.restore()}
function factoryProductionView(e){if(!e||e.team!==0||e.type!=='factory'||e.hp<=0||e.build)return null;let q=state.queue.find(q=>q.factoryId===e.id);if(!q||activeProductionFactory(q)!==e||!Number.isFinite(q.total)||q.total<=0||!Number.isFinite(q.left))return null;let progress=clamp(1-q.left/q.total,0,1),status=productionStateLabel(q),color=status==='已结束'?'#a3aba8':status==='等待出口'?'#ed987f':['游戏暂停','缺电暂停'].includes(status)?'#ebc877':'#8fd6bd',short=status==='已结束'?'已结束':status==='等待出口'?'待出口':status==='游戏暂停'?'暂停':status==='缺电暂停'?'缺电':Math.round(progress*100)+'%';return{order:q,progress,status,color,short}}
function drawFactoryProgress(e){let view=factoryProductionView(e);if(!view||e.r<=8)return;let x=e.x-e.r+6,w=e.r*2-12;ctx.save();ctx.beginPath();ctx.rect(e.x-e.r+4,e.y-e.r+4,e.r*2-8,e.r*2-8);ctx.clip();rect(x,e.y-e.r+5,w,13,'#102019ee');text(view.short,x+3,e.y-e.r+15,view.color,10);rect(x-1,e.y+e.r-9,w+2,5,'#102019');rect(x,e.y+e.r-8,w*view.progress,3,view.color);ctx.restore()}
function drawBuilding(e){let color=e.team?'#a95848':'#5c946b',r=e.r;ctx.save();ctx.translate(e.x,e.y);rect(-r+5,-r+9,r*2,r*2,'#16231c80');rect(-r,-r,r*2,r*2,'#293c31');ctx.strokeStyle=color;ctx.lineWidth=3;ctx.strokeRect(-r,-r,r*2,r*2);rect(-r+6,-r+6,r*2-12,r*2-12,color);if(e.type==='hq'){rect(-24,-17,48,36,'#263b36');rect(-17,-11,34,10,'#8ccebd');rect(-8,10,16,28,'#435545');ctx.strokeStyle='#cad0a0';ctx.beginPath();ctx.moveTo(0,-r);ctx.lineTo(0,-r-23);ctx.stroke();rect(0,-r-23,20,10,e.team?'#e77b58':'#c6dd8b')}if(e.type==='power'){circle(-9,0,12,'#b3b798');circle(10,0,12,'#9ba789');ctx.beginPath();ctx.moveTo(-3,-15);ctx.lineTo(9,-15);ctx.lineTo(1,-3);ctx.lineTo(10,-3);ctx.lineTo(-8,16);ctx.lineTo(-2,2);ctx.lineTo(-10,2);ctx.closePath();ctx.fillStyle='#fff0a4';ctx.fill();ctx.strokeStyle='#5d6743';ctx.lineWidth=1;ctx.stroke()}if(e.type==='factory'){rect(-25,-16,50,34,'#293d32');for(let i=0;i<4;i++)rect(-22+i*12,-12,7,22,'#688879');rect(-15,19,30,12,'#15241d')}if(e.type==='refinery'){circle(-13,-4,14,'#b4ad78');circle(13,-4,14,'#899a73');rect(-22,12,44,10,'#253c2b')}if(e.type==='turret'){ctx.rotate(e.angle);rect(-13,-11,26,22,color);rect(0,-4,34,8,'#ced0ac');circle(0,0,9,'#314d39')}if(e.build){rect(-r,-r,r*2,r*2,'#0a1a10a0');text(Math.ceil(e.build)+'s',-10,4,'#eadc9a',14)}ctx.restore();drawConstructionProgress(e);drawFactoryProgress(e)}
// Building art preview: finite static recipes only; original dynamic layers remain below.
@@RED_BUILDING_ART@@
function buildingArtTrace(target,shape){let [kind,p]=shape;if(kind==='circle'){target.arc(p[0],p[1],p[2],0,Math.PI*2)}else{target.moveTo(p[0],p[1]);for(let i=2;i<p.length;i+=2)target.lineTo(p[i],p[i+1]);target.closePath()}}
let buildingArtPathCache;
function initializeBuildingArtPaths(){if(buildingArtPathCache!==undefined)return;buildingArtPathCache=(()=>{if(typeof Path2D!=='function')return null;try{return Object.freeze(buildingArtGeometry.map(shape=>{let path=new Path2D();buildingArtTrace(path,shape);return path}))}catch{return null}})()}
function drawBuildingStaticBody(type,team){for(let item of buildingArtRecipes[type]){ctx.fillStyle=item[team?3:2];if(item[0]==='rect'){let p=item[1];ctx.fillRect(p[0],p[1],p[2],p[3]);continue}let index=item[1],path=buildingArtPathCache?.[index];if(path){try{ctx.fill(path);continue}catch{buildingArtPathCache=null}}ctx.beginPath();buildingArtTrace(ctx,buildingArtGeometry[index]);ctx.fill()}}
// Shared canonical team triangle; fixed placements only on four larger building bodies.
const buildingTeamCueOrigins=Object.freeze({hq:Object.freeze([-18,-5]),power:Object.freeze([-17,9]),refinery:Object.freeze([-22,9]),factory:Object.freeze([19,1])});
function drawBuildingTeamCue(type,team){
  if(!Object.hasOwn(buildingTeamCueOrigins,type))return;
  let p=buildingTeamCueOrigins[type];ctx.save();ctx.translate(p[0],p[1]);
  rect(-1,-1,8,6,'#14201b');
  if(team){
    ctx.fillStyle='#e7d9b4';let path=buildingArtPathCache?.[19],painted=false;
    if(path){try{ctx.fill(path);painted=true}catch{buildingArtPathCache=null}}
    if(!painted){ctx.beginPath();buildingArtTrace(ctx,buildingArtGeometry[19]);ctx.fill()}
  }else{rect(0,0,6,1.5,'#e7d9b4');rect(0,2.5,6,1.5,'#e7d9b4')}
  ctx.restore()
}
function drawBuildingPreview(e){
  if(!Object.hasOwn(buildingArtCanonicalRadius,e.type)||e.r!==buildingArtCanonicalRadius[e.type])return drawBuilding(e);
  let color=e.team?'#a95848':'#5c946b',r=e.r;ctx.save();ctx.translate(e.x,e.y);
  rect(-r+5,-r+9,r*2,r*2,'#16231c80');ctx.strokeStyle=color;ctx.lineWidth=3;
  drawBuildingStaticBody(e.type,e.team);
  drawBuildingTeamCue(e.type,e.team);
  if(e.type==='hq'){ctx.strokeStyle='#cad0a0';ctx.beginPath();ctx.moveTo(0,-r);ctx.lineTo(0,-r-23);ctx.stroke();rect(0,-r-23,20,10,e.team?'#e77b58':'#c6dd8b')}
  if(e.type==='turret'){ctx.rotate(e.angle);rect(-13,-11,26,22,color);rect(0,-4,34,8,'#ced0ac');circle(0,0,9,'#314d39')}
  if(e.build){rect(-r,-r,r*2,r*2,'#0a1a10a0');text(Math.ceil(e.build)+'s',-10,4,'#eadc9a',14)}
  ctx.restore();drawConstructionProgress(e);drawFactoryProgress(e)
}
const unitTrackMemory=new WeakMap();
function unitTrackPhase(e){let v=unitTrackMemory.get(e);if(!v){v={x:e.x,y:e.y,phase:0};unitTrackMemory.set(e,v)}else{v.phase=(v.phase+Math.hypot(e.x-v.x,e.y-v.y))%7;v.x=e.x;v.y=e.y}return v.phase}
function drawUnit(e){let phase=unitTrackPhase(e),d=defs[e.type],color=e.team?'#b35d49':'#7da477';ctx.save();ctx.translate(e.x,e.y);ctx.rotate(e.angle);rect(-e.r+2,-e.r+4,e.r*2,e.r*2,'#0d211680');rect(-e.r,-e.r,e.r*2,5,'#202c24');rect(-e.r,e.r-5,e.r*2,5,'#202c24');rect(-e.r,-e.r+5,e.r*2,e.r*2-10,color);for(let x=-e.r-7+phase;x<e.r;x+=7){let left=Math.max(-e.r,x),right=Math.min(e.r,x+2);if(right>left){rect(left,-e.r,right-left,4,'#687361');rect(left,e.r-4,right-left,4,'#687361')}}if(e.type==='harvester'){rect(-11,-8,13,16,'#b4b086');rect(7,-10,9,20,'#dcbe70');rect(-11,8,Math.max(1,e.load/180*20),3,'#e9c55f')}else if(e.type==='repair'){rect(-9,-8,18,16,'#bfd5b0');rect(-2,-6,4,12,'#2c7350');rect(-6,-2,12,4,'#2c7350')}else{circle(0,0,e.type==='tank'?9:6,color);rect(0,-3,e.type==='artillery'?34:e.type==='tank'?24:17,6,'#c0c7a3');if(e.type==='artillery'){rect(-11,-7,14,14,'#bac4a0');rect(-13,-12,4,24,'#263e2c')}}ctx.restore()}
const terrainAccentTiles=[];for(let y=0;y<HEIGHT;y+=40)for(let x=0;x<WIDTH;x+=40)if(Math.sin(x*13+y*27)>.2)terrainAccentTiles.push([x,y]);
let vehicleArtPreview=false;
// Draw-only art pilot: immutable polygon paths, exact direct-command fallback.
// No simulation fields, RNG, raster caches or separate turret rotation are introduced.
@@RED_UNIT_ART@@
function unitArtTrace(target,points){target.moveTo(points[0],points[1]);for(let i=2;i<points.length;i+=2)target.lineTo(points[i],points[i+1]);target.closePath()}
let unitArtPathCache;
function initializeUnitArtPaths(){if(unitArtPathCache!==undefined)return;unitArtPathCache=(()=>{if(typeof Path2D!=='function')return null;try{return Object.freeze(unitArtGeometry.map(points=>{let path=new Path2D();unitArtTrace(path,points);return path}))}catch{return null}})()}
function unitArtPoly(points,color,cacheIndex=-1){ctx.fillStyle=color;let path=cacheIndex>=0&&unitArtPathCache?unitArtPathCache[cacheIndex]:null;if(path){try{ctx.fill(path);return}catch{unitArtPathCache=null}}ctx.beginPath();unitArtTrace(ctx,points);ctx.fill()}
function drawUnitPreview(e){
  let phase=unitTrackPhase(e),r=e.r,color=e.team?'#a66755':'#75977c',high=e.team?'#d19b7e':'#a4b49a',dark=e.team?'#6f4038':'#405c49';
  let usePaths=Object.hasOwn(unitArtCanonicalRadius,e.type)&&unitArtCanonicalRadius[e.type]===r;
  ctx.save();ctx.translate(e.x,e.y);ctx.rotate(e.angle);
  rect(-r+2,-r+4,r*2,r*2,'#0d211680');
  if(e.type==='scout'){
    for(let x of[-8,3])for(let y of[-10,6])rect(x,y,6,4,'#17231d');
    unitArtPoly(unitArtGeometry[0],'#17271e',usePaths?0:-1);
    unitArtPoly(unitArtGeometry[1],color,usePaths?1:-1);
    rect(-6,-5,7,2,high);rect(-3,-3,7,6,dark);rect(2,-1.5,15,3,'#c0c7a3');
  }else{
    rect(-r,-r,r*2,5,'#202c24');rect(-r,r-5,r*2,5,'#202c24');
    for(let x=-r-7+phase;x<r;x+=7){let left=Math.max(-r,x),right=Math.min(r,x+2);if(right>left){rect(left,-r,right-left,4,'#687361');rect(left,r-4,right-left,4,'#687361')}}
    if(e.type==='tank'){
      unitArtPoly(unitArtGeometry[2],'#17271e',usePaths?2:-1);
      unitArtPoly(unitArtGeometry[3],color,usePaths?3:-1);
      rect(-10,-7,14,2,high);unitArtPoly(unitArtGeometry[4],dark,usePaths?4:-1);
      rect(-4,-5,7,2,high);rect(3,-2,21,4,'#c0c7a3');rect(20,-2.5,4,5,dark);
    }else if(e.type==='artillery'){
      unitArtPoly(unitArtGeometry[5],'#17271e',usePaths?5:-1);
      unitArtPoly(unitArtGeometry[6],color,usePaths?6:-1);
      rect(-11,-8,14,2,high);rect(-12,-7,12,14,dark);rect(-9,-5,7,10,high);
      rect(-2,-2.5,36,5,'#c0c7a3');rect(29,-3.5,5,7,dark);
    }else if(e.type==='repair'){
      unitArtPoly(unitArtGeometry[7],'#17271e',usePaths?7:-1);
      unitArtPoly(unitArtGeometry[8],color,usePaths?8:-1);
      rect(-10,-7,15,14,'#b4c5ab');rect(7,-3,4,6,dark);
      unitArtPoly(unitArtGeometry[9],dark,usePaths?9:-1);
      rect(-10,8,13,2,'#d9bd77');rect(3,6,3,4,'#d9bd77');
    }else if(e.type==='harvester'){
      rect(-15,-10,23,20,color);rect(-13,-8,17,16,dark);rect(-12,-7,15,2,high);
      rect(-10,-3,5,6,'#b59b60');rect(-4,-5,6,9,'#d0b16f');rect(8,-10,7,20,'#c6ab6b');
      rect(10,-10,1,20,'#524f38');rect(13,-10,1,20,'#524f38');
      rect(-11,8,Math.max(1,e.load/180*20),3,'#e9c55f');
    }
  }
  // Small rear-corner team stencil; leave the role-defining hull detail visible.
  // Secondary cue may weaken at half-scale; never enlarge the collision footprint.
  let badgeX=-r+2,badgeY=-r+5;rect(badgeX-1,badgeY-1,8,6,'#14201b');
  if(e.team)unitArtPoly([badgeX,badgeY,badgeX+6,badgeY+2,badgeX,badgeY+4],'#e7d9b4');
  else{rect(badgeX,badgeY,6,1.5,'#e7d9b4');rect(badgeX,badgeY+2.5,6,1.5,'#e7d9b4')}
  ctx.restore();
}

function drawTerrain(){let meridian=state.mapChoice==='meridian',ring=state.mapChoice==='ring',frontier=state.mapChoice==='frontier',canyon=state.mapChoice==='canyon',ridge=state.mapChoice==='ridge',crossroads=state.mapChoice==='crossroads',switchback=state.mapChoice==='switchback';rect(0,0,WIDTH,HEIGHT,meridian?'#3b454a':ring?'#3c4541':switchback?'#48463c':crossroads?'#3c4745':ridge?'#35483f':canyon?'#494b41':frontier?'#5b553c':'#354a37');ctx.fillStyle=meridian?'#424d51':ring?'#424c46':switchback?'#504d42':crossroads?'#414e4b':ridge?'#3b4f44':canyon?'#505247':frontier?'#625a40':'#394d3a';ctx.beginPath();for(let [x,y] of terrainAccentTiles)ctx.rect(x,y,40,40);ctx.fill();ctx.strokeStyle='#9aba7810';ctx.lineWidth=1;ctx.setLineDash([]);ctx.beginPath();for(let x=0;x<=WIDTH;x+=40){ctx.moveTo(x,0);ctx.lineTo(x,HEIGHT)}for(let y=0;y<=HEIGHT;y+=40){ctx.moveTo(0,y);ctx.lineTo(WIDTH,y)}ctx.stroke();ctx.strokeStyle='#596446';ctx.lineWidth=70;ctx.beginPath();if(meridian){for(let x of[60,600,1140]){ctx.moveTo(600,0);ctx.bezierCurveTo(600,130,x,180,x,400);ctx.bezierCurveTo(x,620,600,670,600,800)}}else if(ring){for(let y of[180,630]){ctx.moveTo(0,400);ctx.bezierCurveTo(290,400,350,y,600,y);ctx.bezierCurveTo(850,y,910,400,1200,400)}}else if(switchback){ctx.moveTo(0,400);ctx.bezierCurveTo(250,400,350,470,470,470);ctx.bezierCurveTo(580,470,630,570,730,570);ctx.bezierCurveTo(870,570,930,400,1200,400);for(let y of [70,755]){ctx.moveTo(0,400);ctx.bezierCurveTo(260,400,330,y,470,y);ctx.lineTo(730,y);ctx.bezierCurveTo(870,y,960,400,1200,400)}ctx.moveTo(600,180);ctx.lineTo(600,660)}else if(crossroads){for(let y of [120,400,680]){ctx.moveTo(0,400);ctx.bezierCurveTo(280,400,350,y,600,y);ctx.bezierCurveTo(850,y,920,400,1200,400)}ctx.moveTo(600,40);ctx.lineTo(600,760)}else if(ridge){ctx.moveTo(0,400);ctx.lineTo(1200,400);ctx.moveTo(0,400);ctx.bezierCurveTo(300,400,370,60,600,60);ctx.bezierCurveTo(830,60,900,400,1200,400);ctx.moveTo(0,400);ctx.bezierCurveTo(300,400,370,740,600,740);ctx.bezierCurveTo(830,740,900,400,1200,400)}else if(canyon){ctx.moveTo(0,400);ctx.bezierCurveTo(400,400,450,300,600,300);ctx.bezierCurveTo(750,300,850,400,1200,400);ctx.moveTo(0,400);ctx.bezierCurveTo(400,400,450,500,600,500);ctx.bezierCurveTo(750,500,850,400,1200,400)}else if(frontier){ctx.moveTo(0,400);ctx.bezierCurveTo(400,100,800,150,1200,400);ctx.moveTo(0,400);ctx.bezierCurveTo(400,700,800,650,1200,400)}else{ctx.moveTo(0,770);ctx.bezierCurveTo(400,600,710,300,1200,90)}ctx.stroke()}
function orderPath(e){let nav=navigationMemory.get(e);return e.goal&&selection.size<=6&&nav?.route?.length>1&&dist(nav.goal,e.goal)<=8?nav.route:e.goal?[e.goal]:[]}
function viewingFinishedBattle(){return !!(state.started&&state.result&&$('overlay').classList.contains('hidden'))}
function inspectionBlocked(){return viewingFinishedBattle()?!!drag:commandBlocked()||!!placement||!!drag}
function hoverEntity(){if(!hoverActive||inspectionBlocked()||mouse.x<0||mouse.x>WIDTH||mouse.y<0||mouse.y>HEIGHT)return null;return nearest(mouse,state.entities.filter(e=>e.hp>0&&dist(e,mouse)<e.r+6))||null}
function hoverOre(entity=hoverEntity()){if(!hoverActive||inspectionBlocked()||mouse.x<0||mouse.x>WIDTH||mouse.y<0||mouse.y>HEIGHT||entity)return null;return nearest(mouse,state.ores.filter(o=>dist(o,mouse)<=32))||null}
function oreInspectionLines(ore){let index=state.ores.indexOf(ore),miners=state.entities.filter(e=>e.team===0&&e.hp>0&&e.type==='harvester'),assigned=miners.filter(e=>e.oreIndex===index).length,nearby=miners.filter(e=>dist(e,ore)<=80).length,ref=nearest(ore,structures(0,'refinery').filter(e=>!e.build)),lines=['矿点 · 剩余 '+Math.ceil(ore.amount),'已指定 '+assigned+' 辆 · 附近己方矿车 '+nearby+' 辆',ref?'精炼厂直线距离 '+Math.round(dist(ore,ref))+'（地图单位）':'暂无已建成的己方精炼厂'];if(ore.amount<=0)lines.push('矿点已耗尽，指定矿车将自动改选');else{lines.push(viewingFinishedBattle()?'战局已结束 · 矿点状态仅供复盘':'选中矿车后右键指定；实际路程需考虑绕行');if(nearby>=4)lines.push('附近矿车较多，可分流至其他矿点')}return lines}
function unitRoleHint(type){switch(type){case 'tank':return '装甲主力；对侦察车直击伤害 ×1.2';case 'scout':return '高速机动夺点；血量较低，注意保护';case 'artillery':return '远程攻坚；对建筑直击 ×1.25，近身有盲区';case 'repair':return '付费修复非维修载具；不能修理建筑';case 'harvester':return '开采后运回精炼厂；不能占领据点';default:return ''}}

// Static read-only reference, generated from canonical definitions and existing role/power helpers.
function unitReferenceEntries(){return Object.entries(defs).map(([type,d])=>{let lines=[d.name+' · '+(d.speed?'车辆':'建筑'),d.cost==null?'开局设施；不可购买或新建':'费用 '+d.cost+' · '+(d.speed?'生产':'施工')+' '+d.time+' 游戏秒','生命 '+d.hp];if(d.speed)lines.push('速度 '+d.speed+' · 不耗电');else lines.push('完工后：'+(type==='power'?'供电 '+STATION_POWER_SUPPLY:'电力需求 '+buildingPowerDemand(type)));if(type==='hq')lines.push('固定基础供电 '+BASE_POWER_SUPPLY+' 不依赖指挥中心数量或存亡，指挥中心不另增供电');if(d.damage)lines.push('直击基础伤害 '+d.damage+' · 开火间隔 '+d.rate+' 游戏秒 · 标称射程 '+d.range+(d.minRange?' · 最小射程 '+d.minRange:''));else lines.push('无武器');if(d.splashRadius)lines.push('直击目标周围 '+d.splashRadius+' 范围内的其他敌方车辆：中心最多 '+d.splashDamage+' 溅射伤害，随中心距离递减；不伤友军或周围建筑');if(d.repairRange)lines.push('标称维修范围 '+d.repairRange+' · 每游戏秒最多恢复 '+d.repairRate+' 生命；消耗资金，仅修复受损己方非维修车辆，不能修理自身、其他维修车或建筑；受开关与维修资金预留限制');if(d.capacity)lines.push('载矿容量 '+d.capacity+'；须运回已完工己方精炼厂交付');if(type==='factory')lines.push('已完工且供电充足时推进车辆生产');if(type==='refinery')lines.push('已完工后接收矿车交付');if(type==='turret')lines.push('已完工且供电充足时可开火；机动作战禁止新建己方炮塔，敌方不受此限制');let role=unitRoleHint(type);if(role)lines.push(role);return {type,text:lines.join('；')}})}
function updateUnitReference(){$('unitReferenceText').textContent=unitReferenceEntries().map(entry=>entry.text).join('\n\n')}

function yieldingInspection(e){let coordinated=trafficCoordination.inspect(e);if(coordinated)return coordinated;if(!state.started||state.result||!canSetFirePriority(e)||!pocketEligible(e)||e.attackQueue)return null;let y=navigationMemory.get(e)?.yielding,p=e.goal;if(!y||!['retreat','wait'].includes(y.phase)||get(e.id)!==e||y.goal!==p||p.x!==y.gx||p.y!==y.gy||(e.arrivalRadius||5)!==y.arrival||![p.x,p.y,y.px,y.py,y.expires].every(Number.isFinite)||state.t>y.expires)return null;let peer=get(y.peerId);if(!peer||![peer.x,peer.y,y.peerArrival,y.arrival].every(Number.isFinite)||y.peerArrival<=0||y.arrival<=0||peer.attackQueue||peer.team!==e.team||peer.type!==e.type||peer.build||peer.hold||peer.target||peer.escortId||peer.patrol||peer.guardArea||peer.moveQueue||peer.attackMove||(peer.arrivalRadius||5)!==y.peerArrival||(peer.goal&&(peer.goal!==y.peerGoal||peer.goal.x!==y.px||peer.goal.y!==y.py))||(!peer.goal&&dist(peer,{x:y.px,y:y.py})>=y.peerArrival))return null;return{status:y.phase==='retreat'?'临时让行：退到旁侧空位':peer.goal?'临时让行：等友车先到达':'临时让行：准备返回原目标',goal:'原目标：('+Math.round(p.x)+', '+Math.round(p.y)+')'}}
// Read-only ordered coordinates: entity goals retain the order while navigation/yielding uses separate memory.
function orderedRouteView(selected){let empty={kind:'none',points:[],message:'请仅选择一辆存活、已完工己方战斗车，或一座已完工己方工厂'};if(selected.length!==1)return empty;let e=selected[0];if(!e||e.team!==0||!(e.hp>0)||e.build)return empty;let point=p=>!!p&&Number.isFinite(p.x)&&Number.isFinite(p.y),copy=p=>({x:p.x,y:p.y});if(e.type==='factory'){if(!e.rally)return{kind:'factory',points:[],message:'工厂：未设置集结中心'};if(!point(e.rally))return{kind:'factory',points:[],message:'工厂：集结坐标不可用，不列坐标'};return{kind:'factory',points:[copy(e.rally)],message:'工厂集结中心 · '+(e.rallyHold===true?'新战斗车抵达后坚守':'新车攻击移动')+'；仅显示已存中心，不验证当前可用性'}}if(!canSetFirePriority(e))return empty;if(e.target||e.attackQueue||e.escortId||e.patrol||e.guardArea||e.hold||e.attackMove)return{kind:'unsupported',points:[],message:'当前命令不是普通地面移动；不列普通路线坐标'};if(!e.goal)return{kind:'unit',points:[],message:'当前没有普通地面目的地'};let queue=e.moveQueue;if(!point(e.goal)||(queue&&(!Array.isArray(queue)||!queue.length||queue.length>8||queue.some(p=>!point(p))||queue[0].x!==e.goal.x||queue[0].y!==e.goal.y)))return{kind:'unsupported',points:[],message:'普通路线数据不一致；不推测坐标'};let points=(queue||[e.goal]).map(copy);return{kind:'unit',points,message:'普通地面目的地 · '+points.length+' / 8（含当前）'+(e.holdOnArrival===true?' · 末段抵达后坚守':'')+'；临时绕路与让行不改变此列表'}}
function updateOrderedRoute(selected){let view=orderedRouteView(selected),prefix=state.result?'终局快照：':!state.started?'未开局快照：':restartPrompt?'重开菜单快照：':state.paused?'暂停快照：':'当前命令快照：';setReadonlyPanelProperty($('orderedRouteStatus'),'textContent',prefix+view.message);for(let i=0;i<8;i++){let node=$('orderedRoutePoint'+i),p=view.points[i];setReadonlyPanelProperty(node,'hidden',!p);setReadonlyPanelProperty(node,'textContent',p?(view.kind==='factory'?'集结中心':i===0?'当前目的地':'后续目的地')+'（'+Math.round(p.x)+', '+Math.round(p.y)+'）':'')}}
function combatOrderInspection(e){if(!canSetFirePriority(e)||e.guardArea||validEscort(e,get(e.escortId)))return[];let yieldView=yieldingInspection(e),target=attackDisplayTarget(e),status=yieldView?yieldView.status:e.patrol?'往返巡逻 · 前往'+(e.patrol.next?'B':'A')+'端':e.hold?'坚守阵地':target?'指定攻击：'+defs[target.type].name:e.goal?(e.attackMove?'攻击移动':'普通移动'):'待命';let lines=['命令：'+status];if(yieldView)lines.push(yieldView.goal);let route=e.moveQueue?.length?'剩余 '+e.moveQueue.length+' 个路点（含当前）':'';if(e.holdOnArrival===true)route+=(route?' · ':'')+'末段抵达后坚守';if(route)lines.push(route);if(e.attackQueue){let queued=attackQueueTargets(e);lines.push('攻击队列：'+queued.length+' 个存活目标'+(queued.length>1?' · 下个'+defs[queued[1].type].name:''))}return lines}
function arrivalHoldSummary(selected){let eligible=selected.filter(canHoldOnArrival);if(!eligible.length)return'';let count=eligible.filter(e=>e.holdOnArrival===true).length;return'\n抵达坚守预约：'+count+'/'+eligible.length+' 辆可设战车'}
function supportOrderInspection(e){if(!e||e.team!==0||e.hp<=0||e.build)return[];if(e.type==='harvester')return['工作：'+harvesterWorkDescription(e)];if(e.type!=='repair')return[];let follow=escortDisplayTarget(e),target=get(e.target),status=e.hold?'坚守维修位置':follow?'跟随'+defs[follow.type].name:target&&target.team!==e.team?'尝试与指定敌军保持距离':e.goal?(e.attackMove?'避敌行进（不开火）':'普通移动'):'原地待命';return['命令：'+status]}
function inspectionLines(e){let d=defs[e.type],lines=[(e.team===0?'己方 ':'敌方 ')+d.name+' · 生命 '+Math.ceil(e.hp)+'/'+e.max];let role=unitRoleHint(e.type);if(role)lines.push(role);if(e.build){let buildView=constructionProgressView(e);lines.push('施工中：'+(buildView?'完成度 '+buildView.percent+'% · ':'')+'剩余 '+Math.ceil(e.build)+' 游戏秒')};if(d.damage)lines.push('伤害 '+d.damage+' / '+d.rate+'秒 · 标称射程 '+(d.minRange?d.minRange+'–':'')+d.range);if(e.type==='turret'&&!e.build)lines.push(powered(e.team)?'电力正常，可开火':'缺电，无法开火');else if(d.repairRange)lines.push(e.repairEnabled===false?'自动维修暂停 · 范围 '+d.repairRange:'维修范围 '+d.repairRange+' · 修复友军载具');else if(e.type==='harvester')lines.push(e.team===0?'载矿 '+e.load+'/180':'采矿与运输车辆');else if(e.type==='hq')lines.push(e.team===0?'核心建筑 · 需要重点保护':'敌方指挥中心 · 主要歼灭目标');else if(e.type==='refinery')lines.push('矿车交付矿石的地点',...refineryEconomyLines(e));else if(e.type==='power')lines.push(e.build?'建成后提供100电力':'提供100电力');if(e.team===0&&d.damage&&validEscort(e,get(e.escortId)))lines.push('护航采矿车 · 接敌后继续跟随');if(e.team===0&&assignedOre(e)?.amount>0)lines.push('指定矿点 · 剩余 '+Math.ceil(assignedOre(e).amount));if(e.guardArea)lines.push('驻点警戒 · 接敌范围180，无合格目标时回防');lines.push(...combatOrderInspection(e),...supportOrderInspection(e));if(d.speed)lines.push('移动速度 '+d.speed+'（按游戏时间）');if(e.team===0&&e.type==='factory'&&!e.build){let view=factoryProductionView(e);if(view)lines.push('本厂订单：'+defs[view.order.type].name+' · '+view.status,'完成度 '+Math.round(view.progress*100)+(state.result?'% · 结束时剩余 ':'% · 剩余 ')+Math.ceil(Math.max(0,view.order.left))+' 游戏秒');else lines.push('本厂暂无已分配订单')}return lines}
function hoverPost(entity=hoverEntity(),ore=hoverOre(entity)){if(!hoverActive||inspectionBlocked()||mouse.x<0||mouse.x>WIDTH||mouse.y<0||mouse.y>HEIGHT||entity||ore)return null;return nearest(mouse,state.posts.filter(p=>dist(p,mouse)<=33))||null}
function postInspectionLines(p,present=postPresence(p)){let contested=present[0]>0&&present[1]>0,blocked=p.owner>=0&&present[1-p.owner]>0,side=contested?-1:present[0]?0:present[1]?1:-1,taking=side>=0&&side!==p.owner,owner=p.owner===0?'己方所有':p.owner===1?'敌方所有':'中立',team=t=>t===0?'己方':'敌方',progress=(Math.floor(p.progress*10)/10).toFixed(1),lines=['据点 · '+owner,'控制半径65 · 车辆中心需在圈内（<65）','有效战斗车：己方 '+present[0]+' / 敌方 '+present[1]];lines.push(contested?'双方争夺：夺点进度冻结':taking?team(side)+'抢占中：尚未完成易主':p.owner<0?'中立：等待单方战斗车占领':'当前无抢占，原归属保持');if(taking&&p.side===side)lines.push('占领进度：'+team(side)+' '+progress+'/8游戏秒');else if(taking)lines.push('单方持续夺点需8游戏秒，换方从0计');else if(p.side>=0&&p.progress>0)lines.push((contested?'保留':'残余')+'夺点进度：'+team(p.side)+' '+progress+'/8秒'+(contested?'':'（将回退）'));else lines.push('占领需8游戏秒；双方同在时不推进');lines.push(p.owner<0?'收益：中立无收入':blocked?'收益：原归属方暂停收入':'收益：正常持有时，所属方每10秒+30');lines.push('建筑、矿车、维修车不计；警戒180另算');if(state.objective==='stronghold')lines.push(p===strongholdPost()?'本点是驻守目标：拥有且留战斗车在圈内才计时':'本点不是驻守目标，仍可占领获取资金',p===strongholdPost()?'双方同在暂停；本方无人或失去归属归零':'胜利计时只取地图上标记的目标据点');if(state.objective==='control')lines.push('控点获胜：至少2座有效点，累计90秒');if(state.objective==='harvest')lines.push('据点收入不计矿石交付分数');if(state.paused)lines.push('游戏已暂停：夺点和收益计时均不推进');return lines}
function drawPostCaptureRange(p){if(!p)return;ctx.save();ctx.fillStyle='#e4c78310';ctx.strokeStyle='#e4c783bb';ctx.lineWidth=1.5;ctx.setLineDash([4,5]);ctx.beginPath();ctx.arc(p.x,p.y,65,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.setLineDash([]);ctx.textAlign='left';ctx.textBaseline='alphabetic';text('据点控制65',clamp(p.x-34,8,WIDTH-80),Math.max(14,p.y-71),'#e4c783',11);ctx.restore()}
function hoverRock(entity=hoverEntity(),ore=hoverOre(entity),post=hoverPost(entity,ore)){if(!hoverActive||inspectionBlocked()||mouse.x<0||mouse.x>WIDTH||mouse.y<0||mouse.y>HEIGHT||entity||ore||post)return null;if(state.entities.some(e=>e.hp>0&&dist(e,mouse)<e.r+9&&(e.team===1||(!attackMode&&e.team===0&&defs[e.type].speed&&e.type!=='repair'))))return null;return nearest(mouse,terrainObstacles().filter(o=>dist(o,mouse)<o.r+20))||null}
function rockInspectionLines(o){return['岩石障碍 · 岩体半径 '+o.r,'浅色内圈：岩体，阻挡移动与重叠建造','金色外圈内：空地点令须避开岩外20','敌军目标、普通模式护航点另行判断','仅提示此岩点击范围；仍需避开其他岩石','圈外不保证路线可达；移动留车身半径+3','建造另留建筑半径+15的间距','车辆会尝试绕行，狭窄处仍可能被堵','岩石不可选中或摧毁；不阻挡索敌与炮火']}
function inspectionBox(lines){ctx.save();ctx.font='12px system-ui';let w=Math.min(360,Math.max(150,...lines.map(s=>ctx.measureText(s).width+24))),h=lines.length*18+16;ctx.restore();let x=mouse.x+18,y=mouse.y+18;if(x+w>WIDTH-8)x=mouse.x-w-18;if(y+h>HEIGHT-8)y=mouse.y-h-18;return{x:clamp(x,8,WIDTH-w-8),y:clamp(y,8,HEIGHT-h-8),w,h}}
function rangeInactive(e){return !!e.build||(e.type==='turret'&&!powered(e.team))||(e.type==='repair'&&e.repairEnabled===false)}
function hoverRangePreview(e=hoverEntity()){if(!e)return null;let d=defs[e.type];if((!d.range&&!d.repairRange)||rangePreviewUnits().some(unit=>unit.id===e.id))return null;return{entity:e,outer:d.range||d.repairRange,inner:d.minRange||0,support:!!d.repairRange,disabled:rangeInactive(e)}}
function drawHoverRange(entity){let view=hoverRangePreview(entity);if(!view)return;let e=view.entity;ctx.save();ctx.strokeStyle=view.disabled?'#a3aba880':view.support?'#91dcd4bb':e.team===1?'#ec967ecc':'#b8df99bb';ctx.lineWidth=2;ctx.setLineDash([9,5]);ctx.beginPath();ctx.arc(e.x,e.y,view.outer,0,Math.PI*2);ctx.stroke();if(view.inner){ctx.strokeStyle=view.disabled?'#a3aba880':'#f2c889bb';ctx.setLineDash([3,5]);ctx.beginPath();ctx.arc(e.x,e.y,view.inner,0,Math.PI*2);ctx.stroke()}ctx.restore()}
// Current-render-only candidate preview. Never consumed by the command executor.
function clearOrdinaryPreviewMirror(){let node=$('ordinaryCommandPreviewText');if(node&&node.textContent!=='')node.textContent='';if(canvas.getAttribute('aria-describedby')==='ordinaryCommandPreviewText')canvas.removeAttribute('aria-describedby')}
function updateOrdinaryPreviewMirror(lines){let value=lines.join('\n'),node=$('ordinaryCommandPreviewText');if(!value){clearOrdinaryPreviewMirror();return}if(node&&node.textContent!==value)node.textContent=value;if(canvas.getAttribute('aria-describedby')!=='ordinaryCommandPreviewText')canvas.setAttribute('aria-describedby','ordinaryCommandPreviewText')}
function ordinaryCommandPreview(p){if(!ordinaryCommandMode||appendCommandMode||!hoverActive||commandBlocked()||placement||attackMode||drag||!ordinaryMapPoint(p)||ordinaryCommandGesture&&(ordinaryCommandGesture.moved||ordinaryCommandGesture.battle!==state))return null;let {enemy,escort}=mapCommandTarget(p,false),header=enemy?'点令候选：敌方'+defs[enemy.type].name+' #'+enemy.id:escort?'点令候选：己方'+defs[escort.type].name+' #'+escort.id:'点令候选：当前坐标',tokens=[];if(mapCommandRockBlocked(p,enemy,escort))tokens=['岩石禁点区域：本次不下令'];else{let oreIndex=mapCommandOreIndex(p,enemy,false),troops=mapCommandTroops(),factories=mapCommandFactories(),counts=new Map(),add=kind=>counts.set(kind,(counts.get(kind)||0)+1);for(let e of troops){if(mapCommandOreCandidate(e,oreIndex))add('指定矿点');else if(mapCommandEscortCandidate(e,escort))add(e.type==='repair'?'维修跟随':'护航矿车');else if(enemy)add(defs[e.type].damage?'攻击目标':'非战斗记录');else add('移动')}if(!enemy&&factories.length)counts.set('工厂集结',factories.length);for(let kind of ['指定矿点','护航矿车','维修跟随','移动','工厂集结','攻击目标','非战斗记录'])if(counts.has(kind))tokens.push(kind+counts.get(kind)+(kind==='非战斗记录'?'（不代表攻击）':''));if(!tokens.length)tokens.push(enemy&&factories.length?'无车辆候选；工厂原设置保留':'当前无可下令的车辆或已完工工厂')}return{header,tokens}}
function ordinaryCommandPreviewLines(view){if(!view)return[];ctx.save();ctx.font='12px system-ui';let rows=[],row='',fits=s=>ctx.measureText(s).width<=336;for(let token of view.tokens){let next=row?row+' · '+token:token;if(row&&!fits(next)){rows.push(row);row=token}else row=next}if(row)rows.push(row);let lines=[view.header,...rows,'当前快照；抬起重判，接收看回执','不保证抵达或目标到抬起仍有效'];if(rows.length>3||lines.some(line=>!fits(line)))lines=['点令候选：内容超出当前显示宽度','请缩小选区后查看分类','当前快照；抬起重判，接收看回执','不保证抵达或目标到抬起仍有效'];ctx.restore();return lines}
function drawHoverInspection(post=hoverPost(),e=hoverEntity(),ore=e?null:hoverOre(e),rock=hoverRock(e,ore,post)){if(e||ore)post=null;if(e||ore||post)rock=null;let preview=ordinaryCommandPreviewLines(ordinaryCommandPreview(mouse));if(!e&&!ore&&!post&&!rock&&!preview.length){clearOrdinaryPreviewMirror();return}let lines=e?inspectionLines(e):ore?oreInspectionLines(ore):post?postInspectionLines(post):rock?rockInspectionLines(rock):[],previewStart=lines.length;if(preview.length){lines=lines.concat(preview);updateOrdinaryPreviewMirror(lines)}else clearOrdinaryPreviewMirror();let box=inspectionBox(viewingFinishedBattle()?(lines=['战后查看 · 只读',...lines]):lines),color=e?(e.team===0?'#a3db81':'#e78f6a'):ore?(ore.amount>0?'#e4c783':'#96a69c'):rock?'#c4c1b0':'#e4c783';ctx.save();ctx.globalAlpha=1;if(ore){ctx.strokeStyle=color;ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(ore.x,ore.y,35,0,Math.PI*2);ctx.stroke()}if(rock){ctx.strokeStyle=color;ctx.lineWidth=1.5;ctx.setLineDash([4,4]);ctx.beginPath();ctx.arc(rock.x,rock.y,rock.r,0,Math.PI*2);ctx.stroke();ctx.strokeStyle='#e4c783';ctx.setLineDash([7,5]);ctx.beginPath();ctx.arc(rock.x,rock.y,rock.r+20,0,Math.PI*2);ctx.stroke();ctx.setLineDash([])}rect(box.x,box.y,box.w,box.h,'#102019f2');ctx.strokeStyle=color;ctx.lineWidth=1;ctx.strokeRect(box.x,box.y,box.w,box.h);lines.forEach((line,i)=>text(line,box.x+12,box.y+20+i*18,preview.length&&i===previewStart?'#f5d997':i?'#dce6d2':color,12));ctx.restore()}
function postOverviewStatus(){let snapshot=state.result?'终局快照：模拟已结束':!state.started?'未开局：预置战场快照（菜单选项仅影响下一局）':restartPrompt?'重开菜单：当前战局暂停快照':state.paused?'暂停快照：模拟不推进':'当前战场快照';let rule=state.objective==='control'?'争夺目标：至少2座有效点才累计90秒；仍有2座归属但受阻时暂停，归属不足2座归零。':state.objective==='stronghold'?'驻守目标：只计标记点，归属方须有战斗车留圈才累计90秒；双方同在暂停，本方无人或失去归属归零。':state.objective==='harvest'?'据点收益不计矿石交付目标。':'据点可争夺，当前胜利条件不使用据点90秒计时。';return snapshot+'。'+rule}
function postOverviewText(p,index){let present=postPresence(p),contested=present[0]>0&&present[1]>0,blocked=p.owner>=0&&present[1-p.owner]>0,inspection=postInspectionLines(p,present),owner=p.owner===0?'己方':p.owner===1?'敌方':'中立',target=state.objective==='stronghold'&&p===strongholdPost(),control=p.owner<0?'中立，无有效归属':blocked?'归属受对立方战斗车阻断，不算有效控制':'有效控制：'+owner,payout=p.owner<0?'收益不符合：中立无收入':blocked?'收益受阻：归属方收入计时暂停':'收益条件符合：归属方按现有10游戏秒结算30资金规则；非即时到账';return '据点 '+(index+1)+'（'+Math.round(p.x)+','+Math.round(p.y)+'）'+(target?' · 驻守目标':'')+' · 归属：'+owner+'。圈内战斗车：己方 '+present[0]+' / 敌方 '+present[1]+'。'+(contested?'双方争夺。':'')+inspection[3]+'；'+inspection[4]+'。'+control+'。'+payout+'。'+(target?strongholdStatus()+'。':'')}
function updatePostOverview(){updatePostSelectionControls();setReadonlyPanelProperty($('postOverviewStatus'),'textContent',postOverviewStatus());for(let i=0;i<3;i++)setReadonlyPanelProperty($('postOverview'+(i+1)),'textContent',state.posts[i]?postOverviewText(state.posts[i],i):'据点 '+(i+1)+'：当前无记录')}
// Match postPresence exactly, with the friendly-team restriction for selection only.
let postSelectionActivations=[null,null,null],postSelectionMessage='';
function postSelectionUnits(p){return p?state.entities.filter(e=>e.team===0&&e.hp>0&&defs[e.type].speed&&e.type!=='harvester'&&e.type!=='repair'&&dist(e,p)<65):[]}
function cancelPostSelectionActivation(i){let a=postSelectionActivations[i];if(a){a.canceled=true;a.battle=null;a.post=null}}
function cancelPostSelectionActivations(){for(let i=0;i<3;i++)cancelPostSelectionActivation(i)}
function postSelectionActivationValid(i){let a=postSelectionActivations[i];return !a||!a.canceled&&!a.consumed&&a.battle===state&&a.post===state.posts[i]&&(a.kind==='pointer'?a.released:a.key!==' '||a.released)}
function updatePostSelectionControls(){let blocked=commandBlocked();for(let i=0;i<3;i++){let p=state.posts[i],a=postSelectionActivations[i],b=$('selectPostTroops'+(i+1));if(a&&(blocked||a.battle!==state||a.post!==p))cancelPostSelectionActivation(i);let count=postSelectionUnits(p).length;setReadonlyPanelProperty(b,'textContent','选择据点 '+(i+1)+(p?'（X '+Math.round(p.x)+'，Y '+Math.round(p.y)+'）':'')+' 圈内己方战斗车 · '+count);setReadonlyPanelProperty(b,'disabled',blocked||!p||!count)}setReadonlyPanelProperty($('postSelectionStatus'),'textContent',blocked?'当前不可选择：尚未开战、重开菜单或战局结束。':postSelectionMessage||'按钮按操作时圈内成员选择，不调动圈外增援，也不自动坚守。')}
function selectPostTroops(i){if(commandBlocked()||!Number.isInteger(i)||i<0||i>=3||!postSelectionActivationValid(i))return;let p=state.posts[i];if(!p)return;let units=postSelectionUnits(p);if(postSelectionActivations[i])postSelectionActivations[i].consumed=true;if(!units.length){postSelectionMessage='据点 '+(i+1)+' 当前没有圈内己方战斗车；保留原选择与待点选操作。';updateUI();return}resetSelectionClicks();selection=new Set(units.map(e=>e.id));placement=null;attackMode=false;drag=null;clearOrdinaryCommand();postSelectionMessage='已选择据点 '+(i+1)+' 圈内 '+units.length+' 辆己方战斗车；原命令与编队保留，不自动坚守。';updateUI()}
for(let i=0;i<3;i++){let b=$('selectPostTroops'+(i+1));b.onclick=()=>selectPostTroops(i);b.onpointerdown=e=>{if(e.isPrimary===false||e.button!==0||commandBlocked()||!state.posts[i]||!postSelectionUnits(state.posts[i]).length)return;let a=postSelectionActivations[i];if(a?.kind==='pointer'&&!a.released&&!a.canceled&&a.pointerId!==e.pointerId)return;postSelectionActivations[i]={kind:'pointer',pointerId:e.pointerId,battle:state,post:state.posts[i],released:false,consumed:false,canceled:false}};b.onpointerup=e=>{let a=postSelectionActivations[i];if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.isPrimary!==false&&e.button===0)a.released=true};b.onpointercancel=e=>{let a=postSelectionActivations[i];if(a?.kind==='pointer'&&a.pointerId===e.pointerId)cancelPostSelectionActivation(i)};b.onlostpointercapture=e=>{let a=postSelectionActivations[i];if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&!a.released)cancelPostSelectionActivation(i)};b.onkeydown=e=>{if(e.isComposing||e.keyCode===229||!['Enter',' '].includes(e.key)||commandBlocked()||!postSelectionUnits(state.posts[i]).length)return;if(e.repeat){e.preventDefault();if(!postSelectionActivations[i])postSelectionActivations[i]={canceled:true};return}postSelectionActivations[i]={kind:'key',key:e.key,battle:state,post:state.posts[i],released:false,consumed:false,canceled:false}};b.onkeyup=e=>{let a=postSelectionActivations[i];if(a?.kind==='key'&&a.key===e.key)a.released=true};b.onblur=()=>{if(postSelectionActivations[i]&&!postSelectionActivations[i].consumed)cancelPostSelectionActivation(i)}}
window.addEventListener('pointerup',e=>{for(let i=0;i<3;i++){let a=postSelectionActivations[i];if(a?.kind==='pointer'&&a.pointerId===e.pointerId&&e.target!==$('selectPostTroops'+(i+1)))cancelPostSelectionActivation(i)}});
window.addEventListener('blur',cancelPostSelectionActivations);
document.addEventListener('visibilitychange',()=>{if(document.hidden)cancelPostSelectionActivations()});
window.addEventListener('keydown',e=>{if(e.key==='Escape'&&!e.isComposing&&e.keyCode!==229)cancelPostSelectionActivations()});
function postCaption(p){return p.contested?'争夺中':p.controlBlocked?'抢占中':p.owner<0?'中立据点':'+30 / 10s'}
function oreLabelLayout(){ctx.save();ctx.font='11px system-ui';const measured=new Map(),metrics=s=>{if(measured.has(s))return measured.get(s);let m=ctx.measureText(s),b={left:Math.max(0,m.actualBoundingBoxLeft||0),right:Math.max(m.width,m.actualBoundingBoxRight||0),up:Math.max(11,m.actualBoundingBoxAscent||0),down:Math.max(3,m.actualBoundingBoxDescent||0)};measured.set(s,b);return b},box=(p,m)=>({left:p.x-m.left-2,right:p.x+m.right+2,top:p.y-m.up-2,bottom:p.y+m.down+2});const postBoxes=state.posts.map(p=>box({x:p.x-30,y:p.y+46},metrics(postCaption(p)))),rangeMetrics=metrics('据点控制65'),rangeBoxes=state.posts.map(p=>box({x:clamp(p.x-34,8,WIDTH-80),y:Math.max(14,p.y-71)},rangeMetrics)),labels=[],marker=state.mapChoice==='meridian'&&state.objective==='stronghold'?strongholdPost():null,markerBoxes=marker?[{left:marker.x-32,right:marker.x+40,top:marker.y-94,bottom:marker.y-70},{left:marker.x-66,right:marker.x+78,top:marker.y+66,bottom:marker.y+90}]:[];let normalBoxes,expandedBoxes;for(let o of state.ores){if(o.amount<=0)continue;let label='矿 '+Math.ceil(o.amount/1000)+'k',m=metrics(label),candidates=[{x:o.x-25,y:o.y+48},{x:o.x-25,y:o.y-74},{x:o.x+90,y:o.y+4},{x:o.x-m.right-90,y:o.y+4},{x:o.x-25,y:o.y+100}].map(p=>({x:clamp(p.x,4+m.left,WIDTH-4-m.right),y:clamp(p.y,4+m.up,HEIGHT-4-m.down)}));let safe=(p,expanded)=>{let b=box(p,m),radius=expanded?68:36,boxes=expanded?(expandedBoxes??=postBoxes.concat(rangeBoxes,markerBoxes)):(normalBoxes??=postBoxes.concat(markerBoxes));return !state.posts.some(q=>{let dx=q.x-clamp(q.x,b.left,b.right),dy=q.y-clamp(q.y,b.top,b.bottom);return dx*dx+dy*dy<=radius*radius})&&!boxes.some(q=>b.left<q.right&&b.right>q.left&&b.top<q.bottom&&b.bottom>q.top)};let p=safe(candidates[0],false)?candidates[0]:candidates.slice(1).find(p=>safe(p,true))||candidates[0];labels.push({ore:o,label,x:p.x,y:p.y})}ctx.restore();return labels}
function drawStrongholdMarker(){if(state.objective!=='stronghold')return;let p=strongholdPost();if(!p)return;ctx.save();ctx.fillStyle='#e4c7830a';ctx.strokeStyle='#e4c783';ctx.lineWidth=2;ctx.setLineDash([8,5]);ctx.beginPath();ctx.arc(p.x,p.y,65,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.setLineDash([]);text('驻守目标',p.x-28,p.y-76,'#f5d997',13);text('我 '+Math.floor(state.controlProgress[0])+'/90 · 敌 '+Math.floor(state.controlProgress[1])+'/90',p.x-61,p.y+83,'#f5d997',12);ctx.restore()}
function render(){let buildPreview=placement&&hoverActive&&!drag&&!commandBlocked()&&mouse.x>=0&&mouse.x<=WIDTH&&mouse.y>=0&&mouse.y<=HEIGHT?constructionPreview(placement,mouse):null,hoveredEntity=hoverEntity(),hoveredOre=hoverOre(hoveredEntity),postPreview=hoverPost(hoveredEntity,hoveredOre),hoveredRock=hoverRock(hoveredEntity,hoveredOre,postPreview);drawTerrain();drawCoordinateGrid();drawRocks();drawStrongholdMarker();for(let {ore:o,label,x,y} of oreLabelLayout()){circle(o.x,o.y,33,'#746544');for(let i=0;i<8;i++){let a=i*2.4;rect(o.x+Math.cos(a)*22-4,o.y+Math.sin(a)*21-5,9,12,i%2?'#c6b96d':'#e5d183')}text(label,x,y,'#e2d692',11)}for(let p of state.posts){let color=p.owner===0?'#9ddd8a':p.owner===1?'#df8a70':'#bfc39b';circle(p.x,p.y,27,'#233d2d');ctx.strokeStyle=color;ctx.lineWidth=2;ctx.beginPath();ctx.arc(p.x,p.y,28,0,Math.PI*2);ctx.stroke();rect(p.x-1,p.y-20,3,36,color);rect(p.x+2,p.y-20,19,12,color);if(p.progress>0){ctx.strokeStyle=p.side===0?'#a1ed84':'#f69872';ctx.lineWidth=4;ctx.beginPath();ctx.arc(p.x,p.y,33,-Math.PI/2,-Math.PI/2+Math.PI*2*p.progress/8);ctx.stroke()}text(postCaption(p),p.x-30,p.y+46,color,11)}drawConstructionRange(buildPreview);drawMiningOrders();drawEscortOrders();drawAttackOrders();drawQueuedAttackOrders();drawFactoryRallies();drawGuardAreas();drawPatrolOrders();drawQueuedOrders();drawSelectionRanges();drawPostCaptureRange(postPreview);drawHoverRange(hoveredEntity);for(let e of state.entities){if(selection.has(e.id)&&e.goal){let path=orderPath(e);ctx.save();ctx.setLineDash([5,7]);ctx.strokeStyle=path.length>1?'#80d4e0':e.attackMove?'#e9be72':'#aee099';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(e.x,e.y);for(let p of path)ctx.lineTo(p.x,p.y);ctx.stroke();ctx.setLineDash([]);if(path.length>1){ctx.fillStyle='#80d4e0';for(let p of path.slice(0,-1))ctx.fillRect(p.x-3,p.y-3,6,6)}ctx.strokeRect(e.goal.x-4,e.goal.y-4,8,8);ctx.restore()}if(e.hp/e.max<.3){ctx.strokeStyle='#ed9870';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(e.x,e.y,e.r+8,0,Math.PI*2);ctx.stroke()}if(selection.has(e.id)){ctx.strokeStyle='#b6ee95';ctx.lineWidth=2;ctx.strokeRect(e.x-e.r-5,e.y-e.r-5,e.r*2+10,e.r*2+10)}defs[e.type].speed?(vehicleArtPreview?drawUnitPreview(e):drawUnit(e)):(vehicleArtPreview?drawBuildingPreview(e):drawBuilding(e));if(e.hp<e.max||selection.has(e.id)){let healthY=Math.max(0,e.y-e.r-12);rect(e.x-e.r,healthY,e.r*2,4,'#16231b');rect(e.x-e.r,healthY,e.r*2*Math.max(0,e.hp/e.max),4,e.team?'#e78f6a':'#a3db81')}}for(let s of state.shots)circle(s.x,s.y,3,'#ffedac');for(let f of state.fx){let p=1-f.t/f.max;ctx.globalAlpha=f.t/f.max;if(f.type==='order'){ctx.strokeStyle='#c9f59d';ctx.lineWidth=2;ctx.beginPath();ctx.arc(f.x,f.y,8+p*25,0,Math.PI*2);ctx.stroke()}else if(f.type==='blast'){ctx.strokeStyle='#efbc78';ctx.lineWidth=2;ctx.beginPath();ctx.arc(f.x,f.y,f.radius*(.3+.7*p),0,Math.PI*2);ctx.stroke()}else if(f.type==='repair'){ctx.strokeStyle='#b2ebbb';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(f.x,f.y);ctx.lineTo(f.x2,f.y2);ctx.stroke();circle(f.x2,f.y2,4,'#c7f0be')}else if(f.type==='cash')text('+'+(f.amount||0),f.x,f.y-p*30,'#e9d98c',15);else{circle(f.x,f.y,(f.type==='boom'?40:15)*p+4,'#e69e4c');circle(f.x,f.y,(f.type==='boom'?22:8)*p+2,'#ffe0a0')}ctx.globalAlpha=1}drawConstructionGhost(buildPreview);if(drag&&dist(drag,mouse)>5){ctx.strokeStyle='#b5e997';ctx.fillStyle='#ade78b22';ctx.fillRect(drag.x,drag.y,mouse.x-drag.x,mouse.y-drag.y);ctx.strokeRect(drag.x,drag.y,mouse.x-drag.x,mouse.y-drag.y)}if(state.paused&&state.started&&!state.result){rect(0,0,WIDTH,HEIGHT,'#10231a88');text('战场已暂停',470,400,'#e5e8bd',32)}drawBattleAlert();drawHoverInspection(postPreview,hoveredEntity,hoveredOre,hoveredRock);drawConstructionBlocker(buildPreview);drawConstructionPanel(buildPreview);updateCoordinateAid()}
