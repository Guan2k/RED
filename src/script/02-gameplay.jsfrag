function separateUnits(){let units=state.entities.filter(e=>e.hp>0&&defs[e.type].speed),obstacles=movementObstacles();function canShift(e,x,y){if(!trafficCoordination.canShift(e,x,y))return false;for(let wall of obstacles){let gap=e.r+wall.r+3,dx=x-wall.x,dy=y-wall.y;if(dx>=gap||dx<=-gap||dy>=gap||dy<=-gap)continue;let next=dx*dx+dy*dy;if(next<gap*gap){let ox=e.x-wall.x,oy=e.y-wall.y;if(next<ox*ox+oy*oy-1e-9)return false}}return true}function resolvePair(a,b){let dx=b.x-a.x,dy=b.y-a.y,gap=a.r+b.r+3;if(dx>=gap||dx<=-gap||dy>=gap||dy<=-gap)return;let d=Math.hypot(dx,dy);if(d>=gap)return;if(d<.001){dx=1;dy=0;d=1}let push=Math.min((gap-d)/2,2);function shift(wa,wb,sideFirst=false){wa=Math.min(wa,2/push);wb=Math.min(wb,2/push);for(let attempt=0;attempt<(sideFirst?5:3);attempt++){let direction=sideFirst?(attempt<2?attempt+3:attempt-2):attempt,diagonal=direction>=3,axis=diagonal?direction-2:direction,vx=(axis===0?dx:axis===1?-dy:dy)/d*push,vy=(axis===0?dy:axis===1?dx:-dx)/d*push;if(diagonal){vx+=dx/d*push;vy+=dy/d*push;let scale=Math.min(1,2/(Math.hypot(vx,vy)*Math.max(wa,wb)));vx*=scale;vy*=scale}let ax=clamp(a.x-vx*wa,a.r,WIDTH-a.r),ay=clamp(a.y-vy*wa,a.r,HEIGHT-a.r),bx=clamp(b.x+vx*wb,b.r,WIDTH-b.r),by=clamp(b.y+vy*wb,b.r,HEIGHT-b.r),safeA=canShift(a,ax,ay),safeB=canShift(b,bx,by),ma=(ax!==a.x||ay!==a.y)&&safeA,mb=(bx!==b.x||by!==b.y)&&safeB;if(diagonal&&(!ma||!mb))continue;if(ma||mb){if(ma){a.x=ax;a.y=ay}if(mb){b.x=bx;b.y=by}return true}if(safeA&&safeB)break}return false}let movingA=movementIntent.has(a),movingB=movementIntent.has(b),yieldA=a.team===b.team&&!movingA&&movingB&&!a.hold,yieldB=a.team===b.team&&!movingB&&movingA&&!b.hold;if(a.team===b.team&&!!a.hold!==!!b.hold&&!((a.hold?navigationMemory.get(b):navigationMemory.get(a))?.crowdRetry>0)&&(a.hold?movingB&&!movingA:movingA&&!movingB)&&shift(a.hold?0:2,b.hold?0:2))return;if((yieldA||yieldB)&&shift(yieldA?2:0,yieldB?2:0))return;let reciprocal=goalMovementIntent.has(a)&&goalMovementIntent.has(b)&&navigationMemory.get(a)?.crowdRetry>0&&navigationMemory.get(b)?.crowdRetry>0&&a.team===b.team&&!a.hold&&!b.hold&&a.goal&&b.goal&&dist(a.goal,b.goal)>=gap&&dist(a,b.goal)<gap&&dist(b,a.goal)<gap&&((a.goal.x-a.x)*(b.goal.x-b.x)+(a.goal.y-a.y)*(b.goal.y-b.y))<0&&a.x>=a.r+gap*2+3&&a.x<=WIDTH-a.r-gap*2-3&&a.y>=a.r+gap*2+3&&a.y<=HEIGHT-a.r-gap*2-3&&b.x>=b.r+gap*2+3&&b.x<=WIDTH-b.r-gap*2-3&&b.y>=b.r+gap*2+3&&b.y<=HEIGHT-b.r-gap*2-3&&obstacles.every(w=>dist(a,w)>=a.r+w.r+gap*2+3&&dist(b,w)>=b.r+w.r+gap*2+3);shift(1,1,reciprocal)}if(units.length<512){for(let i=0;i<units.length;i++)for(let j=i+1;j<units.length;j++)resolvePair(units[i],units[j])}else{let buckets=new Map(),cells=[],maxRadius=0;for(let e of units)maxRadius=Math.max(maxRadius,e.r);function refreshCell(i){let e=units[i],key=Math.floor(e.x/64)+','+Math.floor(e.y/64),previous=cells[i];if(key===previous)return;if(previous!==undefined)buckets.get(previous).delete(i);let bucket=buckets.get(key);if(!bucket){bucket=new Set();buckets.set(key,bucket)}bucket.add(i);cells[i]=key}function boundsKey(a){let reach=a.r+maxRadius+4;return Math.floor((a.x-reach)/64)+','+Math.floor((a.x+reach)/64)+','+Math.floor((a.y-reach)/64)+','+Math.floor((a.y+reach)/64)}function candidatesAfter(a,after){let found=[],reach=a.r+maxRadius+4;for(let cy=Math.floor((a.y-reach)/64);cy<=Math.floor((a.y+reach)/64);cy++)for(let cx=Math.floor((a.x-reach)/64);cx<=Math.floor((a.x+reach)/64);cx++){let bucket=buckets.get(cx+','+cy);if(bucket)for(let j of bucket)if(j>after)found.push(j)}found.sort((a,b)=>a-b);return found}for(let i=0;i<units.length;i++)refreshCell(i);let crowded=false;for(let bucket of buckets.values())if(bucket.size>32){crowded=true;break}if(crowded){for(let i=0;i<units.length;i++)for(let j=i+1;j<units.length;j++)resolvePair(units[i],units[j])}else for(let i=0;i<units.length;i++){let a=units[i],candidates=candidatesAfter(a,i),bounds=boundsKey(a);for(let k=0;k<candidates.length;k++){let j=candidates[k],b=units[j],ax=a.x,ay=a.y,bx=b.x,by=b.y;resolvePair(a,b);let movedA=ax!==a.x||ay!==a.y;if(movedA)refreshCell(i);if(bx!==b.x||by!==b.y)refreshCell(j);if(movedA){let nextBounds=boundsKey(a);if(nextBounds!==bounds){bounds=nextBounds;candidates=candidatesAfter(a,j);k=-1}}}}}movementIntent=new WeakSet();goalMovementIntent=new WeakSet();pocketRouteBudget=2}
function nearest(e,list){let best=null,bestDistance=Infinity;for(let item of list){let d=dist(e,item);if(!best||d<bestDistance){best=item;bestDistance=d}}return best}
function canSetFirePriority(e){return !!e&&e.team===0&&e.hp>0&&!e.build&&['tank','scout','artillery'].includes(e.type)}
function firePriority(e){return e?.team===0&&['critical','artillery'].includes(e.firePriority)&&['tank','scout','artillery'].includes(e.type)?e.firePriority:'nearest'}
function nextFirePriority(units){return units.length&&units.every(e=>firePriority(e)==='critical')?'artillery':units.length&&units.every(e=>firePriority(e)==='artillery')?'nearest':'critical'}
function firePriorityLabel(value){return value==='artillery'?'火炮优先':value==='critical'?'重伤优先':'就近'}
function selectedFireUnits(){return state.entities.filter(e=>selection.has(e.id)&&canSetFirePriority(e))}
function toggleFirePriority(){if(commandBlocked())return;let units=selectedFireUnits();if(!units.length)return;let mode=nextFirePriority(units);for(let e of units){if(mode==='nearest')delete e.firePriority;else e.firePriority=mode}tell('自动选敌已改为'+firePriorityLabel(mode)+(mode==='artillery'?'：优先当前可开火的敌方火炮，否则就近；原命令和已锁定目标保留':mode==='critical'?'：按剩余生命比例排序；手动指定及警戒已锁定目标保留':'：原命令和已锁定目标保留'));updateUI()}
function firePrioritySummary(selected){let units=selected.filter(canSetFirePriority);if(!units.length)return '';let critical=units.filter(e=>firePriority(e)==='critical').length,artillery=units.filter(e=>firePriority(e)==='artillery').length;return '\n自动选敌：重伤优先 '+critical+' / 就近 '+(units.length-critical-artillery)+' / 火炮优先 '+artillery}
function artilleryFireTarget(e,list,r=Infinity){let best=null,bestDistance=Infinity,bestPriority=false,weapon=defs[e.type];for(let b of list){if(b.team===e.team||!(b.hp>0))continue;let dx=e.x-b.x,dy=e.y-b.y;if(!(dx<r&&dx>-r&&dy<r&&dy>-r))continue;let d=Math.hypot(dx,dy);if(!(d<r))continue;let priority=b.type==='artillery'&&d<=weapon.range+b.r&&(!weapon.minRange||d>=weapon.minRange);if(!best||priority&&!bestPriority||priority===bestPriority&&d<bestDistance){best=b;bestDistance=d;bestPriority=priority}}return best}
function chooseFireTarget(e,list){if(firePriority(e)==='artillery')return artilleryFireTarget(e,list);if(firePriority(e)!=='critical')return nearest(e,list);let best=null,bestRatio=Infinity,bestDistance=Infinity;for(let b of list){let ratio=b.hp/b.max,d=dist(e,b);if(!best||ratio<bestRatio||ratio===bestRatio&&d<bestDistance){best=b;bestRatio=ratio;bestDistance=d}}return best}
function criticalEnemyInRange(e,r){let best=null,bestRatio=Infinity,bestDistance=Infinity;for(let b of state.entities){if(b.team===e.team||!(b.hp>0))continue;let dx=e.x-b.x,dy=e.y-b.y;if(!(dx<r&&dx>-r&&dy<r&&dy>-r))continue;let d=Math.hypot(dx,dy);if(!(d<r))continue;let ratio=b.hp/b.max;if(!best||ratio<bestRatio||ratio===bestRatio&&d<bestDistance){best=b;bestRatio=ratio;bestDistance=d}}return best}
function heldFireTarget(e){let d=defs[e.type],candidates=state.entities.filter(b=>{if(b.team===e.team||!(b.hp>0))return false;let distance=dist(e,b);return distance>=(d.minRange||0)&&distance<=d.range+b.r});return chooseFireTarget(e,candidates)||null}
function nearestEnemyInRange(e,r){if(firePriority(e)==='artillery')return artilleryFireTarget(e,state.entities,r);if(firePriority(e)==='critical')return criticalEnemyInRange(e,r);let best=null,bestDistance=Infinity;for(let b of state.entities){if(b.team===e.team||!(b.hp>0))continue;let dx=e.x-b.x,dy=e.y-b.y;if(!(dx<r&&dx>-r&&dy<r&&dy>-r))continue;let d=Math.hypot(dx,dy);if(d<r&&(!best||d<bestDistance)){best=b;bestDistance=d}}return best}
function withinRange(a,b,r){let dx=a.x-b.x,dy=a.y-b.y;return dx<r&&dx>-r&&dy<r&&dy>-r&&Math.hypot(dx,dy)<r}
function toggleRepairService(){if(!state.started||state.result||restartPrompt)return;let units=state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.type==='repair'&&e.hp>0);if(!units.length)return;let enabled=!units.some(e=>e.repairEnabled!==false);units.forEach(e=>e.repairEnabled=enabled);tell(enabled?'自动维修已开启：每1资金最多恢复3生命':'自动维修已暂停');updateUI()}
function validEscort(e,target){return !!target&&target.hp>0&&target.team===e.team&&defs[target.type].speed&&target.type!=='repair'&&target.id!==e.id&&(e.type==='repair'||!!(defs[e.type].speed&&defs[e.type].damage&&target.type==='harvester'))}
function updateMinerEscort(e){let escort=get(e.escortId);if(!validEscort(e,escort)){e.escortId=null;e.goal=null;e.target=null;return}e.target=null;e.attackMove=true;e.goal=dist(e,escort)>80?{x:escort.x,y:escort.y}:null}
function repairReserve(){return [0,100,300,500].includes(state.repairReserve)?state.repairReserve:0}
function changeRepairReserve(amount){if(commandBlocked())return;if(![0,100,300,500].includes(amount)){updateUI();return}if(amount===repairReserve())return;if(amount===0)delete state.repairReserve;else state.repairReserve=amount;tell('全军自动维修保留资金：'+amount+'；只限制己方维修车自动修复，其他消费照常');updateUI()}
function automaticRepairCash(team){return team===0?Math.max(0,state.cash-repairReserve()):state.enemyCash}
function repairWorkDescription(e){if(!e||e.team!==0||e.type!=='repair'||!(e.hp>0)||e.build)return'';let label='维修状态：';if(!state.started)return label+'尚未开战';if(state.result)return label+'战局结束';if(restartPrompt)return label+'重开确认中';if(state.paused)label+='游戏暂停（不会执行维修） · ';if(e.repairEnabled===false)return label+'自动维修已关闭';if(e.cool>0)return label+'维修间隔剩余 '+(Math.ceil(e.cool*10)/10).toFixed(1)+' 游戏秒';let ally=chooseRepairTarget(e,get(e.escortId));if(!ally)return label+'当前范围内无可修车辆';if(automaticRepairCash(e.team)<1)return label+'可用维修资金不足1（受余额和保留额限制）';return label+'当前位置候选 '+defs[ally.type].name+'（'+Math.round(ally.x)+','+Math.round(ally.y)+'），生命 '+(Math.ceil(ally.hp)>=ally.max?'低于满血':Math.ceil(ally.hp)+'/'+ally.max)+'；移动及其他维修车可能改变下次结果'}
// Repair diagnostics are explicit snapshots; never retain or mutate entity objects.
const repairWorkLabels={off:'关闭',cooldown:'冷却',noTarget:'无目标',noCash:'资金不足',candidate:'有候选'};
let repairWorkSnapshot=null;
function repairWorkReason(e){if(!e||e.team!==0||e.type!=='repair'||!(e.hp>0)||e.build)return null;if(e.repairEnabled===false)return 'off';if(e.cool>0)return 'cooldown';if(!chooseRepairTarget(e,get(e.escortId)))return 'noTarget';if(automaticRepairCash(e.team)<1)return 'noCash';return 'candidate'}
function repairFleetWork(){let counts=Object.fromEntries(Object.keys(repairWorkLabels).map(k=>[k,0])),ids=Object.fromEntries(Object.keys(repairWorkLabels).map(k=>[k,[]])),total=0;for(let e of state.entities){let reason=repairWorkReason(e);if(reason===null)continue;counts[reason]++;ids[reason].push(e.id);total++}return {total,counts,ids}}
function clearRepairWorkSnapshot(){repairWorkSnapshot=null;$('repairWorkStatus').textContent=''}
function repairWorkLimitation(){return !state.started?'尚未开战 · 只读':state.result?'战局结束 · 只读':restartPrompt?'重开确认中 · 只读':state.paused?'模拟暂停 · 可排查和选择，不会执行维修':'模拟运行中 · 候选不代表正在维修'}
function updateRepairWorkOverview(){let snapshot=repairWorkSnapshot;setReadonlyPanelProperty($('repairWorkSummary'),'textContent',repairWorkLimitation()+'\n'+(snapshot?'检查快照：游戏 '+snapshot.time.toFixed(1)+' 秒 · '+snapshot.checkedAt+' · 己方维修车共 '+snapshot.total+' 辆\n'+Object.entries(repairWorkLabels).map(([key,label])=>label+' '+snapshot.counts[key]).join(' · ')+'\n快照不会随状态变化更新；请刷新或点击选择重新检查。':'尚无检查快照；展开或点击刷新。'));setReadonlyPanelProperty($('selectRepairWorkReason'),'disabled',commandBlocked()||!Object.hasOwn(repairWorkLabels,$('repairWorkReason').value))}
function refreshRepairWorkSnapshot(){repairWorkSnapshot={...repairFleetWork(),time:state.t,checkedAt:new Date().toLocaleTimeString()};updateRepairWorkOverview();return repairWorkSnapshot}
function selectRepairWorkReason(){if(commandBlocked())return;let key=$('repairWorkReason').value;if(!Object.hasOwn(repairWorkLabels,key))return;let snapshot=refreshRepairWorkSnapshot(),ids=snapshot.ids[key];if(ids.length){resetSelectionClicks();selection=new Set(ids);placement=null;attackMode=false;drag=null;clearOrdinaryCommand()}updateUI();$('repairWorkStatus').textContent=ids.length?'已选择 '+ids.length+' 辆「'+repairWorkLabels[key]+'」维修车；原命令保持，候选不代表正在维修。':'当前没有「'+repairWorkLabels[key]+'」维修车；保留原选区和待点选。'}
$('repairWorkDetails').ontoggle=()=>{if($('repairWorkDetails').open)refreshRepairWorkSnapshot()};
$('refreshRepairWork').onclick=()=>{refreshRepairWorkSnapshot();$('repairWorkStatus').textContent='已刷新检查快照；候选不代表正在维修。'};
$('selectRepairWorkReason').onclick=selectRepairWorkReason;
$('repairWorkReason').onchange=()=>{$('repairWorkStatus').textContent='';updateRepairWorkOverview()};
function repairReserveStatus(){let reserve=repairReserve(),budget=Math.floor(automaticRepairCash(0));return '全军维修车：'+(budget>0?'当前最多可用于自动维修 '+budget+' 资金':'资金不足1或已到保留额，自动维修暂缓')+'；保留 '+reserve+'，其他消费不受限。'}
function repairPriority(e){return e.repairPriority==='critical'?'critical':'nearest'}
function selectedRepairServices(){return state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.hp>0&&e.type==='repair'&&!e.build)}
function toggleRepairPriority(){if(commandBlocked())return;let services=selectedRepairServices();if(!services.length)return;let priority=services.some(e=>repairPriority(e)!=='critical')?'critical':'nearest';for(let e of services)e.repairPriority=priority;tell(priority==='critical'?'所选维修车已改为重伤优先：优先剩余生命比例最低的范围内友军':'所选维修车已改为就近维修');updateUI()}
function chooseRepairTarget(e,escort){let range=defs[e.type].repairRange;if(escort&&validEscort(e,escort)&&escort.hp<escort.max&&withinRange(e,escort,range))return escort;let critical=repairPriority(e)!=='nearest',best=null,bestRatio=Infinity,bestDistance=Infinity;for(let x of state.entities){if(x.team!==e.team||!(x.hp>0&&x.hp<x.max)||!defs[x.type].speed||x.type==='repair'||!withinRange(e,x,range))continue;let ratio=critical?x.hp/x.max:0;if(best&&ratio>bestRatio)continue;let d=dist(e,x);if(!best||ratio<bestRatio||d<bestDistance||(critical&&d===bestDistance&&x.id<best.id)){best=x;bestRatio=ratio;bestDistance=d}}return best}
function nearestRepairThreat(e,r){let best=null,bestDistance=Infinity;for(let x of state.entities){if(x.team===e.team||!(x.hp>0)||!defs[x.type].damage)continue;let dx=e.x-x.x,dy=e.y-x.y;if(!(dx<r&&dx>-r&&dy<r&&dy>-r))continue;let d=Math.hypot(dx,dy);if(d<r&&(!best||d<bestDistance)){best=x;bestDistance=d}}return best}
function repairSupport(e,dt){let d=defs[e.type],escort=get(e.escortId);if(escort&&!validEscort(e,escort))escort=null;if(e.escortId&&!escort){e.escortId=null;e.goal=null}if(!e.hold&&escort){e.target=null;e.goal=dist(e,escort)>65?{x:escort.x,y:escort.y}:null;if(e.goal)move(e,e.goal,dt,escort)}else if(!e.hold){let hostile=get(e.target);if(!hostile&&e.attackMove&&e.goal)hostile=nearestRepairThreat(e,190);if(hostile&&hostile.team!==e.team){let dx=e.x-hostile.x,dy=e.y-hostile.y,len=Math.hypot(dx,dy)||1;if(len<180||len>200){let retreat={x:clamp(hostile.x+dx/len*190,20,WIDTH-20),y:clamp(hostile.y+dy/len*190,20,HEIGHT-20)};move(e,len<180?boundaryRetreatPoint(e,hostile,retreat):retreat,dt,'repair-avoid:'+hostile.id)}}else{e.target=null;if(e.goal&&move(e,e.goal,dt))e.goal=null}}if(e.repairEnabled===false||e.cool>0)return;let cash=automaticRepairCash(e.team);if(Math.floor(cash)<1)return;let ally=chooseRepairTarget(e,escort);if(!ally)return;let heal=Math.max(0,Math.min(d.repairRate,ally.max-ally.hp,Math.floor(cash)*3));if(!heal)return;let cost=Math.ceil(heal/3);if(e.team===0)state.cash-=cost;else state.enemyCash-=cost;state.stats.spent[e.team]+=cost;ally.hp=Math.min(ally.max,ally.hp+heal);e.cool=1;pushEffect({x:e.x,y:e.y,x2:ally.x,y2:ally.y,t:.3,max:.3,type:'repair'})}
function returnSelectedCargo(){if(!state.started||state.result||restartPrompt)return;let miners=state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.type==='harvester'&&e.hp>0&&e.load>0);if(!miners.length)return tell('选中携带矿石的己方采矿车');if(!structures(0,'refinery').some(e=>!e.build))return tell('需要已建成的精炼厂交付矿石');drag=null;placement=null;attackMode=false;clearOrdinaryCommand();miners.forEach(e=>{e.manual=0;e.goal=null;e.target=null;e.returnCargo=true});tell(miners.length+' 辆采矿车返回交矿，交付后恢复原采矿安排');updateUI()}
function assignOreOrder(e,index,deliverFirst=false){navigationMemory.delete(e);e.oreIndex=index;e.manual=0;e.target=null;e.goal=null;e.returnCargo=deliverFirst&&e.load>0;e.hold=false;e.attackMove=false}
function distributeMiners(){if(commandBlocked())return;let miners=ownHarvesters().filter(e=>selection.has(e.id)).sort((a,b)=>a.id-b.id),refs=structures(0,'refinery').filter(e=>!e.build).sort((a,b)=>a.id-b.id);if(!miners.length)return tell('先选择己方矿车');if(!refs.length)return tell('分流采矿需要已建成的己方精炼厂');let walls=movementObstacles(),ores=state.ores.map((ore,index)=>({ore,index})).filter(v=>v.ore.amount>0),plans=[],clearByRadius=new Map(),pools=new Map();for(let miner of miners){let ref=nearest(miner,refs),key=ref.id+':'+miner.r;if(!clearByRadius.has(miner.r))clearByRadius.set(miner.r,ores.filter(v=>patrolPointSafe(miner,v.ore,walls)));if(!pools.has(key))pools.set(key,clearByRadius.get(miner.r).filter(v=>dist(ref,v.ore)<=400).map(v=>({index:v.index,distance:dist(ref,v.ore)})));let candidates=pools.get(key);if(candidates.length)plans.push({miner,candidates})}if(!plans.length)return tell('附近没有可分配矿点（精炼厂直线距离400内），矿车原命令保持');let reassigned=new Set(plans.map(p=>p.miner.id)),counts=Array(state.ores.length).fill(0);for(let miner of ownHarvesters()){if(reassigned.has(miner.id))continue;let ore=assignedOre(miner);if(ore?.amount>0){counts[miner.oreIndex]++;continue}if(miner.manual>0||miner.returnCargo||miner.load>=180)continue;let nearby=nearest(miner,ores.map(v=>v.ore));if(nearby&&dist(miner,nearby)<=80)counts[state.ores.indexOf(nearby)]++}for(let plan of plans){let best=null;for(let candidate of plan.candidates)if(!best||Math.floor(counts[candidate.index]/2)<Math.floor(counts[best.index]/2)||(Math.floor(counts[candidate.index]/2)===Math.floor(counts[best.index]/2)&&(candidate.distance<best.distance||(candidate.distance===best.distance&&candidate.index<best.index))))best=candidate;plan.index=best.index;counts[plan.index]++}let loaded=plans.filter(p=>p.miner.load>0).length;for(let plan of plans)assignOreOrder(plan.miner,plan.index,true);placement=null;attackMode=false;drag=null;clearOrdinaryCommand();tell('已为 '+plans.length+' 辆矿车分配 '+new Set(plans.map(p=>p.index)).size+' 处矿点'+(loaded?'；有载矿的先交矿':'')+(plans.length<miners.length?'；其余矿车保留原命令':''));updateUI()}
function assignedOre(e){return e.type==='harvester'&&Number.isInteger(e.oreIndex)?state.ores[e.oreIndex]||null:null}
function harvest(e,dt){if(e.manual>0){if(e.goal&&!movementSegmentClear(e.goal,e.goal,e.r,movementObstacles())){e.goal=null;e.target=null;e.manual=0;if(e.team===0)tell('矿车无法抵达该位置（建筑或岩石占用），已恢复自动采矿');return}if(e.goal&&!move(e,e.goal,dt))return;e.goal=null;e.target=null;e.manual=0;return}e.goal=null;if(e.oreIndex!=null&&(!assignedOre(e)||assignedOre(e).amount<=0)){e.oreIndex=null;if(e.team===0)tell('指定矿点已耗尽，矿车恢复自动选矿')}let ref=nearest(e,structures(e.team,'refinery').filter(b=>!b.build));if(!ref)return;if(e.load>=180||(e.load>0&&(e.returnCargo||!state.ores.some(o=>o.amount>0)))){if(dist(e,ref)<e.r+ref.r+35){let delivered=e.load;if(e.team===0)state.cash+=delivered;else state.enemyCash+=delivered;state.stats.income[e.team]+=delivered;state.stats.harvested[e.team]+=delivered;recordHarvesterDelivery(e,delivered);e.load=0;e.returnCargo=false;if(e.team===0)pushEffect({x:e.x,y:e.y,t:1,max:1,type:'cash',amount:delivered});return}move(e,ref,dt)}else{let ore=assignedOre(e)||nearest(e,state.ores.filter(o=>o.amount>0));if(!ore)return;if(dist(e,ore)<30){e.mine+=dt;if(e.mine>=.35){e.mine=0;let n=Math.min(15,ore.amount,180-e.load);ore.amount-=n;e.load+=n}}else move(e,ore,dt)}}
function raiseBattleAlert(message,level=1){tell(message);if(![0,1,2].includes(level))level=1;battleAlerts[level]={message,level,until:state.t+6};if(level>=1)playSound('alert')}
let strongholdResetAlert=null;
function resetObjectiveAlerts(){strongholdResetAlert=null;objectiveAlert=null;objectiveAlertSeen={control:false,stronghold:false,harvest:false}}
function objectiveRiskNotice(){if(state.objective==='stronghold'&&state.controlProgress[1]>=60&&state.controlProgress[1]<90){let p=strongholdPost(),present=p&&postPresence(p);if(p?.owner===1&&present[1]>0&&!present[0])return{kind:'stronghold',message:'敌方要点驻守已累计 '+Math.floor(state.controlProgress[1])+'/90秒；进入目标圈可暂停，赶走守军可清零'}}if(state.objective==='control'&&state.controlProgress[1]>=60&&state.controlProgress[1]<90&&state.posts.filter(p=>p.owner===1&&!p.contested&&!p.controlBlocked).length>=2)return{kind:'control',message:'敌方控点已累计 '+Math.floor(state.controlProgress[1])+'/90秒；尽快干扰控点'};if(state.objective==='harvest'&&state.stats.harvested[1]>=8000&&state.stats.harvested[1]<HARVEST_GOAL)return{kind:'harvest',message:'敌方已交付 '+Math.floor(state.stats.harvested[1])+'/'+HARVEST_GOAL+'矿石；尽快阻断交付'};return null}
function updateObjectiveAlerts(){if(!state.started||state.paused||state.result||restartPrompt)return;if(state.controlProgress[1]===0){objectiveAlertSeen.control=false;objectiveAlertSeen.stronghold=false;if(['control','stronghold'].includes(objectiveAlert?.kind))objectiveAlert=null}if(objectiveAlert&&objectiveAlert.kind!==state.objective)objectiveAlert=null;let notice=objectiveRiskNotice();if(objectiveAlert&&(!notice||objectiveAlert.kind!==notice.kind))objectiveAlert=null;if(!notice||objectiveAlertSeen[notice.kind]||[1,2].some(i=>battleAlerts[i]&&battleAlerts[i].until>state.t))return;objectiveAlert={...notice,level:0,until:state.t+6};objectiveAlertSeen[notice.kind]=true;tell(notice.message)}
function resetEconomyAlerts(){economyAlert=null;economyAlertSeen=false}
function economyRiskNotice(){if(ownHarvesters().length||!state.ores.some(o=>o.amount>0))return null;let queued=state.queue.some(q=>q.type==='harvester');return{kind:'miners',message:queued?'己方无矿车，已有矿车待产；请检查生产队列':'己方无矿车，采矿暂停；请恢复采矿队伍'}}
function updateEconomyAlerts(){if(!state.started||state.paused||state.result||restartPrompt)return;let notice=economyRiskNotice();if(!notice){resetEconomyAlerts();return}if(economyAlert)economyAlert.message=notice.message;if(economyAlertSeen||[1,2].some(i=>battleAlerts[i]&&battleAlerts[i].until>state.t)||(objectiveAlert&&objectiveAlert.until>state.t&&objectiveRiskNotice()?.kind===objectiveAlert.kind))return;economyAlert={...notice,level:0,until:state.t+6};economyAlertSeen=true;tell(notice.message)}
function resetHarvesterAlerts(){harvesterAlert=null;lastHarvesterAlert=-Infinity}
function currentHarvesterAlert(){let e=harvesterAlert&&get(harvesterAlert.id);return harvesterAlert&&harvesterAlert.until>state.t&&e&&e.team===0&&e.type==='harvester'?harvesterAlert:null}
function reportHarvesterDamage(e,team){if(!state.started||state.paused||state.result||restartPrompt||team!==1||e.team!==0||e.type!=='harvester'||e.hp<=0||state.t-lastHarvesterAlert<8)return;lastHarvesterAlert=state.t;harvesterAlert={kind:'harvester-hit',id:e.id,level:0,until:state.t+6,message:'矿车受袭（'+Math.round(e.x)+','+Math.round(e.y)+'）·载矿 '+Math.round(e.load*10)/10+'/180'};tell(harvesterAlert.message)}
function activeBattleAlert(){if(commandBlocked())return null;for(let i=2;i>=1;i--){let notice=battleAlerts[i];if(notice&&notice.until>state.t)return notice}if(objectiveAlert&&objectiveAlert.until>state.t&&objectiveRiskNotice()?.kind===objectiveAlert.kind)return objectiveAlert;let minerNotice=currentHarvesterAlert();if(minerNotice)return minerNotice;if(state.objective==='stronghold'&&strongholdResetAlert&&strongholdResetAlert.until>state.t)return strongholdResetAlert;if(economyAlert&&economyAlert.until>state.t){let risk=economyRiskNotice();if(risk)return{...economyAlert,...risk}}let notice=battleAlerts[0];return notice&&notice.until>state.t?notice:null}
function battleAlertLabel(notice){return notice.level===2?'紧急警报':notice.kind==='miners'?'经济警报':notice.kind==='harvester-hit'?'矿车警报':notice.kind?'目标警报':'战场警报'}
let battleAlertTextKey='';
function updateBattleAlertText(){let active=activeBattleAlert(),notice=active&&typeof active.message==='string'?active:null,node=$('battleAlertText'),announcer=$('battleAlertAnnouncer'),value=notice?battleAlertLabel(notice)+'：'+notice.message:'';if(node){if(node.textContent!==value)node.textContent=value;node.hidden=!notice;if(notice)node.dataset.level=String(notice.level);else delete node.dataset.level}if(!announcer){battleAlertTextKey=null;return}let key=notice?JSON.stringify([notice.level,notice.kind||'',notice.id??null,notice.message.replace(/\d+(?:\.\d+)?/g,'#')]):'';if(key!==battleAlertTextKey){battleAlertTextKey=key;announcer.textContent=value?'警报更新：'+value:''}}
function battleAlertBox(notice){ctx.save();ctx.font='14px system-ui';let box={x:16,y:16,w:clamp(ctx.measureText(notice.message).width+24,300,500),h:58};ctx.restore();return box}
function drawBattleAlert(){let notice=activeBattleAlert();if(!notice)return;let box=battleAlertBox(notice);ctx.save();ctx.fillStyle=notice.level===2?'#431d20':'#372b1b';ctx.fillRect(box.x,box.y,box.w,box.h);ctx.strokeStyle=notice.level===2?'#ff837b':'#efc777';ctx.lineWidth=2;ctx.strokeRect(box.x,box.y,box.w,box.h);ctx.textAlign='left';ctx.textBaseline='alphabetic';ctx.font='12px system-ui';ctx.fillStyle=notice.level===2?'#ffaaa0':'#efcf8d';ctx.fillText(battleAlertLabel(notice),box.x+12,box.y+19);ctx.font='14px system-ui';ctx.fillStyle='#fff0d9';ctx.fillText(notice.message,box.x+12,box.y+42,box.w-24);ctx.restore()}
function reportBaseDamage(e){if(e.team!==0||defs[e.type].speed)return;if(e.hp<=0){raiseBattleAlert('警报：'+defs[e.type].name+' 已被摧毁',2);return}if(state.t-lastBaseAlert<8)return;lastBaseAlert=state.t;raiseBattleAlert('基地遇袭：'+defs[e.type].name+' 正在受到攻击',1)}
function fire(e,target){let d=defs[e.type];e.cool=d.rate;e.angle=Math.atan2(target.y-e.y,target.x-e.x);state.shots.push({x:e.x,y:e.y,to:target.id,damage:d.damage,team:e.team,kind:e.type,life:2});pushEffect({x:e.x+Math.cos(e.angle)*23,y:e.y+Math.sin(e.angle)*23,t:.12,max:.12,type:'flash'})}
function applyShotDamage(target,damage,team,destroyedHQ){if(target.hp<=0||damage<=0)return;target.hp-=damage;if(target.hp>0&&target.hp<.001)target.hp=0;reportBaseDamage(target);reportHarvesterDamage(target,team);if(target.hp<=0){state.stats.kills[team]++;state.stats.losses[target.team]++;spawnDestructionEffects(target);if(selection.delete(target.id))selectedDeathUiDirty=true;if(target.type==='hq')destroyedHQ.add(target.team)}}
function impactShot(shot,target,destroyedHQ){let center={x:target.x,y:target.y};applyShotDamage(target,shot.damage*(shot.kind==='artillery'&&!defs[target.type].speed?1.25:shot.kind==='tank'&&target.type==='scout'?1.2:1),shot.team,destroyedHQ);pushEffect({...center,t:.3,max:.3,type:'hit'});spawnImpactSparks(center.x,center.y,shot.kind==='artillery'?27:15,target.id+Math.floor(state.t*10),shot.kind==='artillery'?6:4);let d=defs[shot.kind];if(!d?.splashRadius||shot.damage<=0)return;pushEffect({...center,t:.35,max:.35,type:'blast',radius:d.splashRadius});for(let other of state.entities){if(other.id===target.id||other.team===shot.team||other.hp<=0||!defs[other.type].speed)continue;let distance=dist(center,other);if(distance>=d.splashRadius)continue;let damage=d.splashDamage*Math.min(1,shot.damage/d.damage)*(1-distance/d.splashRadius);applyShotDamage(other,damage,shot.team,destroyedHQ)}}
function battleReportValue(value){return typeof value==='number'&&Number.isFinite(value)?String(Math.round(value*10)/10):'—'}
function clearBattleReportExport(){finishedBattleNarrative=null;$('battleReportExportStatus').textContent=''}
function battleReportText(exportedAt){let objectives={annihilation:'歼灭',control:'据点争夺',stronghold:'要点驻守',harvest:'采矿竞赛',survival:'守卫'},levels={easy:'休闲',normal:'标准',hard:'老兵'},rows=[['income','累计收入'],['spent','净支出'],['harvested','矿石交付'],['kills','击毁目标'],['losses','损失目标'],['produced','出厂车辆'],['captures','据点占领次数']];return ['赤色前线 · RED FRONT 双方战报','只读文本战报，不能作为存档载入。','导出时间：'+exportedAt,'结果：'+state.result,'结束说明：'+(finishedBattleNarrative||'—'),'游戏用时：'+Math.floor(state.t/60)+'分'+Math.floor(state.t%60)+'秒','地图：'+(mapLabels[state.mapChoice||'classic']||'未知战场'),'目标：'+(objectives[state.objective||'annihilation']||'未知'),'难度：'+(levels[state.difficulty]||'未知'),'规则：'+challengeLabel(challengeRule()),'','项目\t我方\t敌方',...rows.map(([key,label])=>label+'\t'+battleReportValue(state.stats?.[key]?.[0])+'\t'+battleReportValue(state.stats?.[key]?.[1])),'','收入含矿石交付、据点收益及建筑回收；净支出已扣取消退款。击毁与损失合计车辆及建筑，回收不算损失；出厂数不含开局车辆。据点每次易手计一次，包括首次占领和夺回。旧档缺失统计沿用读档默认值，不补算历史。',''].join('\n')}
function exportBattleReport(){if(!state.started||!state.result)return;let url=null;try{let exportedAt=new Date().toISOString(),blob=new Blob([battleReportText(exportedAt)],{type:'text/plain;charset=utf-8'});url=URL.createObjectURL(blob);let link=document.createElement('a');link.href=url;link.download='RED-FRONT-battle-report-'+exportedAt.replace(/[:.]/g,'-')+'.txt';link.click();let finishedUrl=url;setTimeout(()=>{try{URL.revokeObjectURL(finishedUrl)}catch{}},1000);url=null;$('battleReportExportStatus').textContent='已发起战报下载，请检查下载列表'}catch{try{if(url)URL.revokeObjectURL(url)}catch{}$('battleReportExportStatus').textContent='战报导出失败，请重试；战局未改变'}}
function updateBattleReport(ended){let report=$('battleReport');report.hidden=!ended;$('exportBattleReport').disabled=!ended;if(!ended)report.open=false;document.querySelectorAll('[data-report]').forEach(cell=>{let value=ended?state.stats?.[cell.dataset.report]?.[Number(cell.dataset.team)]:null;setReadonlyPanelProperty(cell,'textContent',battleReportValue(value))})}
function syncResultViewControls(){$('saveAndExportGame').disabled=!state.started||!!state.result;let ended=!!(state.started&&state.result),viewing=ended&&$('overlay').classList.contains('hidden');$('viewBattle').hidden=!ended;$('viewBattle').disabled=!ended;$('returnResult').hidden=!viewing;$('returnResult').disabled=!viewing;updateBattleReport(ended)}
function viewFinishedBattle(){if(!state.started||!state.result)return;$('overlay').classList.add('hidden');updateUI();$('returnResult').focus?.({preventScroll:true})}
function showFinishedResult(){if(!state.started||!state.result)return;invalidateCoordinatePointer();$('overlay').classList.remove('hidden');$('gameModal').scrollTop=0;$('gameModal').scrollLeft=0;updateUI();$('viewBattle').focus?.({preventScroll:true})}
function showMenu(){let ordinaryPending=ordinaryCommandMode||appendCommandMode;clearOrdinaryCommand();if(ordinaryPending)updateUI();invalidateProductionOrderRows();updateOrders();updateBattleAlertText();invalidateCoordinatePointer();clearMenuMessage();refreshSaveSlotStatus();if($('saveProblem').textContent){$('menuMessage').textContent=$('saveProblem').textContent;$('menuMessage').hidden=false}$('overlay').classList.remove('hidden');$('gameModal').scrollTop=0;$('gameModal').scrollLeft=0;syncResultViewControls()}
function finish(win,reason='hq'){if(state.result)return;trafficCoordination.clear('finish');drag=null;let draw=win===null;state.result=draw?'平局':win?'胜利':'战败';restartPrompt=false;playSound(draw?'draw':win?'win':'loss');$('cancelRestart').style.display='none';$('title').textContent=draw?'战局平局':win?(reason==='survival'?'坚守成功':'任务完成'):reason==='harvest'?'采矿竞赛失利':reason==='stronghold'?'驻守失利':reason==='control'?'据点失守':'基地失守';$('intro').textContent=reason==='survival'?(win?'守卫目标达成：指挥中心已坚持360游戏秒。':'指挥中心未能守住。'):reason==='harvest'?(draw?'双方在同一判定步运回至少10000矿石，采矿竞赛平局。':win?'采矿目标达成：矿车已实际运回至少10000矿石。':'敌军率先运回10000矿石。增加矿车并保护运输线，或攻击敌方经济阻断交矿。'):draw?'双方指挥中心在同一轮交火中被摧毁。':reason==='stronghold'?(win?'要点驻守达成：拥有目标据点并累计驻圈90有效秒。':'敌军完成要点驻守。进入目标圈可暂停计时，赶走全部守军可清零。'):reason==='control'?(win?'据点控制达成：累计有效控制时间达到90秒。':'敌军达成据点控制目标。尝试分兵夺点或打断计时。'):win?'敌军指挥中心已摧毁。赤色前线由你掌控。':(challengeRule()==='mobile'?'指挥中心被摧毁。机动作战可尝试留装甲守家、保护矿车，用维修与补员支援防线。':'指挥中心被摧毁。尝试先建炮塔、保持电力，并增援装甲部队。');$('intro').textContent+=' 用时 '+Math.floor(state.t/60)+'分'+Math.floor(state.t%60)+'秒；击毁 '+state.stats.kills[0]+'，损失 '+state.stats.losses[0]+'；总收入 '+state.stats.income[0]+'，净消费 '+state.stats.spent[0]+'。';$('intro').textContent+=' 规则：'+challengeLabel(challengeRule())+'。';finishedBattleNarrative=$('intro').textContent;$('start').textContent='再次作战';showMenu();updateBattleSaveProgress()}
function postPresence(p){let present=[0,0];for(let e of state.entities)if(e.hp>0&&defs[e.type].speed&&e.type!=='harvester'&&e.type!=='repair'&&dist(e,p)<65)present[e.team]++;return present}
function refreshPostStates(){for(let p of state.posts){let present=postPresence(p);p.contested=present[0]>0&&present[1]>0;p.controlBlocked=p.owner>=0&&present[1-p.owner]>0}}
function strategyAdviceText(){if(state.result)return'战局已结束，可重新部署并选择地图、难度或胜利条件。';if(state.objective==='control'){let enemy=state.posts.filter(p=>p.owner===1),free=enemy.filter(p=>!p.contested&&!p.controlBlocked).length,progress=state.controlProgress[1];if(enemy.length>=2&&progress>=60)return free>=2?'敌军已累计 '+Math.floor(progress)+'/90秒，派战斗车辆同时进入 '+(free-1)+' 座未受争夺的敌方据点可暂停计时。':'敌军计时已暂停在 '+Math.floor(progress)+'/90秒，再夺下 '+(enemy.length-1)+' 座敌方据点可清零。';let own=state.posts.filter(p=>p.owner===0);if(own.length>=2)return own.filter(p=>!p.contested&&!p.controlBlocked).length>=2?'己方正在控点计时，还需 '+Math.ceil(Math.max(0,90-state.controlProgress[0]))+' 秒有效控制。守住至少2座未被敌军进入的据点。':'己方控点计时暂停：将敌军赶出据点，恢复至少2座有效控点。'}let remaining=state.ores.filter(o=>o.amount>0),miners=ownHarvesters(),cargo=miners.reduce((n,e)=>n+e.load,0),refs=structures(0,'refinery').filter(e=>!e.build);if(!refs.length&&(remaining.length||cargo>0)){if(!remaining.length)return structures(0,'refinery').length?'全图无余矿，尚有载矿'+Math.round(cargo*100)/100+'。等待己方精炼厂完工后交付，无需为采矿增购矿车。':'全图无余矿，尚有载矿'+Math.round(cargo*100)/100+'但没有精炼厂。重建可交付这批载矿，请先权衡'+defs.refinery.cost+'资金建厂成本；不要为开采新矿再补矿车。';return'精炼厂缺失或未完工：矿车暂时无法交矿，优先恢复精炼厂。';}if(state.objective==='harvest'&&refs.length){let needed=HARVEST_GOAL-state.stats.harvested[0];if(needed>0&&cargo>=needed)return'距采矿目标还差约 '+Math.round(needed*100)/100+'，己方矿车已载矿约 '+Math.round(cargo*100)/100+'。现有载矿足以补足目标：按 M 选择矿车，再按 G 提前返厂，并保护交付路线。只有实际运回才计分。'}if(!powered())return challengeRule()==='mobile'?'电力不足：补电恢复生产；已有炮塔也需要供电。':'电力不足：优先补建发电站，恢复生产和炮塔。';if(remaining.length&&!miners.length)return'采矿车缺失：尽快补充，恢复基础收入。';if(!structures(0,'factory').some(e=>!e.build))return'战车工厂缺失或未完工：暂时无法增援，优先恢复工厂。';let goalNote=state.objective==='survival'?'还需守住指挥中心 '+Math.ceil(Math.max(0,SURVIVAL_GOAL-state.t))+' 游戏秒。':state.objective==='stronghold'?'驻守标记据点累计90有效秒；本方无人驻圈或失去归属就归零。':state.objective==='control'?'争夺至少两座有效据点，累计90秒。':state.objective==='harvest'?'载矿交付仍计采矿分数，据点收入不计分；也可摧毁敌方指挥中心获胜。':'可通过摧毁敌方指挥中心获胜。';if(!remaining.length)return'全图矿石已耗尽。'+(cargo>0?'运回现有载矿'+Math.round(cargo*100)/100+'。':'无需为采矿补造矿车或精炼厂。')+'据点收入仍可维持战斗。'+goalNote;if(!remaining.some(o=>refs.some(ref=>dist(o,ref)<=400)))return'所有已建成精炼厂直线400内均无余矿。矿车仍可采远矿；考虑前移精炼厂缩短运距，并保护运输线。'+goalNote;if(state.objective==='survival')return '还需守住指挥中心 '+Math.ceil(Math.max(0,SURVIVAL_GOAL-state.t))+' 游戏秒。保持电力、保护矿车，用维修和机动部队支援防线；也可摧毁敌方基地提前获胜。';if(state.objective==='harvest')return '先补到2–3辆矿车并保护运输线，避免过多车辆挤在同一矿点；必要时建设前沿精炼厂缩短运距。'+' 己方已交付 '+Math.floor(state.stats.harvested[0])+'/'+HARVEST_GOAL+'，只有矿车实际交付计分，据点收入、回收和退款不计分。';if(state.objective==='stronghold')return strongholdStatus()+'。先占领，再留战斗车在65圈内。可留车坚守，其余坦克驻点警戒、火炮分散支援；警戒车可能追击离圈，不能代替留守。双方同在暂停，本方无人归零；矿车、维修车和建筑不计驻圈。保护矿区，也可摧毁敌军指挥中心获胜。';if(state.objective==='control')return state.posts.some(p=>p.owner===0)?'再占领1座据点即可凑足两座；保持它们不被敌军进入后开始累计90秒。':'争夺模式：先分兵占领至少2座据点，并保持没有敌军进入。';if(state.posts.every(p=>p.owner!==0))return'派侦察车占领中立据点，同时保留坦克守家。';if(state.entities.filter(e=>e.team===0&&defs[e.type].damage).length<6)return'保住矿车和据点，积累装甲部队再推进。';return'坦克掩护火炮，优先打击敌军电站与精炼厂。'}
function openingPracticeProgress(){return [['harvested',180],['produced',1],['captures',1]].map(([key,limit])=>{const value=state.stats?.[key]?.[0];return Math.min(limit,Math.max(0,Number.isFinite(value)?Math.floor(value):0))})}
function updateOpeningPractice(){const [harvested,produced,captures]=openingPracticeProgress(),done=Number(harvested>=180)+Number(produced>=1)+Number(captures>=1);setReadonlyPanelProperty($('openingPracticeSummary'),'textContent','可选开局练习 · '+done+'/3');setReadonlyPanelProperty($('openingPracticeHarvest'),'textContent',(harvested>=180?'已完成：':'待完成：')+'累计实际交回矿石 '+harvested+'/180。开局矿车会自动工作；需要时可选矿车提前返厂，载货未交不计。');setReadonlyPanelProperty($('openingPracticeProduction'),'textContent',(produced>=1?'已完成：':'待完成：')+'实际生产增援 '+produced+'/1。用生产卡正常付费下单；排队未出厂不计，循环生产也计入。缺电或出口拥堵按现有提示处理。');setReadonlyPanelProperty($('openingPracticeCapture'),'textContent',(captures>=1?'已完成：':'待完成：')+'本局曾占领据点 '+captures+'/1。可单选侦察车移到中立旗帜附近，停留完成占领；保留坦克守家。之后失去据点仍记为曾完成。');setReadonlyPanelProperty($('openingPracticeStatus'),'textContent',!state.started?'尚未开战；开始后按本局累计记录显示进度。':state.result?'战局已结束；以上为本局累计记录。':done===3?'开局练习已完成，继续按本局胜利条件作战。':'按自己的节奏完成练习，仍以本局胜利条件为目标。')}
function strategyAdvice(){let advice=strategyAdviceText();if(!state.result&&state.objective==='harvest'&&state.stats.harvested[1]>=8000)return'敌军已交付 '+Math.floor(state.stats.harvested[1])+'/10000。留意其剩余载矿，阻止继续交付。 '+advice;return advice}
function snapObjectiveTime(value,goal){return value<goal&&goal-value<=1e-9?goal:value}
function postCaptureNotice(p,previousOwner){let label='据点 '+(state.posts.indexOf(p)+1)+'（'+Math.round(p.x)+','+Math.round(p.y)+'）';return p.owner===0?(previousOwner===1?'已夺取敌方':'已占领中立')+label+'：有效控制时每10秒+30资金':previousOwner===0?'警报：我方'+label+'失守，已被敌军夺取':'警报：敌军占领中立'+label}
function updatePosts(dt){for(let p of state.posts){let previousOwner=p.owner,present=postPresence(p);let contested=present[0]>0&&present[1]>0;p.contested=contested;if(!contested&&(present[0]||present[1])){let side=present[0]?0:1;if(side!==p.owner){if(p.side!==side){p.side=side;p.progress=0}p.progress=snapObjectiveTime(Math.min(8,p.progress+dt),8);if(p.progress>=8){p.owner=side;state.stats.captures[side]++;p.progress=0;p.side=-1;p.pay=0;tell(postCaptureNotice(p,previousOwner))}}else{p.progress=Math.max(0,p.progress-dt*2);if(!p.progress)p.side=-1}}else if(!contested){p.progress=Math.max(0,p.progress-dt);if(!p.progress)p.side=-1}p.controlBlocked=p.owner>=0&&present[1-p.owner]>0;if(p.owner>=0&&p.owner===previousOwner&&!p.controlBlocked){p.pay+=dt;if(p.pay>=10){let ticks=Math.floor(p.pay/10);p.pay%=10;if(p.owner===0)state.cash+=30*ticks;else state.enemyCash+=30*ticks;state.stats.income[p.owner]+=30*ticks;}}}}
function updateSurvivalGoal(){if(state.objective!=='survival'||state.result||!structures(0,'hq').length)return;state.t=snapObjectiveTime(state.t,SURVIVAL_GOAL);if(state.t>=SURVIVAL_GOAL)finish(true,'survival')}
function updateHarvestGoal(){if(state.objective!=='harvest'||state.result)return;let reached=state.stats.harvested.map(n=>n>=HARVEST_GOAL);if(reached[0]||reached[1])finish(reached[0]&&reached[1]?null:reached[0],'harvest')}
function strongholdPost(){return state.posts.reduce((best,p)=>!best||Math.hypot(p.x-WIDTH/2,p.y-HEIGHT/2)<Math.hypot(best.x-WIDTH/2,best.y-HEIGHT/2)?p:best,null)}
function strongholdStatus(){let p=strongholdPost();if(!p)return'没有驻守目标';let present=postPresence(p);return'目标（'+Math.round(p.x)+','+Math.round(p.y)+'）· 圈内战斗车 我方 '+present[0]+' / 敌方 '+present[1]+' · '+(p.owner<0?(present[0]&&present[1]?'双方争夺，占领暂停':'先完成8秒占领'):present[p.owner]===0?'归属方无人驻圈，驻守计时归零':present[1-p.owner]>0?'双方驻圈，驻守计时暂停':p.owner===0?'己方有效驻守':'敌方有效驻守')}
function reportStrongholdReset(previous,p){if(!state.started||state.paused||state.result||restartPrompt||state.objective!=='stronghold'||!Number.isFinite(previous)||previous<15)return;let message='己方驻守累计'+Math.floor(previous)+'秒已归零：'+(p.owner!==0?'目标据点已不属我方，请重新夺回并留守。':'圈内已无己方战斗车，请及时补位。');strongholdResetAlert={kind:'stronghold-reset',message,level:0,until:state.t+6};tell(message)}
function updateStrongholdGoal(dt){if(state.objective!=='stronghold'||state.result)return;let p=strongholdPost();if(!p)return;let present=postPresence(p);for(let team=0;team<2;team++){if(p.owner!==team||!present[team]){let previous=state.controlProgress[team];state.controlProgress[team]=0;if(team===0)reportStrongholdReset(previous,p)}else if(!present[1-team])state.controlProgress[team]=snapObjectiveTime(Math.min(90,state.controlProgress[team]+dt),90);if(state.controlProgress[team]>=90){finish(team===0,'stronghold');return}}}
function updateControlGoal(dt){if(state.objective!=='control'||state.result)return;for(let team=0;team<2;team++){let owned=state.posts.filter(p=>p.owner===team);if(owned.length<2)state.controlProgress[team]=0;else if(owned.filter(p=>!p.contested&&!p.controlBlocked).length>=2)state.controlProgress[team]=snapObjectiveTime(Math.min(90,state.controlProgress[team]+dt),90);if(state.controlProgress[team]>=90){finish(team===0,'control');return}}}
function enemyRebuildSites(){if(state.mapChoice==='meridian'){let points=[meridianLayout.entities.filter(e=>e[0]==='power'&&e[1]===1)[0],meridianLayout.entities.filter(e=>e[0]==='power'&&e[1]===1)[1],meridianLayout.entities.find(e=>e[0]==='refinery'&&e[1]===1),meridianLayout.entities.find(e=>e[0]==='factory'&&e[1]===1)];return points.map(([type,team,x,y],slot)=>({slot,type,x,y}))}if(state.mapChoice==='ring'){let points=[ringLayout.entities.filter(e=>e[0]==='power'&&e[1]===1)[0],ringLayout.entities.filter(e=>e[0]==='power'&&e[1]===1)[1],ringLayout.entities.find(e=>e[0]==='refinery'&&e[1]===1),ringLayout.entities.find(e=>e[0]==='factory'&&e[1]===1)];return points.map(([type,team,x,y],slot)=>({slot,type,x,y}))}return[['power',930,90],['power',1160,80],['refinery',1040,440],['factory',1100,250]].map(([type,x,y],slot)=>({slot,type,x,y:['frontier','canyon','ridge','crossroads','switchback'].includes(state.mapChoice)?clamp(y+275,defs[type].r+5,HEIGHT-defs[type].r-5):y}))}
function missingEnemySites(){return enemyRebuildSites().filter(site=>!structures(1,site.type).some(e=>dist(e,site)<=110))}
function enemyRebuildPosition(site){let points=[{x:site.x,y:site.y}];for(let radius of[25,50,75,100])for(let i=0;i<16;i++)points.push({x:site.x+Math.cos(i*Math.PI/8)*radius,y:site.y+Math.sin(i*Math.PI/8)*radius});return points.find(p=>canPlace(site.type,p,1))||null}
function updateEnemyRebuildClock(dt){let waits=state.enemyRebuildSiteWaits||(state.enemyRebuildSiteWaits=[0,0,0,0]);if(state.difficulty!=='hard'||!structures(1,'hq').length){state.enemyRebuildWait=0;waits.fill(0);return}let missing=missingEnemySites();for(let i=0;i<4;i++)waits[i]=missing.some(site=>site.slot===i)?Math.min(20,(waits[i]||0)+dt):0;state.enemyRebuildWait=missing.length?Math.min(20,(state.enemyRebuildWait||0)+dt):0}
function deferRedundantEnemyPower(){let miners=state.entities.filter(e=>e.team===1&&e.hp>0&&e.type==='harvester');if(!state.ores.some(o=>o.amount>0)&&!miners.some(e=>e.load>0))return false;if(miners.length&&structures(1,'refinery').some(e=>!e.build))return false;let buildings=structures(1),supply=20+buildings.filter(e=>e.type==='power').length*100,demand=Math.max(1,buildings.filter(e=>e.type==='factory').length)*50+Math.max(1,buildings.filter(e=>e.type==='refinery').length)*30+buildings.filter(e=>e.type==='turret').length*25;return supply>=demand}
function attemptEnemyRebuild(){if(state.difficulty!=='hard'||state.enemyRebuildWait<20||!structures(1,'hq').length)return;for(let site of missingEnemySites()){if(site.type==='power'&&deferRedundantEnemyPower())continue;if((state.enemyRebuildSiteWaits?.[site.slot]||0)<20)continue;let d=defs[site.type];if(state.enemyCash<d.cost)continue;let p=enemyRebuildPosition(site);if(!p)continue;state.enemyCash-=d.cost;state.stats.spent[1]+=d.cost;create(site.type,1,p.x,p.y,true);state.enemyRebuildWait=0;state.enemyRebuildSiteWaits[site.slot]=0;tell('敌军正在重建'+d.name+'：趁施工期间继续压制');return}}
function applyHarvestLayout(){if(state.objective!=='harvest')return;let available=state.ores.slice();for(let team=0;team<2;team++){let ref=structures(team,'refinery')[0],ore=ref&&nearest(ref,available);if(!ore)continue;ore.x=ref.x+(team?-130:130);ore.y=ref.y;available=available.filter(o=>o!==ore)}}
function chooseWavePost(e,i){if(state.objective==='stronghold')return strongholdPost();if(state.objective==='harvest')return i%2===0?nearest(e,structures(0,'refinery').filter(b=>!b.build)):null;if(state.objective==='control'){let targets=state.posts.filter(p=>p.owner!==1),posts=targets.length?targets:state.posts;return posts.length?posts[i%posts.length]:null}return i%2===0?nearest(e,state.posts.filter(p=>p.owner!==1)):null}
function defendBase(){let vital=structures(1).filter(e=>!e.build&&['hq','factory','refinery','power'].includes(e.type)),turretsPowered=powered(0),intruders=state.entities.filter(e=>e.team===0&&e.hp>0&&((defs[e.type].speed&&e.type!=='harvester')||(e.type==='turret'&&!e.build&&turretsPowered))&&vital.some(b=>dist(e,b)<270)),troops=state.entities.filter(e=>e.team===1&&e.hp>0&&defs[e.type].speed&&e.type!=='harvester');for(let e of troops)if(e.defending){e.defending=false;e.target=null}if(!intruders.length)return;let hq=structures(1,'hq')[0]||vital[0],target=nearest(hq,intruders);troops.sort((a,b)=>dist(a,target)-dist(b,target)).slice(0,difficultyRules().defenders).forEach(e=>{e.defending=true;e.target=target.id;e.attackMove=true})}
function boundaryRetreatPoint(e,enemy,back){let dx=e.x-enemy.x,dy=e.y-enemy.y,len=Math.hypot(dx,dy)||1;if(dist(e,back)>=5)return back;let walls=movementObstacles().concat(state.entities.filter(o=>o!==e&&o.hp>0&&defs[o.type].speed));for(let sign of [1,-1]){let side={x:clamp(e.x-dy/len*80*sign,20,1180),y:clamp(e.y+dx/len*80*sign,20,780)};if(dist(e,side)>5&&(side.x-e.x)*dx+(side.y-e.y)*dy>=-1e-8&&dist(side,enemy)>dist(e,enemy)&&movementSegmentClear(e,side,e.r,walls))return side}return back}
function artilleryRetreatPoint(e,enemy){let dx=e.x-enemy.x,dy=e.y-enemy.y,len=Math.hypot(dx,dy)||1,back={x:clamp(e.x+dx/len*80,20,1180),y:clamp(e.y+dy/len*80,20,780)};return boundaryRetreatPoint(e,enemy,back)}
function update(dt){if(!state.started||state.paused||state.result)return;state.t+=dt;updatePosts(dt);updateEnemyRebuildClock(dt);state.ai+=dt;state.wave+=dt;checkPatrolRoutes();checkMoveRoutes();for(let e of state.entities){if(e.hp<=0)continue;if(e.build){e.build=Math.max(0,e.build-dt);continue}e.cool=Math.max(0,e.cool-dt);let d=defs[e.type];if(e.type==='harvester'){harvest(e,dt);continue}if(e.type==='repair'){repairSupport(e,dt);continue}if(!d.damage)continue;if(e.type==='turret'&&!powered(e.team))continue;if(d.speed&&e.escortId)updateMinerEscort(e);if(e.guardArea)updateGuardArea(e);if(e.attackQueue)advanceAttackQueue(e);let enemy=get(e.target);if(!enemy){e.target=null;if(!e.guardArea&&(!e.goal||e.attackMove||e.team===1))enemy=e.type==='turret'||e.team===0&&['tank','scout','artillery'].includes(e.type)&&e.hold&&!e.goal&&!e.escortId?heldFireTarget(e):nearestEnemyInRange(e,d.range+50)}if(enemy){let range=d.range+enemy.r,enemyDistance=dist(e,enemy);if(d.minRange&&enemyDistance<d.minRange){if(e.hold)continue;move(e,artilleryRetreatPoint(e,enemy),dt,'artillery-retreat:'+enemy.id)}else if(enemyDistance<=range){if(!e.cool)fire(e,enemy)}else if(d.speed&&!e.hold)move(e,enemy,dt,enemy)}else if(e.goal&&d.speed&&!e.hold){if(move(e,e.goal,dt,e.escortId?get(e.escortId):null))arriveAtGoal(e)}}
separateUnits();
updateProduction(dt);
let interval=difficultyRules().decision;if(state.ai>=interval){state.ai=0;attemptEnemyRebuild();defendBase();let f=structures(1,'factory').find(e=>!e.build),combat=state.entities.filter(e=>e.team===1&&defs[e.type].speed&&e.hp>0);if(f&&powered(1)&&!state.enemyQueue&&combat.length<difficultyRules().armyCap){let minerCount=combat.filter(e=>e.type==='harvester').length,desiredMiners=state.objective==='harvest'?2:1,type=minerCount<desiredMiners&&structures(1,'refinery').some(e=>state.objective!=='harvest'||!e.build)?'harvester':state.aiCount%6===5&&state.enemyCash>=500&&combat.some(e=>e.type!=='repair'&&e.hp<e.max)?'repair':state.aiCount%4===3?'artillery':state.aiCount%4===1?'scout':'tank',cost=defs[type].cost;if(state.enemyCash>=cost){state.enemyCash-=cost;state.stats.spent[1]+=cost;state.enemyQueue={type,left:defs[type].time};state.aiCount++}}}if(state.enemyQueue&&powered(1)){let f=structures(1,'factory').find(e=>!e.build);if(f){state.enemyQueue.left=Math.max(0,state.enemyQueue.left-dt);if(state.enemyQueue.left<=0){let spawn=spawnPosition(f,state.enemyQueue.type,1);if(spawn){create(state.enemyQueue.type,1,spawn.x,spawn.y);state.stats.produced[1]++;state.enemyQueue=null}}}}
let waveTime=difficultyRules().wave;if(state.wave> waveTime){state.wave=0;let hq=structures(0,'hq')[0];if(hq){state.entities.filter(e=>e.team===1&&defs[e.type].speed&&e.type!=='harvester'&&e.hp>0&&!e.defending).forEach((e,i)=>{let post=chooseWavePost(e,i);e.target=null;e.goal=post?{x:post.x,y:post.y}:{x:hq.x,y:hq.y};e.attackMove=true});raiseBattleAlert('警报：敌方装甲纵队正在接近！',0)}}
let destroyedHQ=new Set();let projectileId=NaN,projectileTarget;for(let s of state.shots){s.life-=dt;let target;if(s.to===projectileId&&(!projectileTarget||projectileTarget.hp>0))target=projectileTarget;else{target=get(s.to);projectileId=s.to;projectileTarget=target}if(!target){s.life=0;continue}let d=dist(s,target);if(d<target.r+10){impactShot(s,target,destroyedHQ);s.life=0;}else{let step=Math.min(d,430*dt);s.x+=(target.x-s.x)/d*step;s.y+=(target.y-s.y)/d*step}}
if(destroyedHQ.size===2)finish(null);else if(destroyedHQ.size===1)finish(destroyedHQ.has(1));refreshPostStates();updateControlGoal(dt);updateStrongholdGoal(dt);updateHarvestGoal();updateSurvivalGoal();updateObjectiveAlerts();updateEconomyAlerts();state.shots=state.shots.filter(s=>s.life>0);state.fx.forEach(f=>f.t-=dt);state.fx=state.fx.filter(f=>f.t>0);state.entities=state.entities.filter(e=>e.hp>0);updateRepeatProduction();}
