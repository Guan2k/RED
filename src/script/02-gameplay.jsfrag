let coordinateAidEnabled=false,coordinateAidKey='',coordinateMouseBaseline=null;
function coordinateBattleVisible(){return !!(state?.started&&$('overlay').classList.contains('hidden'))}
function coordinatePointer(){return coordinateBattleVisible()&&hoverActive&&mouse!==coordinateMouseBaseline&&Number.isFinite(mouse.x)&&Number.isFinite(mouse.y)&&mouse.x>=0&&mouse.x<=WIDTH&&mouse.y>=0&&mouse.y<=HEIGHT?{x:Math.round(mouse.x),y:Math.round(mouse.y)}:null}
function updateCoordinateAid(){let visible=coordinateBattleVisible(),p=coordinateAidEnabled?coordinatePointer():null,readout=coordinateAidEnabled?(p?'地图坐标 X '+p.x+' · Y '+p.y+'（四舍五入）':'地图坐标 X — · Y —（指针移入战场）'):'100单位一格 · 左上原点 · 不吸附落点',key=[visible,coordinateAidEnabled,readout].join('|');if(key===coordinateAidKey)return;coordinateAidKey=key;$('coordinateAidBar').hidden=!visible;let button=$('coordinateAid');button.disabled=!visible;button.textContent=coordinateAidEnabled?'坐标辅助：开':'坐标辅助：关';button.setAttribute('aria-pressed',String(coordinateAidEnabled));$('coordinateReadout').textContent=readout}
function toggleCoordinateAid(){if(!coordinateBattleVisible())return;coordinateAidEnabled=!coordinateAidEnabled;updateCoordinateAid()}
function invalidateCoordinatePointer(){coordinateMouseBaseline=mouse}
function drawCoordinateGrid(){if(!coordinateAidEnabled||!coordinateBattleVisible())return;ctx.save();ctx.globalAlpha=1;ctx.lineWidth=1;ctx.setLineDash([2,5]);ctx.strokeStyle='#dce8c63d';ctx.beginPath();for(let x=100;x<WIDTH;x+=100){ctx.moveTo(x,0);ctx.lineTo(x,HEIGHT)}for(let y=100;y<HEIGHT;y+=100){ctx.moveTo(0,y);ctx.lineTo(WIDTH,y)}ctx.stroke();ctx.setLineDash([]);ctx.textAlign='left';ctx.textBaseline='alphabetic';for(let x=0;x<=WIDTH;x+=100)text(String(x),Math.min(x+4,WIDTH-34),14,'#dce8c6',11);for(let y=100;y<=HEIGHT;y+=100)text(String(y),4,Math.min(y-4,HEIGHT-6),'#dce8c6',11);ctx.restore()}
let soundContext=null,soundEnabled=false,soundPending=false,soundGeneration=0,soundVoices=new Set(),soundLast=Object.create(null);
function updateSoundButton(message=''){let b=$('soundToggle');b.textContent=soundPending?'音效：启用中（点击取消）':soundEnabled?'音效：开启':'音效：关闭';b.setAttribute('aria-pressed',String(soundEnabled));b.title=message||'离线合成短音：下令、生产完成、重要警报和终局；不播放连续炮火'}
function releaseSoundVoice(voice,stop=false){if(stop){try{voice.gain.gain.value=0}catch{}try{voice.osc.stop()}catch{}}try{voice.osc.disconnect()}catch{}try{voice.gain.disconnect()}catch{}}
function stopSoundVoices(){for(let voice of soundVoices)releaseSoundVoice(voice,true);soundVoices.clear();soundLast=Object.create(null)}
function disableSound(message=''){soundPending=false;soundEnabled=false;soundGeneration++;stopSoundVoices();updateSoundButton(message)}
async function toggleSound(){if(soundEnabled||soundPending){disableSound();return}let generation=++soundGeneration;soundPending=true;updateSoundButton();try{let Audio=window.AudioContext||window.webkitAudioContext;if(!Audio){disableSound('当前浏览器不支持音效；游戏仍可正常操作');return}if(!soundContext||soundContext.state==='closed')soundContext=new Audio();await soundContext.resume();if(generation!==soundGeneration)return;if(soundContext.state!=='running'){disableSound('音效未获浏览器启用；可再次点击尝试，游戏不受影响');return}soundPending=false;soundEnabled=true;updateSoundButton()}catch{if(generation===soundGeneration)disableSound('音效启用失败；游戏仍可正常操作')}}
function playSound(kind){if(!soundEnabled||!soundContext||soundContext.state!=='running')return;let result=['win','loss','draw'].includes(kind);if(!state?.started||restartPrompt||(!result&&(state.paused||state.result)))return;let tones={order:[520],ready:[660,880],alert:[440,330],win:[523,659,784],loss:[392,330,262],draw:[440,440]}[kind];if(!tones)return;let now=soundContext.currentTime,gap=kind==='alert'?2:kind==='order'?.12:.4;if(now-(soundLast[kind]??-Infinity)<gap)return;if(result)stopSoundVoices();if(soundVoices.size+tones.length>6)return;soundLast[kind]=now;try{for(let i=0;i<tones.length;i++){let osc=soundContext.createOscillator(),gain=soundContext.createGain(),voice={osc,gain},at=now+i*.1;soundVoices.add(voice);osc.type='triangle';osc.frequency.setValueAtTime(tones[i],at);gain.gain.setValueAtTime(0,at);gain.gain.linearRampToValueAtTime(.035,at+.012);gain.gain.linearRampToValueAtTime(0,at+.095);osc.connect(gain);gain.connect(soundContext.destination);osc.onended=()=>{soundVoices.delete(voice);releaseSoundVoice(voice)};osc.start(at);osc.stop(at+.1)}}catch{disableSound('音效播放失败，已静音；游戏仍可正常操作')}}
const MAX_EFFECTS=256,HARVEST_GOAL=10000,SURVIVAL_GOAL=360;
function pushEffect(effect){if(effect.type==='order')state.fx=state.fx.filter(e=>e.type!=='order');state.fx.push(effect);if(state.fx.length>MAX_EFFECTS)state.fx.splice(0,state.fx.length-MAX_EFFECTS)}
// Cosmetic-only battlefield effects: fixed-angle sparks never consume the gameplay RNG.
// The existing MAX_EFFECTS bound and fx lifetime update also bound all new particles.
function spawnImpactSparks(x,y,radius,seed,count){
  for(let i=0;i<count;i++){
    let angle=i*2.399963+seed*.73,reach=radius*(.6+(i%4)*.2),life=.32+(i%3)*.12;
    pushEffect({type:'spark',x,y,dx:Math.cos(angle)*reach,dy:Math.sin(angle)*reach-radius*.3,gravity:radius*.42,size:1.5+(i%3)*.55,t:life,max:life});
  }
}
function spawnDestructionEffects(target){
  let large=!defs[target.type].speed,radius=Math.max(25,target.r*(large?1.9:2.2));
  pushEffect({type:'boom',x:target.x,y:target.y,radius,t:.85,max:.85});
  spawnImpactSparks(target.x,target.y,radius*1.5,target.id,large?10:7);
  for(let i=0;i<(large?5:3);i++){
    let angle=i*2.399963+target.id*.6,life=2.3+i*.37;
    pushEffect({type:'smoke',x:target.x+Math.cos(angle)*radius*.2,y:target.y+Math.sin(angle)*radius*.13,dx:Math.cos(angle)*radius*.48,dy:-radius*(1.2+(i%3)*.24),radius:radius*(.4+(i%3)*.1),seed:i,t:life,max:life});
  }
  // A single ground decal also contains a few metallic wreck fragments. It is
  // transient, has no collision/selection footprint, and is never saved.
  pushEffect({type:'scorch',x:target.x,y:target.y,radius:radius*.83,seed:target.id,t:30,max:30});
}
function tell(s){state.logs.unshift(s);state.logs=state.logs.slice(0,4);$('log').textContent=state.logs.join('\n');$('log').style.whiteSpace='pre-line'}
function create(type,team,x,y,build=false){const d=defs[type];let o={id:uid++,type,team,x,y,hp:d.hp,max:d.hp,r:d.r,angle:0,cool:0,target:null,goal:null,attackMove:false,build:build?d.time:0,load:0,mine:0};if(type==='repair')o.repairEnabled=true;state.entities.push(o);return o}
function structures(team,type){return state.entities.filter(e=>e.hp>0&&e.team===team&&!defs[e.type].speed&&(!type||e.type===type))}
const BASE_POWER_SUPPLY=20,STATION_POWER_SUPPLY=100;
function buildingPowerDemand(type){return type==='factory'?50:type==='refinery'?30:type==='turret'?25:0}
function power(team=0){const completed=structures(team).filter(e=>!e.build);return {supply:BASE_POWER_SUPPLY+completed.filter(e=>e.type==='power').length*STATION_POWER_SUPPLY,demand:completed.reduce((s,e)=>s+buildingPowerDemand(e.type),0)}}
// Fresh read-only snapshot: one entity pass; no simulation queries or cross-refresh cache.
function electricityBreakdown(){let completed={hq:0,power:0,factory:0,refinery:0,turret:0},pending={hq:0,power:0,factory:0,refinery:0,turret:0},supply=BASE_POWER_SUPPLY,demand=0,pendingSupply=0,pendingDemand=0,pendingCount=0;for(let e of state.entities){if(!(e.hp>0)||e.team!==0||defs[e.type].speed)continue;let counts=e.build?pending:completed;counts[e.type]++;let produced=e.type==='power'?STATION_POWER_SUPPLY:0,consumed=buildingPowerDemand(e.type);if(e.build){pendingCount++;pendingSupply+=produced;pendingDemand+=consumed}else{supply+=produced;demand+=consumed}}return{completed,pending,supply,demand,margin:supply-demand,pendingSupply,pendingDemand,pendingCount,forecastSupply:supply+pendingSupply,forecastDemand:demand+pendingDemand,forecastMargin:supply+pendingSupply-demand-pendingDemand}}
function electricityBalanceText(supply,demand){return '供电 '+supply+' · 需求 '+demand+' · '+(supply>demand?'余量 '+(supply-demand):supply<demand?'缺口 '+(demand-supply):'余量 0（供需持平）')}
function electricitySnapshotLabel(){return state.result?'终局快照：模拟已结束':!state.started?'未开局：预置战场快照（菜单选项仅影响下一局）':restartPrompt?'重开菜单：当前战局暂停快照':state.paused?'暂停快照：模拟不推进':'当前战场快照'}
// Read-only panel output: compare actual DOM properties, never cached values.
function setReadonlyPanelProperty(node,key,value){if(node[key]!==value)node[key]=value}
function updateElectricityBreakdown(){let p=electricityBreakdown();setReadonlyPanelProperty($('electricityStatus'),'textContent',electricitySnapshotLabel()+'；'+electricityBalanceText(p.supply,p.demand));setReadonlyPanelProperty($('electricitySupply'),'textContent','固定基础供电 '+BASE_POWER_SUPPLY+'；'+defs.power.name+' '+p.completed.power+' 座 × '+STATION_POWER_SUPPLY+' = '+p.completed.power*STATION_POWER_SUPPLY+'；'+defs.hq.name+' '+p.completed.hq+' 座（不另增供电或需求）');setReadonlyPanelProperty($('electricityDemand'),'textContent',['factory','refinery','turret'].map(type=>defs[type].name+' '+p.completed[type]+' 座 × '+buildingPowerDemand(type)+' = '+p.completed[type]*buildingPowerDemand(type)).join('；'));setReadonlyPanelProperty($('electricityForecast'),'textContent','假设现有施工全部完成后：'+electricityBalanceText(p.forecastSupply,p.forecastDemand)+'。在建 '+p.pendingCount+' 座（'+['power','factory','refinery','turret','hq'].map(type=>defs[type].name+' '+p.pending[type]).join('、')+'），新增供电 '+p.pendingSupply+' / 需求 '+p.pendingDemand);}
function powered(team=0){let p=power(team);return p.supply>=p.demand}
function reset(){resetCoordinateConstructionFields();cancelPostSelectionActivations();postSelectionMessage="";clearSelectionRemovalChoice();selectionRemovalMessage="";resetCoordinateCommandFields();clearRepairWorkSnapshot();clearOrdinaryCommand();retireCanceledCommandActivationReferences();clearBattleReportExport();invalidateProductionOrderRows();clearMapCommandReceipt();savedBattleSignature=null;savedBattleSource=null;trafficCoordination.clear('reset');harvesterDeliveries=new WeakMap();stopSoundVoices();resetSelectionClicks();clearSaveProblem();pocketRouteBudget=2;movementIntent=new WeakSet();goalMovementIntent=new WeakSet();battleAlerts=[null,null,null];resetHarvesterAlerts();resetObjectiveAlerts();resetEconomyAlerts();hoverActive=false;simulationRemainder=0;navigationMemory=new WeakMap();lastBaseAlert=-Infinity;drag=null;uid=1;groups=[[],[],[]];selection.clear();placement=null;attackMode=false;state={entities:[],shots:[],fx:[],ores:[],posts:[{x:450,y:260,owner:-1,side:-1,progress:0,pay:0},{x:600,y:400,owner:-1,side:-1,progress:0,pay:0},{x:750,y:560,owner:-1,side:-1,progress:0,pay:0}],cash:1700,enemyCash:difficultyRules($('difficulty').value).cash,stats:{income:[0,0],spent:[0,0],kills:[0,0],losses:[0,0],produced:[0,0],captures:[0,0],harvested:[0,0]},enemyQueue:null,enemyRebuildWait:0,enemyRebuildSiteWaits:[0,0,0,0],aiCount:0,t:0,formationSpacing:36,gameSpeed:[.5,1,2].includes(Number($('gameSpeed').value))?Number($('gameSpeed').value):1,paused:false,started:false,result:null,queue:[],logs:[],ai:0,wave:0,difficulty:$('difficulty').value,challenge:$('challenge').value==='mobile'?'mobile':'standard',mapChoice:$('scenario').value||'classic',objective:$('objective').value||'annihilation',controlProgress:[0,0]};create('hq',0,140,620);create('power',0,100,735);create('refinery',0,290,640);create('factory',0,220,750);create('harvester',0,350,660);create('tank',0,320,540);create('tank',0,360,580);create('scout',0,265,505);create('hq',1,1050,125);create('factory',1,1100,250);create('power',1,930,90);create('power',1,1160,80);create('refinery',1,1040,440);create('harvester',1,980,490);create('turret',1,935,230);create('turret',1,1080,345);create('tank',1,930,300);create('tank',1,990,310);[[420,640],[190,380],[540,360],[740,540],[840,130]].forEach(([x,y])=>state.ores.push({x,y,amount:12000}));applyMapLayout();applyHarvestLayout();$('pause').textContent='暂停 [空格]';tell('左键选中部队，右键下达命令');updateUI()}
const canyonRocks=Object.freeze([{x:600,y:80,r:64},{x:600,y:200,r:64},{x:600,y:400,r:70},{x:600,y:600,r:64},{x:600,y:720,r:64}].map(o=>Object.freeze(o))),ridgeRocks=Object.freeze([{x:600,y:240,r:90},{x:600,y:560,r:90}].map(o=>Object.freeze(o))),crossroadsRocks=Object.freeze([{x:475,y:260,r:70},{x:725,y:260,r:70},{x:475,y:540,r:70},{x:725,y:540,r:70}].map(o=>Object.freeze(o))),emptyTerrain=Object.freeze([]);
const switchbackRocks=Object.freeze([{"x":470,"y":170,"r":48},{"x":470,"y":270,"r":48},{"x":470,"y":370,"r":48},{"x":470,"y":570,"r":48},{"x":470,"y":670,"r":48},{"x":730,"y":170,"r":48},{"x":730,"y":270,"r":48},{"x":730,"y":370,"r":48},{"x":730,"y":470,"r":48},{"x":730,"y":670,"r":48}].map(o=>Object.freeze(o)));
const ringLayout=Object.freeze({"entities":[["hq",0,140,400],["power",0,100,515],["refinery",0,290,420],["factory",0,220,530],["harvester",0,350,440],["tank",0,320,320],["tank",0,360,360],["scout",0,265,285],["hq",1,1060,400],["factory",1,980,530],["power",1,1100,515],["power",1,1120,200],["refinery",1,910,420],["harvester",1,850,440],["turret",1,1140,310],["turret",1,1140,470],["tank",1,880,320],["tank",1,840,360]],"ores":[[400,420],[800,420],[200,150],[1000,150],[300,690],[900,690]],"posts":[[600,130],[400,660],[800,660]]});
const ringRocks=Object.freeze([Object.freeze({x:600,y:400,r:150})]);
const meridianLayout=Object.freeze({"entities":[["hq",0,600,120],["power",0,480,80],["refinery",0,740,180],["factory",0,400,200],["harvester",0,800,200],["tank",0,550,250],["tank",0,650,250],["scout",0,540,300],["hq",1,600,680],["factory",1,800,600],["power",1,720,720],["power",1,900,740],["refinery",1,460,620],["harvester",1,400,600],["turret",1,500,740],["turret",1,600,760],["tank",1,650,550],["tank",1,550,550]],"ores":[[870,180],[330,620],[600,280],[600,520],[180,90],[1020,710]],"posts":[[600,400],[160,400],[1040,400]]});
const meridianRocks=Object.freeze([{"x":380,"y":400,"r":100},{"x":820,"y":400,"r":100},{"x":160,"y":220,"r":50},{"x":1040,"y":580,"r":50}].map(Object.freeze));
function terrainObstacles(map=state?.mapChoice){return map==='meridian'?meridianRocks:map==='ring'?ringRocks:map==='canyon'?canyonRocks:map==='ridge'?ridgeRocks:map==='crossroads'?crossroadsRocks:map==='switchback'?switchbackRocks:emptyTerrain}
function movementObstacles(){return state.entities.filter(e=>e.hp>0&&!defs[e.type].speed).concat(terrainObstacles())}
// Production and selection inspect the same ordered search. The normal path
// retains static short-circuiting, unit every(), and the first-open early return.
function factorySpawnSearch(factory,type,team,inspect=false){let preferred=team?{x:factory.x-50,y:factory.y+60}:{x:clamp(factory.x+55,20,1180),y:clamp(factory.y-55,20,780)};let r=defs[type].r,walls=movementObstacles(),units=state.entities.filter(e=>e.hp>0&&defs[e.type].speed&&Math.abs(e.x-factory.x)<=200+r+e.r+3&&Math.abs(e.y-factory.y)<=200+r+e.r+3),outside=walls.filter(b=>b.id!==factory.id),result=inspect?{open:null,candidate:null,staticCount:0}:null,index=0,valid=p=>{let current=index++;if(!(p.x>=r&&p.x<=WIDTH-r&&p.y>=r&&p.y<=HEIGHT-r&&movementSegmentClear(p,p,r,walls)&&movementSegmentClear(factory,p,r,outside)))return false;let clear=e=>dist(p,e)>=r+e.r+3;if(!inspect)return units.every(clear);result.staticCount++;let occupants=units.filter(e=>!clear(e));if(!occupants.length){result.open=p;result.candidate=null;return true}if(!result.candidate&&occupants.every(e=>e.team===team))result.candidate={index:current,point:p,ids:occupants.map(e=>e.id)};return false};if(valid(preferred))return inspect?result:preferred;let angle=Math.atan2(preferred.y-factory.y,preferred.x-factory.x);for(let radius of [factory.r+r+8,80,110,150,200])for(let i=0;i<32;i++){let a=angle+(i%2?1:-1)*Math.ceil(i/2)*Math.PI/16,p={x:factory.x+Math.cos(a)*radius,y:factory.y+Math.sin(a)*radius};if(valid(p))return inspect?result:p}return inspect?result:null}
function spawnPosition(factory,type,team){return factorySpawnSearch(factory,type,team)}
function drawRocks(){for(let o of terrainObstacles()){ctx.save();ctx.translate(o.x,o.y);ctx.fillStyle='#282b29';ctx.strokeStyle='#817e6d';ctx.lineWidth=2;ctx.beginPath();for(let i=0;i<8;i++){let a=i*Math.PI/4,r=o.r*(i%2?.9:1),x=Math.cos(a)*r,y=Math.sin(a)*r;i?ctx.lineTo(x,y):ctx.moveTo(x,y)}ctx.closePath();ctx.fill();ctx.stroke();ctx.fillStyle='#5c5e53';ctx.beginPath();ctx.moveTo(-o.r*.55,-o.r*.38);ctx.lineTo(o.r*.18,-o.r*.6);ctx.lineTo(o.r*.62,o.r*.05);ctx.lineTo(-o.r*.05,o.r*.48);ctx.closePath();ctx.fill();ctx.strokeStyle='#97917b';ctx.beginPath();ctx.moveTo(-o.r*.55,-o.r*.38);ctx.lineTo(o.r*.18,-o.r*.6);ctx.lineTo(o.r*.62,o.r*.05);ctx.stroke();ctx.restore()}}
function applyMapLayout(){if(state.mapChoice==='meridian'){let used=new Set();for(let [type,team,x,y]of meridianLayout.entities){let e=state.entities.find(e=>e.type===type&&e.team===team&&!used.has(e.id));if(e){e.x=x;e.y=y;used.add(e.id)}}state.ores=meridianLayout.ores.map(([x,y])=>({x,y,amount:12000}));state.posts=meridianLayout.posts.map(([x,y])=>({x,y,owner:-1,side:-1,progress:0,pay:0}));return}if(state.mapChoice==='ring'){let used=new Set();for(let [type,team,x,y]of ringLayout.entities){let e=state.entities.find(e=>e.type===type&&e.team===team&&!used.has(e.id));if(e){e.x=x;e.y=y;used.add(e.id)}}state.ores=ringLayout.ores.map(([x,y])=>({x,y,amount:12000}));state.posts=ringLayout.posts.map(([x,y])=>({x,y,owner:-1,side:-1,progress:0,pay:0}));return}if(!['frontier','canyon','ridge','crossroads','switchback'].includes(state.mapChoice))return;for(let e of state.entities)e.y=clamp(e.y+(e.team===0?-220:275),e.r+5,HEIGHT-e.r-5);state.ores=[[400,410],[160,160],[600,380],[830,680],[900,740]].map(([x,y])=>({x,y,amount:12000}));state.posts=[{x:420,y:180,owner:-1,side:-1,progress:0,pay:0},{x:600,y:400,owner:-1,side:-1,progress:0,pay:0},{x:780,y:630,owner:-1,side:-1,progress:0,pay:0}];if(state.mapChoice==='canyon'){state.ores=[[400,410],[180,170],[380,680],[800,400],[1020,150],[940,730]].map(([x,y])=>({x,y,amount:12000}));state.posts=[{x:450,y:300,owner:-1,side:-1,progress:0,pay:0},{x:750,y:300,owner:-1,side:-1,progress:0,pay:0},{x:600,y:500,owner:-1,side:-1,progress:0,pay:0}]}if(state.mapChoice==='ridge'||state.mapChoice==='crossroads'){state.ores=[[420,420],[200,140],[400,660],[800,420],[1000,140],[910,715]].map(([x,y])=>({x,y,amount:12000}));state.posts=(state.mapChoice==='crossroads'?[120,400,680]:[60,400,740]).map(y=>({x:600,y,owner:-1,side:-1,progress:0,pay:0}))}if(state.mapChoice==='switchback'){state.ores=[[400,420],[800,420],[300,160],[900,160],[300,680],[900,680]].map(([x,y])=>({x,y,amount:12000}));state.posts=[[600,180],[600,500],[600,660]].map(([x,y])=>({x,y,owner:-1,side:-1,progress:0,pay:0}))}};
function focusBattleTransition(id){if(document.hidden)return;let menu=!$('overlay').classList.contains('hidden');if(id==='title'?!(menu&&restartPrompt):id!=='map'||menu||restartPrompt||!state.started||state.result)return;let node=$(id);if(!node||!node.isConnected||node.disabled)return;for(let p=node;p;p=p.parentNode){if(p.hidden||p.style?.display==='none'||p.style?.visibility==='hidden'||p.classList?.contains('hidden'))return}if(node.getClientRects&&!node.getClientRects().length)return;node.focus?.({preventScroll:true})}
function start(){clearImportReadReceipt();restartPrompt=false;$('cancelRestart').style.display='none';reset();state.started=true;$('overlay').classList.add('hidden');last=0;updateUI();updateBattleSaveProgress();focusBattleTransition('map')}
function assignFactories(){let factories=structures(0,'factory').filter(e=>!e.build),valid=new Set(factories.map(e=>e.id)),used=new Set();for(let q of state.queue){if(valid.has(q.factoryId)&&!used.has(q.factoryId))used.add(q.factoryId);else q.factoryId=null}for(let q of state.queue)if(!q.factoryId){let factory=factories.find(e=>!used.has(e.id));if(factory){q.factoryId=factory.id;used.add(factory.id)}}}
const RALLY_SPREAD_RADIUS=144;
function nearbyRallyGoal(produced,center){let radius=Math.max(16,produced.r),walls=movementObstacles(),reservations=[],reserve=(p,r,margin)=>{if(dist(p,center)<=RALLY_SPREAD_RADIUS+radius+r+3+margin)reservations.push({x:p.x,y:p.y,r,margin})};for(let e of state.entities){if(e===produced||e.hp<=0||!defs[e.type].speed)continue;reserve(e,e.r,5);if(e.team!==produced.team)continue;if(e.guardArea)reserve(e.guardArea,e.r,10);else if(e.goal&&!e.patrol&&!e.escortId&&!e.hold)reserve(e.goal,e.r,5+clamp(e.arrivalRadius||5,5,20))}let candidates=[];for(let dx=-3;dx<=3;dx++)for(let dy=-3;dy<=3;dy++)if(dx*dx+dy*dy<=9)candidates.push({x:center.x+dx*48,y:center.y+dy*48,offset:dx*dx+dy*dy});candidates.sort((a,b)=>a.offset-b.offset||dist(produced,a)-dist(produced,b)||a.y-b.y||a.x-b.x);for(let p of candidates)if(p.x>=radius&&p.x<=WIDTH-radius&&p.y>=radius&&p.y<=HEIGHT-radius&&movementSegmentClear(p,p,radius,walls)&&reservations.every(o=>dist(p,o)>=radius+o.r+3+o.margin))return{x:p.x,y:p.y};return null}
function applyFactoryRally(produced,factory){if(!factory.rally)return '';let center=groundGoal({r:16},factory.rally);if(!center)return 'blocked';let changed=center.x!==factory.rally.x||center.y!==factory.rally.y;if(changed)factory.rally={...center};let goal=nearbyRallyGoal(produced,center),crowded=!goal;if(!goal)goal=center;let spread=goal.x!==center.x||goal.y!==center.y;produced.goal={...goal};let hold=factory.team===0&&factory.rallyHold===true&&produced.team===0&&['tank','scout','artillery'].includes(produced.type);produced.attackMove=!hold;if(hold)produced.holdOnArrival=true;produced.arrivalRadius=5;if(produced.type==='harvester')produced.manual=10;return changed?(crowded?'adjusted_crowded':spread?'adjusted_spread':'adjusted'):crowded?'crowded':spread?'spread':''}
function selectedRallyFactories(){return state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.hp>0&&e.type==='factory')}
function selectedRallyHoldFactories(){return selectedRallyFactories().filter(e=>!e.build&&e.rally)}
function toggleFactoryRallyHold(){if(commandBlocked())return;let factories=selectedRallyHoldFactories();if(!factories.length){updateUI();return}let enable=factories.some(e=>e.rallyHold!==true);for(let e of factories){if(enable)e.rallyHold=true;else delete e.rallyHold}tell(enable?'已为 '+factories.length+' 座工厂设置新战车抵达后坚守；已出厂车辆不变':'已恢复 '+factories.length+' 座工厂新战车的攻击移动集结；已出厂车辆不变');updateUI()}
function clearSelectedRallies(){if(commandBlocked())return;let factories=selectedRallyFactories().filter(e=>e.rally);if(!factories.length){updateUI();return}for(let e of factories){delete e.rally;delete e.rallyHold}tell('已清除 '+factories.length+' 座工厂的集结点；已出厂车辆与生产订单不变');updateUI()}
function drawFactoryRallies(){let selected=state.entities.filter(e=>selection.has(e.id)&&e.hp>0),factories=selected.filter(e=>e.team===0&&e.type==='factory'&&e.rally);if(!factories.length)return;ctx.save();ctx.lineWidth=1.2;ctx.strokeStyle='#eed38c';for(let e of factories){ctx.setLineDash([3,6]);ctx.beginPath();ctx.moveTo(e.x,e.y);ctx.lineTo(e.rally.x,e.rally.y);ctx.stroke();if(selected.length<=6){ctx.setLineDash([4,9]);ctx.beginPath();ctx.arc(e.rally.x,e.rally.y,RALLY_SPREAD_RADIUS,0,Math.PI*2);ctx.stroke();text('集结分配范围',clamp(e.rally.x+20,8,WIDTH-100),clamp(e.rally.y-30,16,HEIGHT-12),'#eed38c',11)}ctx.setLineDash([]);rect(e.rally.x,e.rally.y-22,2,22,'#ead696');rect(e.rally.x+2,e.rally.y-22,16,9,'#e0b869')}ctx.restore()}
function rallyCompletionNote(status){if(status==='blocked')return'；集结点暂不可用，本次新车使用默认行为';let note=status.startsWith('adjusted')?'；集结点已调整到附近安全位置':'';if(status==='spread'||status==='adjusted_spread')note+='；新车分散到集结中心附近空位';if(status==='crowded'||status==='adjusted_crowded')note+='；集结区域拥挤，本次仍向安全中心集结';return note}
function updateProduction(dt){assignFactories();if(!powered())return;let completed=new Set();for(let q of state.queue){let factory=get(q.factoryId);if(!factory)continue;q.left-=dt;if(q.left<=0){let spawn=spawnPosition(factory,q.type,0);if(!spawn){q.left=0;q.waitingForExit=true;continue}let produced=create(q.type,0,spawn.x,spawn.y),rallyStatus=applyFactoryRally(produced,factory);state.stats.produced[0]++;tell(defs[q.type].name+' 已就绪'+rallyCompletionNote(rallyStatus)+(produced.holdOnArrival?'；抵达后坚守':''));completed.add(q)}}if(completed.size){state.queue=state.queue.filter(q=>!completed.has(q));assignFactories();playSound('ready')}}
function commandBlocked(){return !state.started||!!state.result||restartPrompt}
const PRODUCTION_SHORTCUTS=Object.freeze({'4':'tank','5':'scout','6':'artillery','7':'repair','8':'harvester'});
function productionFactoryRequirementReason(){return structures(0,'factory').some(e=>e.build)?state.paused?'战车工厂施工中；当前暂停，请继续游戏以推进施工':'战车工厂施工中，完工后才能下新订单':'需要已建成的战车工厂'}
function productionPurchaseReason(type){if(!state.started)return '尚未开始作战';if(state.result)return '战局已结束';if(restartPrompt)return '请先完成或取消重新部署确认';if(state.queue.length>=8)return '生产队列已满（8）';if(!structures(0,'factory').some(e=>!e.build))return productionFactoryRequirementReason();if(state.cash<defs[type].cost)return '资金不足，还差 '+Math.ceil(defs[type].cost-state.cash)+'资金';return ''}
function buy(type){if(commandBlocked())return;let d=defs[type];if(state.queue.length>=8)return tell('生产队列已满（8）');if(!structures(0,'factory').some(e=>!e.build))return tell(productionFactoryRequirementReason());if(state.cash<d.cost)return tell(d.name+'新订单资金不足，还差 '+Math.ceil(d.cost-state.cash)+'资金'+(state.queue.length?'；已付订单保留':''));state.cash-=d.cost;state.stats.spent[0]+=d.cost;state.queue.push({type,left:d.time,total:d.time});assignFactories();tell(d.name+' 已加入生产队列');updateUI()}
function factoryRepeatType(e){return e&&['tank','scout','artillery','repair','harvester'].includes(e.factoryRepeatType)?e.factoryRepeatType:'off'}
function factoryRepeatTarget(e){return [1,2,3,5,10,20].includes(e?.factoryRepeatTarget)?e.factoryRepeatTarget:0}
function effectiveFactoryRepeatTarget(e){let own=factoryRepeatTarget(e),global=repeatProductionTarget();return own&&global?Math.min(own,global):own||global}
function factoryRepeatTargetReached(e,inventory){let target=effectiveFactoryRepeatTarget(e);if(!target)return false;let type=factoryRepeatType(e),total=inventory?.get(type);if(total===undefined){total=repeatProductionInventory(type).total;inventory?.set(type,total)}return total>=target}
function selectedFactoryRepeatTargets(){return selectedRallyFactories().filter(e=>!e.build&&factoryRepeatType(e)!=='off')}
function changeFactoryRepeatTarget(value){if(commandBlocked())return;if(![0,1,2,3,5,10,20].includes(value)){updateUI();return}let factories=selectedFactoryRepeatTargets();if(!factories.length){updateUI();return}for(let e of factories){if(value===0)delete e.factoryRepeatTarget;else e.factoryRepeatTarget=value}tell('所选循环工厂补单目标：'+(value||'沿用全局')+'；按全军同车型与已付订单计数，不取消订单，不突破全局上限');updateUI()}
function configuredRepeatFactories(){return structures(0,'factory').filter(e=>!e.build&&factoryRepeatType(e)!=='off')}
function changeFactoryRepeat(type){if(commandBlocked())return;if(!['off','tank','scout','artillery','repair','harvester'].includes(type)){updateUI();return}let factories=selectedRallyFactories().filter(e=>!e.build);if(!factories.length){updateUI();return}for(let e of factories){if(factoryRepeatType(e)===type)continue;delete e.factoryRepeatTarget;for(let q of state.queue)if(q.factoryRepeatSource===e.id)delete q.factoryRepeatSource;if(type==='off')delete e.factoryRepeatType;else e.factoryRepeatType=type}if(type!=='off')delete state.repeatProduction;tell(type==='off'?'已关闭所选 '+factories.length+' 座工厂的未来循环补单；已付订单保留':'所选 '+factories.length+' 座工厂循环生产 '+defs[type].name+'；全局循环已关闭，已付订单保留');updateUI()}
function factoryRepeatStatus(e){let type=factoryRepeatType(e);if(type==='off')return'本厂循环：关闭';let limit=effectiveFactoryRepeatTarget(e),prefix='本厂循环 '+defs[type].name+'（全军同型含订单 '+repeatProductionInventory(type).total+' / '+(limit||'不限')+'）：';if(commandBlocked())return prefix+'战局未运行或菜单中';if(state.paused)return prefix+'游戏暂停';if(!powered())return prefix+'缺电暂停';let q=state.queue.find(q=>q.factoryId===e.id);if(q)return prefix+'等待本厂已付订单完成';if(state.queue.length>=8)return prefix+'队列已满';if(factoryRepeatTargetReached(e))return prefix+'本厂补单目标已满足';if(state.cash<defs[type].cost+repeatProductionReserve())return prefix+'等待资金 '+(defs[type].cost+repeatProductionReserve());return prefix+'空闲时轮流按正常费用补单'}
function updateFactoryRepeatProduction(){let factories=configuredRepeatFactories();if(!factories.length)return false;if(state.paused||commandBlocked()||!powered()||state.queue.length>=8)return true;assignFactories();let cursor=state.factoryRepeatCursor||0,inventory=new Map();factories.sort((a,b)=>a.id-b.id);let ordered=[...factories.filter(e=>e.id>cursor),...factories.filter(e=>e.id<=cursor)];for(let e of ordered){let type=factoryRepeatType(e),d=defs[type];if(state.queue.some(q=>q.factoryId===e.id)||factoryRepeatTargetReached(e,inventory)||state.cash<d.cost+repeatProductionReserve())continue;state.cash-=d.cost;state.stats.spent[0]+=d.cost;state.queue.push({type,left:d.time,total:d.time,factoryId:e.id,factoryRepeatSource:e.id});state.factoryRepeatCursor=e.id;tell(d.name+' 已加入本厂循环队列（正常扣款 '+d.cost+'）');updateUI();break}return true}
function repeatProductionTarget(){return [0,5,10,20].includes(state.repeatTarget)?state.repeatTarget:0}
function repeatProductionInventory(type){let live=state.entities.filter(e=>e.team===0&&e.hp>0&&e.type===type).length,queued=state.queue.filter(q=>q.type===type).length;return{live,queued,total:live+queued}}
function changeRepeatTarget(amount){if(commandBlocked())return;if(![0,5,10,20].includes(amount)){updateUI();return}if(amount===repeatProductionTarget())return;if(amount===0)delete state.repeatTarget;else state.repeatTarget=amount;tell('循环车型数量目标：'+(amount||'不限')+'；含该车型存活车辆与已付订单，手动下单和已付订单不受限');updateUI()}
function repeatTargetReached(type){let target=repeatProductionTarget();return target>0&&repeatProductionInventory(type).total>=target}
function repeatProductionReserve(){return [0,300,650,1000].includes(state.repeatReserve)?state.repeatReserve:0}
function changeRepeatReserve(amount){if(commandBlocked())return;if(![0,300,650,1000].includes(amount)){updateUI();return}if(amount===repeatProductionReserve())return;if(amount===0)delete state.repeatReserve;else state.repeatReserve=amount;tell('循环补单保留资金：'+amount+'；仅约束新循环订单，其他消费照常');updateUI()}
function repeatProductionParallel(){return state.repeatParallel===true}
function changeRepeatParallel(enabled){if(commandBlocked())return;if(typeof enabled!=='boolean'){updateUI();return}if(enabled===repeatProductionParallel())return;state.repeatParallel=enabled;tell(enabled?'全局循环补单方式设为按空闲工厂并行；每个模拟步最多一单，正常扣款；本厂独立循环不受影响':'全局循环补单方式设为单订单；已有付费订单保留；本厂独立循环不受影响');updateUI()}
function repeatProductionSlots(){return Math.max(0,structures(0,'factory').filter(e=>!e.build).length-state.queue.length)}
function repeatProductionType(){return ['tank','scout','artillery','repair','harvester'].includes(state.repeatProduction)?state.repeatProduction:'off'}
function changeRepeatProduction(type){if(commandBlocked())return;if(!['off','tank','scout','artillery','repair','harvester'].includes(type)){updateUI();return}if(type===repeatProductionType()&&!(type!=='off'&&configuredRepeatFactories().length))return;if(type!=='off'){for(let e of structures(0,'factory')){delete e.factoryRepeatType;delete e.factoryRepeatTarget}for(let q of state.queue)delete q.factoryRepeatSource}if(type==='off')delete state.repeatProduction;else state.repeatProduction=type;tell(type==='off'?'循环排产已关闭，已支付订单保留':'全局循环排产：'+defs[type].name+'；本厂循环已关闭，已付订单保留');updateUI()}
function factoryRepeatProductionReason(factories){let reserve=repeatProductionReserve(),prefix='本厂独立循环：'+factories.length+' 厂 · 共用保留资金 '+reserve+' / 全局每车型目标 '+(repeatProductionTarget()||'不限（仍受本厂目标限制）')+'；全局循环关闭。';if(!state.started||state.result)return prefix+'战局未运行，暂停补单';if(restartPrompt)return prefix+'菜单中暂停补单';if(state.paused)return prefix+'游戏暂停，恢复后检查';if(!powered())return prefix+'缺电，暂停自动下单';let counts=new Map(),inventory=new Map();for(let e of factories){let type=factoryRepeatType(e),cost=defs[type].cost,reason=state.queue.some(q=>q.factoryId===e.id)?'等待本厂已付订单':state.queue.length>=8?'队列已满':factoryRepeatTargetReached(e,inventory)?'目标已满足':state.cash<cost+reserve?'等待资金 '+(cost+reserve)+'（单价 '+cost+' + 保留 '+reserve+'）':'待模拟步检查';counts.set(reason,(counts.get(reason)||0)+1)}return prefix+[...counts].map(([reason,count])=>reason+' '+count+'厂').join(' / ')+'；每步最多补一单，先分配已有订单，不保证下步购买'}
function repeatProductionReason(){let configured=configuredRepeatFactories();if(configured.length)return factoryRepeatProductionReason(configured);let type=repeatProductionType(),pending=state.queue.find(q=>q.repeatOrder===true),parallel=repeatProductionParallel(),paid=state.queue.filter(q=>q.repeatOrder===true);if(type==='off')return pending?'循环关闭 · 已支付的'+defs[pending.type].name+'订单保留':'循环排产：关闭';let target=repeatProductionTarget(),inventory=target?repeatProductionInventory(type):null,name='循环 '+defs[type].name+(parallel?' · 空闲工厂并行':'')+(target?'（'+inventory.live+'辆 + '+inventory.queued+'单 / 目标 '+target+'）':'')+'：';if(!state.started||state.result)return name+'战局未运行';if(restartPrompt)return name+'菜单中暂停补单';if(state.paused)return name+'游戏暂停，恢复后检查';if(pending&&!parallel)return name+'已有循环订单 '+defs[pending.type].name+' · '+productionStateLabel(pending);if(parallel&&paid.some(q=>q.type!==type))return name+'等待旧车型循环订单完成；已付循环 '+paid.length+' 单';if(target&&inventory.total>=target)return name+'目标已满足，暂停补单；数量减少后再检查';if(!structures(0,'factory').some(e=>!e.build))return name+'等待已建成工厂';if(!powered())return name+'缺电，暂停自动下单';if(state.queue.length>=8)return name+'等待队列空位';if(parallel&&!repeatProductionSlots())return name+'所有已建成工厂已有订单，等待空闲；已付循环 '+paid.length+' 单';let reserve=repeatProductionReserve(),needed=defs[type].cost+reserve;if(state.cash<needed)return name+'等待资金 '+needed+(reserve?'（单价 '+defs[type].cost+' + 保留 '+reserve+'）':'');return name+'下个模拟步正常扣款 '+defs[type].cost+(reserve?'，扣后至少保留 '+reserve:'')}
function updateRepeatProduction(){if(updateFactoryRepeatProduction())return;let type=repeatProductionType();if(type==='off'||state.paused||commandBlocked()||repeatTargetReached(type)||(repeatProductionParallel()?state.queue.some(q=>q.repeatOrder===true&&q.type!==type)||!repeatProductionSlots():state.queue.some(q=>q.repeatOrder===true))||state.queue.length>=8||!structures(0,'factory').some(e=>!e.build)||!powered()||state.cash<defs[type].cost+repeatProductionReserve())return;let count=state.queue.length;buy(type);if(state.queue.length===count+1){state.queue[state.queue.length-1].repeatOrder=true;updateUI()}}
function productionRefund(q){return Math.floor(defs[q.type].cost*clamp(q.left/q.total,0,1)+1e-8)}
function cancelProduction(q){if(!state.started||state.result||restartPrompt)return;let i=state.queue.indexOf(q);if(i<0)return;let refund=productionRefund(q);if(q.repeatOrder===true)delete state.repeatProduction;if(q.factoryRepeatSource){let source=get(q.factoryRepeatSource);if(source&&source.team===0&&source.type==='factory'){delete source.factoryRepeatType;delete source.factoryRepeatTarget}}state.queue.splice(i,1);assignFactories();state.cash+=refund;state.stats.spent[0]=Math.max(0,state.stats.spent[0]-refund);tell(defs[q.type].name+' 已取消，退回 '+refund+' 资金'+(q.repeatOrder===true?'；循环排产已关闭':q.factoryRepeatSource?'；来源工厂循环已关闭（若仍存在）':''));updateUI()}
function activeProductionFactory(q){let factory=get(q.factoryId);return factory&&factory.team===0&&factory.type==='factory'&&!factory.build?factory:null}
function prioritizeProduction(q){if(commandBlocked())return;let index=state.queue.indexOf(q);if(index<0)return;if(activeProductionFactory(q)){tell('该订单已分配工厂，不能插队抢占；普通点击仍可取消');return}let first=state.queue.findIndex(order=>!activeProductionFactory(order));if(index===first){tell('该订单已在等待队列首位');return}state.queue.splice(index,1);state.queue.splice(first,0,q);assignFactories();tell(defs[q.type].name+' 已移到等待首位，保留原费用与生产进度');updateUI()}
function productionWaitingReason(){let factories=structures(0,'factory'),complete=factories.filter(e=>!e.build),busy=new Set(state.queue.filter(order=>activeProductionFactory(order)).map(order=>order.factoryId)),reason=!factories.length?'没有存活工厂，请建造工厂':!complete.length?'工厂建设中，等待完工':complete.every(e=>busy.has(e.id))?'已完工工厂均占用，等待空闲':'等待分配可用工厂';return' · '+reason+'；已付费用及已有进度保留'}
function productionWaitingExplanation(q,readWaitingReason=productionWaitingReason){if(!state.started||state.result||!state.queue.includes(q)||activeProductionFactory(q))return'';return readWaitingReason()}
function productionStateLabel(q,readPower=powered){if(state.result)return'已结束';return activeProductionFactory(q)?state.paused?'游戏暂停':!readPower()?'缺电暂停':q.waitingForExit?'等待出口':'生产中':'排队'}
const IDLE_FACTORY_SELECTION_HINT='空闲指存活、已完工且当前未绑定已付订单的己方工厂；未分配订单之后仍可能分配，不保证持续空闲或自动购买。仅选择，不改变订单、资金、循环或集结设置。';
function idleProductionFactories(){let busy=new Set(state.queue.map(q=>q.factoryId));return structures(0,'factory').filter(e=>!e.build&&!busy.has(e.id))}
function idleFactorySelectionReason(){return commandBlocked()?'当前不能选择：尚未开始、重新部署确认或战局结束':!structures(0,'hq').length?'己方指挥中心已不存在，不能选择':''}
function productionCapacitySummary(){if(!state.started)return'工厂概览：尚未开局';let factories=structures(0,'factory').filter(e=>!e.build),valid=new Set(factories.map(e=>e.id)),occupied=new Set(),waiting=0;for(let q of state.queue){if(valid.has(q.factoryId)&&!occupied.has(q.factoryId))occupied.add(q.factoryId);else waiting++}let status=state.result?'战局已结束，仅显示终局快照':restartPrompt?'重开菜单中，生产暂停':state.paused?'游戏暂停':!powered()?'缺电，生产暂停':'当前分配快照';return'己方已完工工厂 '+factories.length+' 座 · 占用 '+occupied.size+' / 空闲 '+(factories.length-occupied.size)+'；已付订单待分配工厂 '+waiting+' 单。'+status+'。占用含暂停及等待出口；空闲仅指未绑定订单，不保证后续空闲或出厂时间。'}
let invalidateAllFactorySelectionActivation=()=>{};
function allCompletedFactories(){return structures(0,'factory').filter(e=>!e.build)}
function updateAllFactorySelection(){invalidateAllFactorySelectionActivation();let count=allCompletedFactories().length,button=$('selectAllFactories');setReadonlyPanelProperty(button,'textContent','选择全部已完工工厂 · '+count);setReadonlyPanelProperty(button,'disabled',commandBlocked()||!count)}
function selectAllFactories(){if(commandBlocked())return;let factories=allCompletedFactories();if(!factories.length)return;resetSelectionClicks();selection=new Set(factories.map(e=>e.id));placement=null;attackMode=false;drag=null;clearOrdinaryCommand();updateUI()}
function updateIdleFactorySelection(){let count=idleProductionFactories().length,reason=idleFactorySelectionReason(),button=$('selectIdleFactories');button.textContent='选空闲工厂 · '+count;button.disabled=!!reason||!count;button.title=(reason?reason+'；':!count?'当前没有符合条件的工厂；':'选择全部 '+count+' 座；')+IDLE_FACTORY_SELECTION_HINT}
function selectIdleFactories(){if(idleFactorySelectionReason())return;let factories=idleProductionFactories();if(!factories.length){tell('当前没有空闲工厂，保留原选择；未分配订单之后仍可能分配');updateUI();return}resetSelectionClicks();selection=new Set(factories.map(e=>e.id));placement=null;attackMode=false;drag=null;clearOrdinaryCommand();tell('已选择 '+factories.length+' 座空闲工厂（当前无已绑定已付订单）；未分配订单之后仍可能分配，不保证持续空闲或自动购买；循环、集结和原命令不变');updateUI()}
function selectProductionFactory(q){if(commandBlocked()||!state.queue.includes(q))return;let factory=activeProductionFactory(q);if(!factory){tell('该订单尚未分配可用工厂，保留当前选择');return}resetSelectionClicks();selection=new Set([factory.id]);placement=null;attackMode=false;drag=null;clearOrdinaryCommand();tell('已选择订单工厂（'+Math.round(factory.x)+','+Math.round(factory.y)+'） · '+productionStateLabel(q)+'；订单与集结设置保持不变');updateUI()}
// UI rows are keyed by order object, never rebound from one paid order to another.
let productionOrderRows=new Map(),productionOrderEmpty=null,productionOrdersUpdating=false;
function retireProductionOrderRow(row){if(!row?.live)return;row.live=false;row.pointer=null;row.key=null;row.priority.pointer=null;row.priority.key=null;row.factory.pointer=null;row.factory.key=null;row.node.disabled=true;row.priorityNode.disabled=true;row.factoryNode.disabled=true;productionOrderRows.delete(row.q);if(row.wrapper.parentNode)row.wrapper.parentNode.removeChild(row.wrapper)}
function invalidateProductionOrderRows(){for(let row of [...productionOrderRows.values()])retireProductionOrderRow(row)}
function validProductionOrderRow(row){return row.live&&row.battle===state&&!commandBlocked()&&state.queue.includes(row.q)&&row.wrapper.parentNode===$('productionOrders')&&row.node.parentNode===row.wrapper&&!row.node.disabled}
function productionOrderPriorityReason(q){if(commandBlocked())return'当前不能下达命令';if(!state.queue.includes(q))return'订单已失效';if(activeProductionFactory(q))return q.waitingForExit?'等待出口／已分配工厂':'正在生产／已分配工厂';return state.queue.find(order=>!activeProductionFactory(order))===q?'已在等待首位':''}
function validProductionOrderPriority(row){return validProductionOrderRow(row)&&row.priorityNode.parentNode===row.wrapper&&!row.priorityNode.disabled&&!productionOrderPriorityReason(row.q)}
function productionOrderFactoryReason(q){if(commandBlocked())return !state.started?'尚未开始':restartPrompt?'重新部署菜单中':'战局已结束';if(!state.queue.includes(q))return'订单已失效';return activeProductionFactory(q)?'':'暂无可用的已分配工厂'}
function validProductionOrderFactory(row){return validProductionOrderRow(row)&&row.factoryNode.parentNode===row.wrapper&&!row.factoryNode.disabled&&!productionOrderFactoryReason(row.q)}
function abortProductionOrderGesture(row){retireProductionOrderRow(row);updateOrders()}
function invalidateProductionOrderGestures(){for(let row of [...productionOrderRows.values()]){if(row.pointer||row.key&&!row.key.consumed||row.priority.pointer||row.priority.key||row.factory.pointer||row.factory.key)retireProductionOrderRow(row);else{row.key=null;row.priority.key=null;row.priority.pointer=null;row.factory.key=null;row.factory.pointer=null}}updateOrders()}
function bindProductionOrderPriority(row){let node=row.priorityNode,gesture=row.priority;node.type='button';node.style.cssText='display:block;width:100%;margin-top:3px;padding:7px 10px;font-size:12px;text-align:left;overflow-wrap:anywhere';node.onclick=()=>{if(!validProductionOrderPriority(row))return;if(gesture.pointer&&(!gesture.pointer.released||gesture.pointer.consumed)||gesture.key?.consumed)return;if(gesture.pointer)gesture.pointer.consumed=true;if(gesture.key)gesture.key.consumed=true;prioritizeProduction(row.q)};node.onpointerdown=event=>{if(!validProductionOrderPriority(row)||event.button!==0||event.isPrimary===false)return;if(gesture.pointer&&!gesture.pointer.released&&gesture.pointer.id!==event.pointerId)return;gesture.key=null;gesture.pointer={id:event.pointerId,released:false,consumed:false}};node.onpointerup=event=>{if(gesture.pointer&&gesture.pointer.id===event.pointerId)gesture.pointer.released=true};node.onpointercancel=event=>{if(gesture.pointer&&gesture.pointer.id===event.pointerId)abortProductionOrderGesture(row)};node.onlostpointercapture=event=>{if(gesture.pointer&&!gesture.pointer.released&&gesture.pointer.id===event.pointerId)abortProductionOrderGesture(row)};node.onkeydown=event=>{if(!validProductionOrderPriority(row)||event.isComposing||!['Enter',' '].includes(event.key))return;if(event.repeat){event.preventDefault?.();if(!gesture.key)gesture.key={key:event.key,consumed:true,released:false};return}gesture.pointer=null;gesture.key={key:event.key,consumed:false,released:false}};node.onkeyup=event=>{if(gesture.key?.key===event.key)gesture.key.released=true};node.onblur=()=>{if(!row.live)return;if(gesture.pointer&&!gesture.pointer.consumed||gesture.key&&!gesture.key.consumed)abortProductionOrderGesture(row)};}
function setReadonlyOrderAttribute(node,key,value){if(node.getAttribute(key)!==value)node.setAttribute(key,value)}
function updateProductionOrderPriority(row,index){let reason=productionOrderPriorityReason(row.q),node=row.priorityNode;node.disabled=!!reason||!row.live;setReadonlyPanelProperty(node,'textContent','移到等待首位'+(reason?' · '+reason:''));setReadonlyOrderAttribute(node,'aria-label','第'+(index+1)+'单 '+defs[row.q.type].name+'：移到等待首位'+(reason?'（'+reason+'）':''));setReadonlyPanelProperty(node,'title',(reason?reason+'；':'')+'仅调整此已付订单的等待顺序，不抢占已分配工厂；费用、已有进度与循环设置保留，Shift或Alt不改变本按钮含义')}
function bindProductionOrderFactory(row){let node=row.factoryNode,gesture=row.factory;node.type='button';node.style.cssText='display:block;width:100%;margin-top:3px;padding:7px 10px;font-size:12px;text-align:left;overflow-wrap:anywhere';node.onclick=()=>{if(!validProductionOrderFactory(row))return;if(gesture.pointer&&(!gesture.pointer.released||gesture.pointer.consumed)||gesture.key?.consumed)return;if(gesture.pointer)gesture.pointer.consumed=true;if(gesture.key)gesture.key.consumed=true;selectProductionFactory(row.q)};node.onpointerdown=event=>{if(!validProductionOrderFactory(row)||event.button!==0||event.isPrimary===false)return;if(gesture.pointer&&!gesture.pointer.released&&gesture.pointer.id!==event.pointerId)return;gesture.key=null;gesture.pointer={id:event.pointerId,released:false,consumed:false}};node.onpointerup=event=>{if(gesture.pointer&&gesture.pointer.id===event.pointerId)gesture.pointer.released=true};node.onpointercancel=event=>{if(gesture.pointer&&gesture.pointer.id===event.pointerId)abortProductionOrderGesture(row)};node.onlostpointercapture=event=>{if(gesture.pointer&&!gesture.pointer.released&&gesture.pointer.id===event.pointerId)abortProductionOrderGesture(row)};node.onkeydown=event=>{if(!validProductionOrderFactory(row)||event.isComposing||!['Enter',' '].includes(event.key))return;if(event.repeat){event.preventDefault?.();if(!gesture.key)gesture.key={key:event.key,consumed:true,released:false};return}gesture.pointer=null;gesture.key={key:event.key,consumed:false,released:false}};node.onkeyup=event=>{if(gesture.key?.key===event.key)gesture.key.released=true};node.onblur=()=>{if(!row.live)return;if(gesture.pointer&&!gesture.pointer.consumed||gesture.key&&!gesture.key.consumed)abortProductionOrderGesture(row)};}
function updateProductionOrderFactory(row,index){let reason=productionOrderFactoryReason(row.q),node=row.factoryNode;node.disabled=!!reason||!row.live;setReadonlyPanelProperty(node,'textContent','选择此订单工厂'+(reason?' · '+reason:''));setReadonlyOrderAttribute(node,'aria-label','第'+(index+1)+'单 '+defs[row.q.type].name+'：选择当前已分配工厂'+(reason?'（'+reason+'）':''));setReadonlyPanelProperty(node,'title',(reason?reason+'；':'')+'仅选择此订单当前已分配的存活己方已完工工厂；订单、费用、进度、循环与集结设置保留，不自动清理出口，Shift或Alt不改变本按钮含义')}
function createProductionOrderRow(q){let wrapper=document.createElement('div'),node=document.createElement('button'),statusNode=document.createElement('div'),priorityNode=document.createElement('button'),factoryNode=document.createElement('button'),row={q,node,statusNode,wrapper,priorityNode,factoryNode,priority:{pointer:null,key:null},factory:{pointer:null,key:null},battle:state,live:true,pointer:null,key:null};wrapper.style.cssText='margin-top:6px';node.type='button';node.style.cssText='display:none;width:100%;text-align:left';statusNode.setAttribute('aria-live','off');statusNode.style.cssText='font-size:13px;line-height:1.65;overflow-wrap:anywhere;margin-bottom:4px';wrapper.appendChild(statusNode);wrapper.appendChild(node);wrapper.appendChild(priorityNode);wrapper.appendChild(factoryNode);node.onclick=event=>{if(!validProductionOrderRow(row))return;if(row.pointer&&!row.pointer.released)return;if(row.key?.consumed)return;row.pointer=null;if(row.key){row.key.consumed=true;if(row.key.released)row.key=null}if(event?.altKey)selectProductionFactory(q);else if(event?.shiftKey)prioritizeProduction(q);else cancelProduction(q)};node.onpointerdown=event=>{if(!validProductionOrderRow(row)||event.button!==0||event.isPrimary===false)return;if(row.pointer&&!row.pointer.released&&row.pointer.id!==event.pointerId)return;row.key=null;row.pointer={id:event.pointerId,released:false}};node.onpointerup=event=>{if(row.pointer&&row.pointer.id===event.pointerId)row.pointer.released=true};node.onpointercancel=event=>{if(row.pointer&&row.pointer.id===event.pointerId)abortProductionOrderGesture(row)};node.onlostpointercapture=event=>{if(row.pointer&&!row.pointer.released&&row.pointer.id===event.pointerId)abortProductionOrderGesture(row)};node.onkeydown=event=>{if(!validProductionOrderRow(row)||event.isComposing||!['Enter',' '].includes(event.key))return;if(event.repeat){event.preventDefault?.();if(!row.key)row.key={key:event.key,consumed:true,released:false};return}row.pointer=null;row.key={key:event.key,consumed:false,released:false}};node.onkeyup=event=>{if(row.key?.key===event.key){if(row.key.consumed)row.key=null;else row.key.released=true}};node.onblur=()=>{if(!row.live)return;if(row.pointer||row.key&&!row.key.consumed)abortProductionOrderGesture(row);else row.key=null};bindProductionOrderPriority(row);bindProductionOrderFactory(row);return row}
function productionOrderButtons(){let container=$('productionOrders');if(!container)return null;if(!productionOrderEmpty)productionOrderEmpty=Array.from({length:8},(_,i)=>{let node=$('order'+i)||document.createElement('button');node.type='button';node.onclick=null;node.disabled=true;node.style.cssText='display:none;width:100%;margin-top:4px;text-align:left';return node});let orders=state.queue.slice(0,8);for(let row of [...productionOrderRows.values()])if(!row.live||row.battle!==state||!orders.includes(row.q))retireProductionOrderRow(row);let rows=orders.map(q=>{let row=productionOrderRows.get(q);if(!row){row=createProductionOrderRow(q);productionOrderRows.set(q,row)}return row}),buttons=rows.map(row=>row.node).concat(productionOrderEmpty.slice(orders.length)),children=rows.map(row=>row.wrapper).concat(productionOrderEmpty.slice(orders.length)),focused=document.activeElement,focusedRow=rows.find(row=>row.node===focused||row.priorityNode===focused||row.factoryNode===focused);for(let node of productionOrderEmpty)node.id='';for(let row of productionOrderRows.values()){row.node.id='';row.priorityNode.id='';row.factoryNode.id=''}for(let node of [...container.children])if(!children.includes(node))container.removeChild(node);for(let i=0;i<children.length;i++){let node=children[i];if(node===focusedRow?.wrapper&&node.parentNode===container){while(container.children[i]!==node)container.appendChild(container.children[i])}else if(container.children[i]!==node)container.insertBefore(node,container.children[i]||null);buttons[i].id='order'+i;if(rows[i]){rows[i].priorityNode.id='orderPriority'+i;rows[i].factoryNode.id='orderFactory'+i}}if(focusedRow&&focusedRow.live&&focusedRow.wrapper.parentNode===container&&!focused.disabled&&document.activeElement!==focused)focused.focus({preventScroll:true});return buttons}
window.addEventListener('pointerup',event=>{for(let row of [...productionOrderRows.values()])if(row.pointer&&!row.pointer.released&&row.pointer.id===event.pointerId||row.priority.pointer&&!row.priority.pointer.released&&row.priority.pointer.id===event.pointerId||row.factory.pointer&&!row.factory.pointer.released&&row.factory.pointer.id===event.pointerId)abortProductionOrderGesture(row)});
window.addEventListener('pointercancel',event=>{for(let row of [...productionOrderRows.values()])if(row.pointer&&row.pointer.id===event.pointerId||row.priority.pointer&&row.priority.pointer.id===event.pointerId||row.factory.pointer&&row.factory.pointer.id===event.pointerId)abortProductionOrderGesture(row)});
window.addEventListener('keyup',event=>{for(let row of [...productionOrderRows.values()]){if(row.key?.key===event.key&&event.target!==row.node){if(row.key.consumed)row.key=null;else abortProductionOrderGesture(row)}if(row.live&&row.priority.key?.key===event.key&&event.target!==row.priorityNode){if(row.priority.key.consumed)row.priority.key.released=true;else abortProductionOrderGesture(row)}if(row.live&&row.factory.key?.key===event.key&&event.target!==row.factoryNode){if(row.factory.key.consumed)row.factory.key.released=true;else abortProductionOrderGesture(row)}}});
function updateOrders(){if(productionOrdersUpdating)return;productionOrdersUpdating=true;try{let buttons=productionOrderButtons();if(!buttons)return;let orderPower,waitingReason;const readOrderPower=()=>orderPower??=powered(),readWaitingReason=()=>waitingReason??=productionWaitingReason();for(let i=0;i<8;i++){let b=buttons[i],q=state.queue[i];b.style.display=q?'block':'none';b.disabled=!state.started||!!state.result||restartPrompt;if(q){let row=productionOrderRows.get(q),prefix=(i+1)+'. '+(q.repeatOrder===true?'循环订单 ':q.factoryRepeatSource?'本厂循环 ':'')+defs[q.type].name;updateProductionOrderPriority(productionOrderRows.get(q),i);updateProductionOrderFactory(productionOrderRows.get(q),i);if(state.result){setReadonlyPanelProperty(row.statusNode,'textContent',prefix+' · '+productionStateLabel(q,readOrderPower)+' · 结束时剩余 '+Math.ceil(q.left)+' 秒');setReadonlyPanelProperty(b,'textContent','取消订单 · 战局已结束');setReadonlyOrderAttribute(b,'aria-label','第'+(i+1)+'单 '+defs[q.type].name+'：取消订单不可用，战局已结束');setReadonlyPanelProperty(b,'title','战局已结束，订单仅供只读查看；结束时剩余'+Math.ceil(q.left)+'秒');continue}let active=activeProductionFactory(q);setReadonlyPanelProperty(row.statusNode,'textContent',prefix+' · '+productionStateLabel(q,readOrderPower)+productionWaitingExplanation(q,readWaitingReason)+(q.left>0?' · 还需生产 '+Math.ceil(q.left)+' 秒':' · 生产已完成'+(q.waitingForExit?'，等待出口':'')));setReadonlyPanelProperty(b,'textContent','取消订单 · 退 '+productionRefund(q)+(q.repeatOrder===true?' 并关闭循环':q.factoryRepeatSource?' 并停来源厂循环':''));setReadonlyOrderAttribute(b,'aria-label','第'+(i+1)+'单 '+defs[q.type].name+'：普通点击'+b.textContent);let title=active?'点击取消订单，按剩余生产比例退款；已占用工厂，不可Shift插队':'点击取消并按剩余生产比例退款；Shift+点击移到等待首位，费用和已有进度保留';title+='；Alt+点击仅选择已分配工厂（优先于Shift），不取消订单';if(q.factoryRepeatSource)title+='；取消会关闭此订单对应的来源工厂循环；已切换或关闭模式的旧单不再关联，来源厂已毁则不影响接手厂';if(q.repeatOrder===true)title+='；取消此循环订单会关闭当前全局循环设置，包含刚切换的车型';setReadonlyPanelProperty(b,'title',title)}}}finally{productionOrdersUpdating=false}}
function plannedConstructionPower(type){let p=power(),pending=structures(0).filter(e=>e.build);return{supply:p.supply+pending.filter(e=>e.type==='power').length*STATION_POWER_SUPPLY+(type==='power'?STATION_POWER_SUPPLY:0),demand:p.demand+pending.reduce((n,e)=>n+buildingPowerDemand(e.type),0)+buildingPowerDemand(type),pending:pending.length}}
function constructionCollisionBlocker(type,p,reason){let e,kind,name,r;if(reason==='与建筑或车辆间距不足'){e=state.entities.find(e=>e.hp>0&&dist(e,p)<e.r+defs[type].r+15);kind='entity';if(e){name=(e.team===0?'己方':'敌方')+defs[e.type].name+(e.build?'（在建）':'');r=e.r}}else if(reason==='与岩石间距不足'){e=terrainObstacles().find(e=>dist(e,p)<e.r+defs[type].r+15);kind='rock';name='岩石';r=e?.r}else if(reason==='与矿点间距不足（含已耗尽矿点）'){e=state.ores.find(e=>dist(e,p)<defs[type].r+32);kind='ore';name=e?.amount>0?'矿点':'已耗尽矿点';r=32}else if(reason==='与据点间距不足'){e=state.posts.find(e=>dist(e,p)<defs[type].r+40);kind='post';name='据点';r=40}return e?{kind,name,x:e.x,y:e.y,r}:null}
function constructionPreview(type,p){if(!['power','refinery','factory','turret'].includes(type)||!p||!Number.isFinite(p.x)||!Number.isFinite(p.y))return null;let d=defs[type],r=d.r,geometry=canPlace(type,p),affordable=state.cash>=d.cost,reason='';if(commandBlocked())reason='当前不能下达建造命令';else if(buildingRuleReason(type))reason=buildingRuleReason(type);else if(!geometry){if(!(p.x>r+5&&p.x<WIDTH-r-5&&p.y>r+5&&p.y<HEIGHT-r-5))reason='距战场边缘太近';else if(!structures(0).some(e=>!e.build&&dist(e,p)<220))reason='需靠近已建成己方建筑（距离小于220）';else if(state.entities.some(e=>e.hp>0&&dist(e,p)<e.r+r+15))reason='与建筑或车辆间距不足';else if(terrainObstacles().some(e=>dist(e,p)<e.r+r+15))reason='与岩石间距不足';else if(state.ores.some(e=>dist(e,p)<r+32))reason='与矿点间距不足（含已耗尽矿点）';else if(state.posts.some(e=>dist(e,p)<r+40))reason='与据点间距不足';else reason='当前位置暂不可用'}else if(!affordable)reason='资金不足，还差'+Math.ceil(d.cost-state.cash);let projected=plannedConstructionPower(type),shortage=Math.max(0,projected.demand-projected.supply),ores=type==='refinery'?state.ores.filter(o=>o.amount>0&&dist(o,p)<=400):[];return{type,x:p.x,y:p.y,r,cost:d.cost,time:d.time,canBuild:!reason,geometry,affordable,reason,blocker:constructionCollisionBlocker(type,p,reason),projected,shortage,oreCount:ores.length,oreAmount:ores.reduce((n,o)=>n+o.amount,0)}}
function constructionPreviewLines(view){let lines=[defs[view.type].name+' · '+view.cost+'资金 / '+view.time+'秒',view.reason||('当前可放置'+(view.shortage?' · 预计缺电'+view.shortage:'')),view.affordable?'若放置，剩余资金：'+Math.floor(state.cash-view.cost):'资金不足：现有'+Math.floor(state.cash)+'，还差'+Math.ceil(view.cost-state.cash),'完工预计：供电'+view.projected.supply+' / 需求'+view.projected.demand,'包括全部在建和本项'+(view.shortage?'，缺电'+view.shortage:''),'假设当前设施不损失；不预留资金'];if(view.type==='refinery')lines.push('直线400内：'+view.oreCount+'处 · 余矿'+Math.ceil(view.oreAmount),'矿量共享，范围不保证道路可达');if(view.type==='turret')lines.push('炮塔标称射程：'+defs.turret.range);if(view.blocker)lines.push('首个阻挡：'+view.blocker.name,'中心坐标：'+Math.round(view.blocker.x)+', '+Math.round(view.blocker.y),'红圈仅标一处；换个落点后复查');return lines}
function constructionPreviewColor(view){return view.canBuild?(view.shortage?'#ebc877':'#a3db81'):'#ed987f'}
function drawConstructionRange(view){if(!view||!['refinery','turret'].includes(view.type))return;ctx.save();ctx.strokeStyle=constructionPreviewColor(view);ctx.globalAlpha=.7;ctx.lineWidth=1.2;ctx.setLineDash([5,8]);ctx.beginPath();ctx.arc(view.x,view.y,view.type==='refinery'?400:defs.turret.range,0,Math.PI*2);ctx.stroke();ctx.restore()}
function drawConstructionGhost(view){if(!view)return;ctx.save();ctx.globalAlpha=.5;rect(view.x-view.r,view.y-view.r,view.r*2,view.r*2,constructionPreviewColor(view));ctx.globalAlpha=1;text(defs[view.type].name,view.x-view.r,view.y-view.r-10);ctx.restore()}
function drawConstructionBlocker(view){let b=view?.blocker;if(!b)return;ctx.save();ctx.globalAlpha=1;ctx.strokeStyle='#ff8c79';ctx.lineWidth=2;ctx.setLineDash([4,3]);ctx.beginPath();ctx.arc(b.x,b.y,b.r+4,0,Math.PI*2);ctx.stroke();ctx.restore()}
function drawConstructionPanel(view){if(!view)return;let lines=constructionPreviewLines(view),box=inspectionBox(lines),color=constructionPreviewColor(view);ctx.save();ctx.globalAlpha=1;rect(box.x,box.y,box.w,box.h,'#102019f2');ctx.strokeStyle=color;ctx.lineWidth=1;ctx.strokeRect(box.x,box.y,box.w,box.h);lines.forEach((line,i)=>text(line,box.x+12,box.y+20+i*18,i===1?color:'#dce6d2',12));ctx.restore()}
function challengeRule(battle=state){return battle.challenge==='mobile'?'mobile':'standard'}
function challengeLabel(value){return value==='mobile'?'机动作战（己方禁建炮塔）':'标准规则'}
function buildingRuleReason(type,team=0){return team===0&&type==='turret'&&challengeRule()==='mobile'?'机动作战挑战禁止新建己方炮塔':''}
function constructionCardReason(type){if(!state.started)return'尚未开始作战';if(state.result)return'战局已结束';if(restartPrompt)return'请先完成或取消重新部署确认';let restriction=buildingRuleReason(type);if(restriction)return restriction;return state.cash<defs[type].cost?'资金不足，还差 '+Math.ceil(defs[type].cost-state.cash)+'资金':''}
function canPlace(type,p,team=0){let r=defs[type].r;return p.x>r+5&&p.x<WIDTH-r-5&&p.y>r+5&&p.y<HEIGHT-r-5&&structures(team).some(e=>!e.build&&dist(e,p)<220)&&!state.entities.some(e=>e.hp>0&&dist(e,p)<e.r+r+15)&&!terrainObstacles().some(e=>dist(e,p)<e.r+r+15)&&!state.ores.some(e=>dist(e,p)<r+32)&&!state.posts.some(e=>dist(e,p)<r+40)}
function place(p){if(commandBlocked()||!placement)return;let type=placement,d=defs[type],restriction=buildingRuleReason(type);if(restriction)return tell(restriction);if(!canPlace(type,p))return tell(constructionPreview(type,p)?.reason||'当前位置暂不可用');if(state.cash<d.cost)return tell('资金不足，还差'+Math.ceil(d.cost-state.cash));state.cash-=d.cost;state.stats.spent[0]+=d.cost;create(type,0,p.x,p.y,true);placement=null;tell(d.name+' 正在施工');updateUI()}
function constructionCancelQuote(){if(selection.size!==1)return{target:null,refund:0};let target=state.entities.find(e=>selection.has(e.id)&&e.team===0&&e.hp>0&&!defs[e.type].speed&&e.type!=='hq'&&e.build>0&&defs[e.type].cost&&defs[e.type].time);return{target,refund:target?Math.floor(defs[target.type].cost*clamp(target.build/defs[target.type].time,0,1)*clamp(target.hp/target.max,0,1)+1e-8):0}}
function buildingActionSnapshot(q){let e=q.target;return{battle:state,target:e,refund:q.refund,id:e.id,type:e.type,team:e.team,x:e.x,y:e.y,hp:e.hp,max:e.max,build:e.build}}
function sameBuildingAction(snapshot,q){let e=q.target;return !!e&&state===snapshot.battle&&!commandBlocked()&&e===snapshot.target&&q.refund===snapshot.refund&&['id','type','team','x','y','hp','max','build'].every(key=>e[key]===snapshot[key])}
function cancelConstructionSelected(){if(commandBlocked())return;let q=constructionCancelQuote();if(!q.target)return tell('请选择一座尚未完工的己方建筑（指挥中心除外）');let snapshot=buildingActionSnapshot(q);if(!window.confirm('取消'+defs[q.target.type].name+'施工，退回 '+q.refund+' 资金？建筑将移除；已施工或受损部分不退，原生产订单保留。'))return;if(!sameBuildingAction(snapshot,constructionCancelQuote())){tell('建筑状态或选择已变化，请重新确认');updateUI();return}q.target.hp=0;state.entities=state.entities.filter(e=>e.id!==q.target.id);selection.delete(q.target.id);placement=null;attackMode=false;drag=null;clearOrdinaryCommand();state.cash+=q.refund;state.stats.spent[0]=Math.max(0,state.stats.spent[0]-q.refund);assignFactories();tell(defs[q.target.type].name+' 施工已取消：退回 '+q.refund+' 资金');updateUI()}
function selectedBuildingAction(){if(constructionCancelQuote().target)cancelConstructionSelected();else salvageSelected()}
function salvageQuote(){if(selection.size!==1)return{target:null,refund:0};let target=state.entities.find(e=>selection.has(e.id)&&e.team===0&&e.hp>0&&!defs[e.type].speed&&e.type!=='hq'&&!e.build&&defs[e.type].cost);return{target,refund:target?Math.floor(defs[target.type].cost*.5*clamp(target.hp/target.max,0,1)):0}}
function salvageSelected(){if(commandBlocked())return;let q=salvageQuote();if(!q.target)return tell('请选择一座已建成己方建筑（指挥中心除外）');let snapshot=buildingActionSnapshot(q);if(!window.confirm('回收'+defs[q.target.type].name+'，获得 '+q.refund+' 资金？建筑将移除，可能影响电力、采矿或生产；生产订单会保留。'))return;if(!sameBuildingAction(snapshot,salvageQuote())){tell('建筑状态或选择已变化，请重新确认');updateUI();return}q.target.hp=0;state.entities=state.entities.filter(e=>e.id!==q.target.id);selection.delete(q.target.id);placement=null;attackMode=false;drag=null;clearOrdinaryCommand();state.cash+=q.refund;state.stats.income[0]+=q.refund;assignFactories();tell(defs[q.target.type].name+' 已回收：+'+q.refund+' 资金');updateUI()}
function repairTargetLabel(e){return defs[e.type].name+'（'+Math.round(e.x)+','+Math.round(e.y)+'）'}
function selectedBuildingHint(selected){let lines=[],q=repairQuote();if(q.target&&selected.includes(q.target))lines.push('修理按钮仅作用于：'+repairTargetLabel(q.target)+'；修理其他建筑请单独选择');if(selected.some(e=>e.team===0&&e.hp>0&&e.type==='factory'&&e.build))lines.push('施工中的工厂暂不能设置集结点；混选时仅已完工工厂接收集结指令');return lines.length?'\n'+lines.join('\n'):''}
function damagedBuildings(){return state.entities.filter(e=>e.team===0&&e.hp>0&&!defs[e.type].speed&&!e.build&&e.hp<e.max).sort((a,b)=>a.hp/a.max-b.hp/b.max||a.id-b.id)}
function selectDamagedBuilding(){if(commandBlocked())return;let target=damagedBuildings()[0];if(!target){tell('当前没有受损且已建成的己方建筑');updateUI();return}resetSelectionClicks();selection=new Set([target.id]);placement=null;attackMode=false;drag=null;clearOrdinaryCommand();tell('已选择'+repairTargetLabel(target)+'；仅选择，按R或点修理按报价付费');updateUI()}
function buildingMaintenanceOverview(candidates,q){let lines=['B免费选最低比例；R按操作时的单座报价修理，长按不连修。'];if(commandBlocked())lines.push('当前不可操作，仅供查看。');if(!candidates.length)lines.push('当前没有受损且已完工的己方建筑。');else{lines.push('剩余生命比例最低的前'+Math.min(5,candidates.length)+'座（非战略优先推荐）：');for(let e of candidates.slice(0,5)){let p=e.hp/e.max*100,label=p<1?'<1%':p>99?'>99%':Math.round(p)+'%';lines.push(repairTargetLabel(e)+' · 剩余'+label)}if(candidates.length>5)lines.push('另有'+(candidates.length-5)+'座受损建筑未列出。')}if(!q.target){if(candidates.length)lines.push(commandBlocked()?'尚未选中可修建筑。':'尚未选中可修建筑；按B或在地图点选。')}else{lines.push('R实际目标：'+repairTargetLabel(q.target)+'（仅一座，不一定是列表首项）。');if(q.heal>0){let gain=q.heal<.1?'不足0.1':'约'+Math.round(q.heal*10)/10;lines.push('当前报价：恢复'+gain+'生命 / '+q.cost+'资金；扣后余额'+Math.floor(state.cash-q.cost)+'（向下取整）。')}else lines.push('资金不足，本次无法修理。')}return lines.join('\n')}
function repairQuote(){let target=state.entities.find(e=>selection.has(e.id)&&e.team===0&&e.hp>0&&!defs[e.type].speed&&!e.build&&e.hp<e.max);if(!target)return{target:null,heal:0,cost:0};let heal=Math.max(0,Math.min(300,target.max-target.hp,Math.floor(state.cash)*3));return{target,heal,cost:Math.ceil(heal/3)}}
function repairSelected(){if(!state.started||state.result||restartPrompt)return;let q=repairQuote();if(!q.target)return tell('选择受损且已建成的己方建筑');if(!q.heal)return tell('资金不足');state.cash-=q.cost;state.stats.spent[0]+=q.cost;q.target.hp=Math.min(q.target.max,q.target.hp+q.heal);tell(q.target.type==='hq'?'指挥中心修理完成：花费 '+q.cost+'，恢复 '+(q.heal>0&&q.heal<.1?'<0.1':Math.round(q.heal*10)/10)+' 生命':defs[q.target.type].name+' 修理：花费 '+q.cost+'，恢复 '+(q.heal>0&&q.heal<.1?'<0.1':Math.round(q.heal*10)/10)+' 生命');updateUI()}
const GUARD_AREA_RADIUS=180;
function clearGuardArea(e,stop=false){if(!e.guardArea)return;delete e.guardArea;navigationMemory.delete(e);if(stop){e.goal=null;e.target=null;e.attackMove=false}}
function toggleGuardArea(){if(commandBlocked())return;let troops=patrolTroops(),active=troops.filter(e=>e.guardArea),count=0;if(active.length){for(let e of active)clearGuardArea(e,true);count=active.length;tell('已解除 '+count+' 辆部队的驻点警戒')}else{let walls=movementObstacles();for(let e of troops){if(!patrolPointSafe(e,e,walls))continue;clearPatrol(e);clearMoveQueue(e);clearAttackQueue(e);navigationMemory.delete(e);e.guardArea={x:e.x,y:e.y};e.goal=null;e.target=null;e.escortId=null;e.hold=false;e.attackMove=false;e.arrivalRadius=5;count++}tell(count?'已为 '+count+' 辆战斗车设置当前位置警戒；范围180，无合格目标时回防':'请选择位于安全地面的战斗车辆，原命令未改变')}if(count){placement=null;attackMode=false;drag=null;clearOrdinaryCommand()}updateUI()}
function updateGuardArea(e){let area=e.guardArea;if(!area)return;if(!patrolPointSafe(e,area,movementObstacles())){clearGuardArea(e,true);tell('警戒点已不可通行，已解除驻点警戒');return}let previous=e.target,target=get(previous),eligible=b=>b&&b.hp>0&&b.team!==e.team&&dist(area,b)<=GUARD_AREA_RADIUS;if(!eligible(target))target=null;if(!target)target=chooseFireTarget(e,state.entities.filter(b=>eligible(b)&&withinRange(e,b,defs[e.type].range+50)));let next=target?target.id:null;if(next!==(previous||null))navigationMemory.delete(e);e.target=next;e.attackMove=false;if(target){e.goal=null;return}if(dist(e,area)>5){if(!e.goal||e.goal.x!==area.x||e.goal.y!==area.y){e.goal={x:area.x,y:area.y};navigationMemory.delete(e)}e.arrivalRadius=5}else if(e.goal){e.goal=null;navigationMemory.delete(e)}}
function drawGuardAreas(){let selected=state.entities.filter(e=>selection.has(e.id)&&e.hp>0);if(selected.length>6)return;let guards=selected.filter(e=>e.team===0&&defs[e.type].speed&&defs[e.type].damage&&!e.build&&e.guardArea);if(!guards.length)return;ctx.save();ctx.strokeStyle='#86bff2';ctx.lineWidth=1.5;ctx.setLineDash([5,8]);for(let e of guards){ctx.beginPath();ctx.arc(e.guardArea.x,e.guardArea.y,GUARD_AREA_RADIUS,0,Math.PI*2);ctx.stroke();ctx.strokeRect(e.guardArea.x-5,e.guardArea.y-5,10,10);text('警戒',e.guardArea.x+e.r+10,e.guardArea.y-e.r-12,'#aed8fa',11)}ctx.restore()}
function patrolTroops(){return state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.hp>0&&defs[e.type].speed&&defs[e.type].damage&&!e.build)}
function patrolPointSafe(e,p,walls){return p&&Number.isFinite(p.x)&&Number.isFinite(p.y)&&p.x>=e.r&&p.x<=WIDTH-e.r&&p.y>=e.r&&p.y<=HEIGHT-e.r&&movementSegmentClear(p,p,e.r,walls)}
function clearPatrol(e,stop=false){if(!e.patrol)return;delete e.patrol;navigationMemory.delete(e);if(stop){e.goal=null;e.target=null;e.attackMove=false}}
function clearMoveQueue(e,stop=false){delete e.holdOnArrival;if(!e.moveQueue)return;delete e.moveQueue;navigationMemory.delete(e);if(stop){e.goal=null;e.target=null;e.attackMove=false}}
function queuedTailUndoOrders(){let orders=[];for(let e of state.entities){if(!selection.has(e.id)||e.team!==0||!(e.hp>0)||e.build||!['tank','scout','artillery'].includes(e.type))continue;let attack=Array.isArray(e.attackQueue),move=Array.isArray(e.moveQueue);if(attack===move)continue;let queue=attack?attackQueueTargets(e).map(target=>target.id):e.moveQueue,tail=queue.length-1;if(attack)while(tail>=0&&queue[tail]===e.target)tail--;if(queue.length>1&&tail>=0)orders.push({unit:e,queue,tail,kind:attack?'attack':'move'})}return orders}
function undoQueuedTail(){if(commandBlocked())return;let orders=queuedTailUndoOrders();if(!orders.length)return;for(let o of orders){if(o.kind==='attack')o.unit.attackQueue=o.queue.filter((id,index)=>index!==o.tail);else o.queue.pop()}let attack=orders.filter(o=>o.kind==='attack').length;let parts=[];if(attack)parts.push('攻击'+attack+'辆');if(orders.length>attack)parts.push('路线'+(orders.length-attack)+'辆');tell('已撤销队尾：'+parts.join('、')+'；各撤一项，当前指令保持');playSound('order');updateUI()}
// Clear future entries only; preserve actual current commands and pending inputs like tail undo.
function clearFutureQueueOrders(){let orders=[];for(let e of state.entities){if(!selection.has(e.id)||!canSetFirePriority(e))continue;let attack=Array.isArray(e.attackQueue),move=Array.isArray(e.moveQueue);if(attack===move||attack&&e.moveQueue!=null||move&&e.attackQueue!=null)continue;if(move){let q=e.moveQueue,validPoint=p=>p&&typeof p==='object'&&!Array.isArray(p)&&Number.isFinite(p.x)&&Number.isFinite(p.y)&&p.x>=e.r&&p.x<=WIDTH-e.r&&p.y>=e.r&&p.y<=HEIGHT-e.r;if(q.length<=1||!groundMovementOrderMode(e)||!validPoint(e.goal)||![...q].every(validPoint)||e.goal.x!==q[0].x||e.goal.y!==q[0].y)continue}else{if(!canQueueAttack(e)||e.attackMove!==false)continue;let current=attackDisplayTarget(e);if(!current||!attackQueueTargets(e).some(target=>target.id!==current.id))continue}orders.push({unit:e,kind:attack?'attack':'move'})}return orders}
function clearFutureQueue(){if(commandBlocked())return;let orders=clearFutureQueueOrders();if(!orders.length)return;for(let o of orders){if(o.kind==='attack')delete o.unit.attackQueue;else o.unit.moveQueue.length=1}let attack=orders.filter(o=>o.kind==='attack').length,parts=[];if(attack)parts.push('攻击'+attack+'辆');if(orders.length>attack)parts.push('路线'+(orders.length-attack)+'辆');tell('已清除后续队列：'+parts.join('、')+'；当前指令与抵达后坚守保留，待点选操作保留');playSound('order');updateUI()}
function clearAttackQueue(e){delete e.attackQueue}
function attackQueueTargets(e){return Array.isArray(e?.attackQueue)?e.attackQueue.map(id=>get(id)).filter(t=>t&&t.team!==e.team):[]}
function canQueueAttack(e){return !!e&&e.team===0&&e.hp>0&&!e.build&&['tank','scout','artillery'].includes(e.type)&&!e.goal&&!e.moveQueue&&!e.patrol&&!e.guardArea&&!e.escortId&&!e.hold&&!e.holdOnArrival}
function advanceAttackQueue(e){if(!e.attackQueue)return;let old=e.target;while(e.attackQueue.length){let target=get(e.attackQueue[0]);if(target&&target.team!==e.team)break;e.attackQueue.shift()}if(e.attackQueue.length)e.target=e.attackQueue[0];else{clearAttackQueue(e);e.target=null}if(e.target!==old)navigationMemory.delete(e)}
function appendAttackQueue(target){mapCommandReason('攻击排队最多8个目标含当前；重复或不适用单位保留原命令');if(commandBlocked()||placement||attackMode||!target||get(target.id)!==target||target.team!==1)return;let selected=state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.hp>0),count=0;for(let e of selected){if(!canQueueAttack(e))continue;let current=get(e.target),queue=e.attackQueue?attackQueueTargets(e).map(t=>t.id):current&&current.team!==e.team?[current.id]:[];if(queue.includes(target.id)||queue.length>=8)continue;queue.push(target.id);let old=e.target;e.attackQueue=queue;e.target=queue[0];e.goal=null;e.attackMove=false;e.hold=false;e.escortId=null;delete e.holdOnArrival;if(e.target!==old)navigationMemory.delete(e);count++;acceptMapCommand(e,'追加攻击目标')}if(count){drag=null;pushEffect({x:target.x,y:target.y,t:.6,max:.6,type:'order'});playSound('order')}tell(count?'已为 '+count+' 辆战车追加攻击目标；'+(selected.length-count)+' 个单位保留原命令，最多8个目标含当前':'未追加攻击：仅支持待命或指定攻击战车；目标不可重复，最多8个含当前');updateUI()}
function appendOrder(p,attack=false){if(placement||attack)return appendGroundRoute(p,attack);if(!p||!Number.isFinite(p.x)||!Number.isFinite(p.y))return;let target=state.entities.find(e=>e.team===1&&e.hp>0&&dist(e,p)<e.r+9);return target?appendAttackQueue(target):appendGroundRoute(p,attack)}
function attackQueueSummary(selected){let queued=selected.filter(e=>Array.isArray(e.attackQueue));if(!queued.length)return'';if(selected.length>1)return'\n攻击排队：'+queued.length+' 辆（各自按顺序执行）';let targets=attackQueueTargets(queued[0]);return'\n攻击队列：'+targets.length+' 个存活目标'+(targets.length?'（含当前）\n'+targets.map((t,i)=>(i+1)+'. '+defs[t.type].name+'（'+Math.round(t.x)+','+Math.round(t.y)+'）').join('\n'):'，恢复模拟后结束队列')}
function drawQueuedAttackOrders(){if(selection.size!==1)return;let unit=state.entities.find(e=>selection.has(e.id)&&e.team===0&&e.hp>0),targets=attackQueueTargets(unit);if(!targets.length)return;ctx.save();ctx.globalAlpha=1;ctx.setLineDash([]);ctx.textAlign='left';ctx.textBaseline='alphabetic';for(let i=0;i<targets.length;i++){let t=targets[i],x=clamp(t.x+t.r+6,4,WIDTH-28),y=clamp(t.y-t.r-20,4,HEIGHT-22);rect(x,y,22,19,'#432d1deb');text(String(i+1),x+6,y+14,'#ffd8a8',12)}ctx.restore()}
function appendGroundRoute(p,attack=false){mapCommandReason('路线仅接受普通模式空地；最多8个路点，不适用或无安全落点单位保留原命令');if(placement||attack)return tell('请先取消建造或攻击模式，再用Shift+右键追加普通地面路线');if(!p||!Number.isFinite(p.x)||!Number.isFinite(p.y))return;if(state.entities.some(e=>e.hp>0&&dist(e,p)<e.r+9)||terrainObstacles().some(o=>dist(o,p)<o.r+20))return tell('分段路线只接受空地；现有命令未改变');let selected=state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.hp>0),walls=movementObstacles(),troops=formationOrder(selected.filter(e=>defs[e.type].speed&&defs[e.type].damage&&!e.build&&!e.attackQueue&&!e.target&&!e.escortId&&!e.patrol&&!e.guardArea&&!e.hold&&(e.moveQueue?.length||(e.goal?1:0))<8&&(!e.goal||patrolPointSafe(e,e.goal,walls))),true),spacing=orderSpacing(),cols=Math.ceil(Math.sqrt(troops.length)),rows=Math.ceil(troops.length/(cols||1)),used=[],count=0;for(let i=0;i<troops.length;i++){let e=troops[i],goal=groundGoal(e,{x:clamp(p.x+(i%cols-(cols-1)/2)*spacing,20,WIDTH-20),y:clamp(p.y+(Math.floor(i/cols)-(rows-1)/2)*spacing,20,HEIGHT-20)},used);if(!goal)continue;used.push({...goal,r:e.r});if(!e.moveQueue)e.moveQueue=e.goal?[{x:e.goal.x,y:e.goal.y}]:[];e.moveQueue.push({...goal});if(!e.goal){e.goal={...goal};e.attackMove=false;e.arrivalRadius=troops.length>1?clamp(e.r,5,16):5;navigationMemory.delete(e)}count++;acceptMapCommand(e,'追加路线点')}if(count){drag=null;pushEffect({x:p.x,y:p.y,t:.6,max:.6,type:'order'})}tell(count?'已为 '+count+' 辆战斗车辆追加路线；'+(selected.length-count)+' 个单位保留原命令':'未追加路线：仅支持闲置或移动中的战斗车辆，最多8个路点；护航、巡逻、警戒、坚守与指定攻击需先取消');updateUI()}
function checkMoveRoutes(){let troops=state.entities.filter(e=>e.hp>0&&e.moveQueue);if(!troops.length)return;let walls=movementObstacles(),cancelled=0,cancelledArrivalHolds=0;for(let e of troops)if(!patrolPointSafe(e,e.goal,walls)){if(e.holdOnArrival===true)cancelledArrivalHolds++;clearMoveQueue(e,true);cancelled++}if(cancelled)tell(cancelled+' 辆部队的分段路线当前路点被阻挡，已停止整条路线'+(cancelledArrivalHolds?'；其中 '+cancelledArrivalHolds+' 辆的抵达后坚守预约已取消':''))}
function attackDisplayTarget(e){if(!e||e.team!==0||e.hp<=0||e.build||!defs[e.type]?.speed||!defs[e.type]?.damage||e.guardArea||e.escortId)return null;let target=get(e.target);return target&&target.team!==e.team?target:null}
function attackTargetLabel(e){let target=attackDisplayTarget(e);return target?defs[target.type].name+' · ('+Math.round(target.x)+', '+Math.round(target.y)+')':''}
function drawAttackOrders(){if(selection.size>6)return;let targets=new Map();ctx.save();ctx.strokeStyle='#edaa8277';ctx.lineWidth=1.25;ctx.setLineDash([5,6]);for(let e of state.entities){if(!selection.has(e.id))continue;let target=attackDisplayTarget(e);if(!target)continue;ctx.beginPath();ctx.moveTo(e.x,e.y);ctx.lineTo(target.x,target.y);ctx.stroke();targets.set(target.id,target)}ctx.setLineDash([]);ctx.strokeStyle='#efaa82bb';for(let target of targets.values()){let r=target.r+9;ctx.strokeRect(target.x-r,target.y-r,r*2,r*2)}ctx.restore()}
function drawQueuedOrders(){let troops=patrolTroops().filter(e=>e.moveQueue);if(selection.size>6)return;ctx.save();ctx.lineWidth=1;ctx.strokeStyle='#8eaff5';ctx.setLineDash([2,7]);for(let e of troops){ctx.beginPath();ctx.moveTo(e.x,e.y);for(let p of e.moveQueue)ctx.lineTo(p.x,p.y);ctx.stroke();for(let i=0;i<e.moveQueue.length;i++){let p=e.moveQueue[i];ctx.beginPath();ctx.arc(p.x,p.y,9,0,Math.PI*2);ctx.stroke();text(String(i+1),p.x+12,p.y-7,'#b7cbff',11)}}ctx.restore()}
// Read-only action preview follows togglePatrol's eligible troops and priority.
function updatePatrolActionControl(){let troops=patrolTroops(),active=troops.some(e=>e.patrol),guards=troops.some(e=>e.guardArea),blocked=commandBlocked(),label=active?'停止巡逻 [P]':guards?'解除警戒 [P]':'往返巡逻 [P]',hint=active?'仅停止所选巡逻车的巡逻；警戒车及其他单位保留原命令，不会切换为巡逻。':guards?'仅解除所选警戒车的警戒，并清除其当前移动或攻击目标；其他单位保留原命令，不会自动开始巡逻。需重新指定至少60单位远的安全终点，再按P。':'先给战斗车辆指定至少60单位远的安全地面终点，再按P往返巡逻；不符合条件的单位保留原命令。暂停时也可设置。';setReadonlyPanelProperty($('patrol'),'textContent',label);setReadonlyPanelProperty($('patrol'),'title',hint);setReadonlyPanelProperty($('patrol'),'disabled',blocked||!troops.length);setReadonlyPanelProperty($('patrolActionHint'),'textContent',hint);setReadonlyPanelProperty($('patrolActionHint'),'hidden',blocked||!troops.length)}
function togglePatrol(){if(commandBlocked())return;let troops=patrolTroops(),active=troops.filter(e=>e.patrol),count=0;if(active.length){for(let e of active)clearPatrol(e,true);count=active.length;tell('已停止 '+count+' 辆部队的往返巡逻')}else{let guards=troops.filter(e=>e.guardArea);if(guards.length){for(let e of guards)clearGuardArea(e,true);placement=null;attackMode=false;drag=null;clearOrdinaryCommand();tell('已解除所选驻点警戒；请重新右键指定至少60单位远的终点，再按P巡逻');updateUI();return}let walls=movementObstacles();for(let e of troops){if(e.attackQueue||e.moveQueue?.length>1||e.target||e.escortId||e.hold||!e.goal||!patrolPointSafe(e,e,walls)||!patrolPointSafe(e,e.goal,walls)||dist(e,e.goal)<60)continue;let a={x:e.x,y:e.y},b={x:e.goal.x,y:e.goal.y};clearMoveQueue(e);e.patrol={a,b,next:1};e.goal={...b};e.target=null;e.escortId=null;e.hold=false;e.attackMove=true;navigationMemory.delete(e);count++}tell(count?'已设置 '+count+' 辆部队往返巡逻；其余单位保留原命令':'先完成或替换多路点路线；选择战斗车辆，右键指定至少60单位远的安全终点，再按P巡逻')}if(count){placement=null;attackMode=false;drag=null;clearOrdinaryCommand()}updateUI()}
function checkPatrolRoutes(){let troops=state.entities.filter(e=>e.hp>0&&e.patrol);if(!troops.length)return;let walls=movementObstacles(),cancelled=0;for(let e of troops)if(!patrolPointSafe(e,e.patrol.a,walls)||!patrolPointSafe(e,e.patrol.b,walls)){clearPatrol(e,true);cancelled++}if(cancelled)tell(cancelled+' 辆部队的巡逻端点被阻挡，已停止巡逻')}
function arriveAtGoal(e){let arrivalHold=e.holdOnArrival===true;if(e.moveQueue){e.moveQueue.shift();if(!e.moveQueue.length){clearMoveQueue(e,true);if(arrivalHold)completeArrivalHold(e);return}let next=e.moveQueue[0];if(!patrolPointSafe(e,next,movementObstacles())){clearMoveQueue(e,true);tell('分段路线下一路点被建筑或岩石占用，已停止整条路线'+(arrivalHold?'；抵达后坚守预约已取消':''));return}e.goal={...next};e.attackMove=false;navigationMemory.delete(e);return}if(!e.patrol){e.goal=null;if(arrivalHold)completeArrivalHold(e);return}e.patrol.next=1-e.patrol.next;e.goal={...(e.patrol.next?e.patrol.b:e.patrol.a)};navigationMemory.delete(e)}
function drawPatrolOrders(){let troops=patrolTroops().filter(e=>e.patrol);if(troops.length>6)return;ctx.save();ctx.lineWidth=1.5;ctx.setLineDash([4,3]);for(let e of troops)for(let i=0;i<2;i++){let p=i?e.patrol.b:e.patrol.a;ctx.strokeStyle=i===e.patrol.next?'#e2b5ff':'#ae85c5';ctx.beginPath();ctx.arc(p.x,p.y,11,0,Math.PI*2);ctx.stroke();text('巡逻'+(i?'B':'A'),p.x+14,p.y-8,i===e.patrol.next?'#e2b5ff':'#ae85c5',11)}ctx.restore()}
function groundMovementOrderMode(e){if(!canSetFirePriority(e)||!e.goal||e.attackQueue||e.target||e.escortId||e.patrol||e.guardArea||e.hold)return'';return e.attackMove===false?'ordinary':e.attackMove===true?'attack':''}
function canHoldOnArrival(e){return groundMovementOrderMode(e)==='ordinary'}
function arrivalHoldTroops(){return state.entities.filter(e=>selection.has(e.id)&&canHoldOnArrival(e))}
function toggleArrivalHold(){if(commandBlocked())return;let troops=arrivalHoldTroops();if(!troops.length)return tell('先为战斗车辆指定普通地面终点；攻击移动、护航、巡逻和警戒不支持抵达坚守');let cancel=troops.every(e=>e.holdOnArrival===true);for(let e of troops){if(cancel)delete e.holdOnArrival;else e.holdOnArrival=true}tell(cancel?'已取消所选移动部队的抵达坚守预约，原路线继续':'已为 '+troops.length+' 辆战斗车预约抵达后坚守；普通路线最后一段完成后生效');updateUI()}
function completeArrivalHold(e){delete e.holdOnArrival;navigationMemory.delete(e);e.goal=null;e.target=null;e.escortId=null;e.attackMove=false;e.hold=true}
function holdSelection(){if(!state.started||state.result||restartPrompt)return;let troops=state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.hp>0&&defs[e.type].speed&&(defs[e.type].damage||defs[e.type].repairRange));if(!troops.length)return tell('先选择战斗部队');drag=null;placement=null;attackMode=false;clearOrdinaryCommand();let hold=troops.some(e=>!e.hold);troops.forEach(e=>{navigationMemory.delete(e);clearPatrol(e);clearMoveQueue(e);clearGuardArea(e);clearAttackQueue(e);e.hold=hold;e.goal=null;e.target=null;e.escortId=null;e.attackMove=false});tell(!hold?'已解除坚守阵地':troops.some(e=>e.type==='repair')?(troops.some(e=>defs[e.type].damage)?'已坚守阵地：战斗车仅在射程内交战；维修车原地保留维修设置':'已坚守维修位置：不再跟随，自动维修开关不变'):'已坚守阵地：只攻击射程内敌军，不追击');updateUI()}
function orderSpacing(){return state.formationSpacing===64?64:36}
function formationOrder(troops,planned=false){if(troops.length<2)return troops.slice();let cols=Math.ceil(Math.sqrt(troops.length)),anchors=troops.map(e=>{let p=planned?(e.moveQueue?.length?e.moveQueue[e.moveQueue.length-1]:e.goal||e):e;return{entity:e,x:p.x,y:p.y,id:e.id}}).sort((a,b)=>a.y-b.y||a.x-b.x||a.id-b.id),ordered=[];for(let i=0;i<anchors.length;i+=cols){let row=anchors.slice(i,i+cols).sort((a,b)=>a.x-b.x||a.y-b.y||a.id-b.id);ordered.push(...row.map(v=>v.entity))}return ordered}
function changeFormationSpacing(value){let spacing=Number(value);if(!commandBlocked()&&[36,64].includes(spacing)&&state.formationSpacing!==spacing){state.formationSpacing=spacing;tell(spacing===64?'新移动落点改为疏散间距64；现有命令不变，地形和移动仍可能挤近':'新移动落点恢复标准间距36；现有命令不变')}updateUI()}
function groundGoal(e,p,used=[]){let walls=movementObstacles(),valid=q=>q.x>=e.r&&q.x<=WIDTH-e.r&&q.y>=e.r&&q.y<=HEIGHT-e.r&&movementSegmentClear(q,q,e.r,walls)&&used.every(o=>{let gap=e.r+o.r+3,dx=q.x-o.x,dy=q.y-o.y;return dx>=gap||dx<=-gap||dy>=gap||dy<=-gap||dist(q,o)>=gap});for(let ring=0;ring<=12;ring++)for(let dx=-ring;dx<=ring;dx++)for(let dy=-ring;dy<=ring;dy++)if(!ring||Math.abs(dx)===ring||Math.abs(dy)===ring){let q={x:clamp(p.x+dx*36,20,1180),y:clamp(p.y+dy*36,20,780)};if(valid(q))return q}return null}
function baseReturnUnits(){return state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.hp>0&&!e.build&&['tank','scout','artillery','repair'].includes(e.type))}
function baseReturnHQ(){return state.entities.find(e=>e.team===0&&e.type==='hq'&&e.hp>0&&!e.build)||null}
function planBaseReturn(troops,hq){if(!hq)return[];let walls=movementObstacles(),used=[],plans=[],spacing=orderSpacing(),steps=Math.ceil(240/spacing);for(let e of formationOrder(troops)){let candidates=[];for(let dx=-steps;dx<=steps;dx++)for(let dy=-steps;dy<=steps;dy++){let p={x:hq.x+dx*spacing,y:hq.y+dy*spacing};if(dist(p,hq)<=240&&p.x>=e.r&&p.x<=WIDTH-e.r&&p.y>=e.r&&p.y<=HEIGHT-e.r&&movementSegmentClear(p,p,e.r,walls)&&used.every(o=>dist(p,o)>=e.r+o.r+3))candidates.push(p)}candidates.sort((a,b)=>dist(a,hq)-dist(b,hq)||dist(e,a)-dist(e,b)||a.y-b.y||a.x-b.x);if(candidates.length){let goal=candidates[0];used.push({...goal,r:e.r});plans.push({e,goal})}}return plans}
function returnSelectedToBase(){if(commandBlocked())return;let troops=baseReturnUnits(),hq=baseReturnHQ();if(!hq||!troops.length){updateUI();return}let plans=planBaseReturn(troops,hq);if(!plans.length){tell('未找到基地附近落点，保留原命令');updateUI();return}for(let {e,goal}of plans){navigationMemory.delete(e);clearPatrol(e);clearMoveQueue(e);clearGuardArea(e);clearAttackQueue(e);e.escortId=null;e.target=null;e.hold=false;e.goal=goal;e.arrivalRadius=5;e.attackMove=false;e.manual=0}placement=null;attackMode=false;drag=null;clearOrdinaryCommand();tell('已令 '+plans.length+' 辆车返回基地附近'+(plans.length<troops.length?'；另 '+(troops.length-plans.length)+' 辆未找到落点，保留原命令':''));updateUI()}
// UI-only receipt: never placed in state, save data, or the simulation log.
let activeMapCommandReceipt=null;
function clearMapCommandReceipt(){activeMapCommandReceipt=null;let node=$('mapCommandReceipt');if(node){node.textContent='';node.hidden=true}}
function snapshotStopCommandReceipt(){let selected=state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.hp>0),vehicles=selected.filter(e=>defs[e.type].speed),cancelled=vehicles.filter(e=>e.goal!=null||e.target!=null||e.escortId!=null||!!e.patrol||e.moveQueue?.length>0||!!e.guardArea||e.attackQueue?.length>0||e.holdOnArrival===true||(e.type==='harvester'&&(e.manual>0||e.returnCargo||e.oreIndex!=null))).length;return{vehicles:vehicles.length,cancelled,combat:vehicles.some(e=>defs[e.type].damage),miners:vehicles.some(e=>e.type==='harvester'),hold:vehicles.some(e=>e.hold),factory:selected.some(e=>e.type==='factory'),drafts:[attackMode?'攻击点选':'',ordinaryCommandMode?'普通点选':'',appendCommandMode?'追加队列点选':'',drag?'框选':''].filter(Boolean),placement:!!placement,paused:state.paused}}
function showStopCommandReceipt(receipt){let parts=[receipt.cancelled?'已取消 '+receipt.cancelled+' 辆车当前命令':receipt.vehicles?'所选车辆无可取消的当前命令':'未选中车辆'];if(receipt.combat||receipt.miners)parts.push((receipt.combat?'战斗车仍可自动交战':'')+(receipt.combat&&receipt.miners?'，':'')+(receipt.miners?'矿车恢复自动采矿规则':''));let retained=[receipt.hold?'已有坚守':'',receipt.factory?'工厂生产与集结':''].filter(Boolean);if(retained.length)parts.push(retained.join('、')+'保留');if(receipt.drafts.length)parts.push('已退出'+receipt.drafts.join('、'));if(receipt.placement)parts.push('建造待放置保留，Esc取消');if(receipt.paused)parts.push('操作时暂停');let node=$('mapCommandReceipt');if(node){setReadonlyPanelProperty(node,'textContent','停止回执：'+parts.join('；')+'。');setReadonlyPanelProperty(node,'hidden',false)}}
function acceptMapCommand(e,kind){let receipt=activeMapCommandReceipt;if(!receipt)return;receipt.accepted.add(e.id);receipt.kinds.set(kind,(receipt.kinds.get(kind)||0)+1)}
function mapCommandReason(reason){if(activeMapCommandReceipt)activeMapCommandReceipt.reason=reason}
function issue(p,attack=false,append=false){let receipt={selected:state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.hp>0).map(e=>e.id),accepted:new Set(),kinds:new Map(),reason:'',paused:state.paused};activeMapCommandReceipt=receipt;try{return issueMapCommand(p,attack,append)}finally{activeMapCommandReceipt=null;let retained=receipt.selected.filter(id=>!receipt.accepted.has(id)).length,parts=[...receipt.kinds].map(([kind,count])=>kind+' '+count),node=$('mapCommandReceipt');if(node){node.textContent='最近地图命令：'+(parts.length?'已接收 · '+parts.join('、'):'未接收新命令')+'；'+retained+' 个所选存活友方单位保留原命令/设置'+(receipt.reason?'；'+receipt.reason:'')+(parts.length&&receipt.paused?'；下达时暂停，恢复后执行':'')+'。仅回执，不代表抵达或生效结果。';node.hidden=false}}}
// Read-only ordinary/map-command predicates. No command execution or retained snapshot.
// Keep each call at its original execution point; short-circuit order is intentional.
function mapCommandTarget(p,attack=false){let enemy=state.entities.find(e=>e.team===1&&e.hp>0&&dist(e,p)<e.r+9),escort=!enemy&&!attack?state.entities.find(e=>e.team===0&&e.hp>0&&defs[e.type].speed&&e.type!=='repair'&&dist(e,p)<e.r+9):null;return{enemy,escort}}
function mapCommandRockBlocked(p,enemy,escort){return !enemy&&!escort&&terrainObstacles().some(o=>dist(o,p)<o.r+20)}
function mapCommandFactories(){return state.entities.filter(e=>selection.has(e.id)&&e.team===0&&e.type==='factory'&&!e.build)}
function mapCommandOreIndex(p,enemy,attack=false){return !enemy&&!attack?state.ores.findIndex(o=>o.amount>0&&dist(o,p)<=32):-1}
function mapCommandTroops(){return state.entities.filter(e=>selection.has(e.id)&&defs[e.type].speed&&e.team===0&&e.hp>0)}
function mapCommandOreCandidate(e,oreIndex){return oreIndex>=0&&e.type==='harvester'}
function mapCommandEscortCandidate(e,escort){return escort&&validEscort(e,escort)}
function issueMapCommand(p,attack=false,append=false){if(commandBlocked()){mapCommandReason('当前不能下令');return}if(append)return appendOrder(p,attack);if(placement){placement=null;drag=null;mapCommandReason('已取消建造放置');return}let {enemy,escort}=mapCommandTarget(p,attack);if(mapCommandRockBlocked(p,enemy,escort))return (mapCommandReason('岩石区域不能通行'),tell('岩石区域无法通行，请选择隘口或其他空地'));let factories=mapCommandFactories(),rallied=0;if(!enemy)factories.forEach(f=>{let goal=groundGoal({r:16},{x:clamp(p.x,20,WIDTH-20),y:clamp(p.y,20,HEIGHT-20)});if(goal){f.rally=goal;rallied++;acceptMapCommand(f,'工厂集结点')}});if(rallied)tell('工厂集结点已设置');else if(factories.length&&!enemy)tell('找不到安全集结点，保留原设置');let followed=0,guarded=0,assigned=0,oreIndex=mapCommandOreIndex(p,enemy,attack);let troops=mapCommandTroops(),spacing=orderSpacing(),used=[],groundPlans=new Map();if(!troops.length&&!factories.length){attackMode=false;return tell(state.entities.some(e=>selection.has(e.id)&&e.team===0&&e.hp>0&&e.type==='factory'&&e.build)?'工厂尚未完工，暂不能设置集结点':'先选择部队或工厂')}if(!enemy){let candidates=formationOrder(troops.filter(e=>!(mapCommandOreCandidate(e,oreIndex))&&!(mapCommandEscortCandidate(e,escort)))),cols=Math.ceil(Math.sqrt(candidates.length)),rows=Math.ceil(candidates.length/(cols||1));for(let i=0;i<candidates.length;i++){let e=candidates[i],goal=groundGoal(e,{x:clamp(p.x+(i%cols-(cols-1)/2)*spacing,20,WIDTH-20),y:clamp(p.y+(Math.floor(i/cols)-(rows-1)/2)*spacing,20,HEIGHT-20)},used);if(goal){used.push({...goal,r:e.r});groundPlans.set(e.id,goal)}}}troops.forEach(e=>{if(mapCommandOreCandidate(e,oreIndex)){assignOreOrder(e,oreIndex);assigned++;acceptMapCommand(e,'指定矿点');return}if(mapCommandEscortCandidate(e,escort)){navigationMemory.delete(e);clearPatrol(e);clearMoveQueue(e);clearGuardArea(e);clearAttackQueue(e);e.escortId=escort.id;e.target=null;e.goal=null;e.hold=false;e.attackMove=e.type!=='repair';if(e.type==='repair')followed++;else guarded++;acceptMapCommand(e,e.type==='repair'?'维修车跟随':'护航矿车');return}let goal=enemy?null:groundPlans.get(e.id);if(!enemy&&!goal)return;navigationMemory.delete(e);clearPatrol(e);clearMoveQueue(e);clearGuardArea(e);clearAttackQueue(e);e.escortId=null;e.hold=false;e.target=enemy?enemy.id:null;e.goal=goal;e.arrivalRadius=troops.length>1?clamp(e.r,5,16):5;e.attackMove=attack;e.manual=e.type==='harvester'?10:0;if(e.type==='harvester'){e.returnCargo=false;e.oreIndex=null}acceptMapCommand(e,enemy?(defs[e.type].damage?'指定攻击目标':'非战斗车目标记录（不代表攻击）'):(attack&&defs[e.type].damage?'攻击移动':'移动'))});if(followed)tell('维修车已跟随 '+defs[escort.type].name+'：优先维修跟随目标');if(guarded)tell(guarded+' 辆战斗车辆已护航采矿车，附近交战后继续跟随');if(assigned)tell(assigned+' 辆矿车已指定矿点，交付后会返回此处；S恢复自动选矿');if(!enemy&&used.length+followed+guarded+assigned<troops.length)tell('部分单位未找到安全落点，保留原命令');if(!enemy){let failedTroops=troops.length-used.length-followed-guarded-assigned,failedFactories=factories.length-rallied,reasons=[];if(failedTroops)reasons.push(failedTroops+'辆车未找到安全落点');if(failedFactories)reasons.push(failedFactories+'座工厂未找到安全集结点');if(reasons.length)mapCommandReason(reasons.join('；'))}if(rallied||enemy&&troops.length||used.length||followed||guarded||assigned){drag=null;playSound('order')};pushEffect({x:p.x,y:p.y,t:.6,max:.6,type:'order'});attackMode=false}
function approachDestination(e,p,walls){let clear=q=>q.x>=e.r&&q.x<=WIDTH-e.r&&q.y>=e.r&&q.y<=HEIGHT-e.r&&movementSegmentClear(q,q,e.r,walls);if(clear(p))return p;let toward=Math.atan2(e.y-p.y,e.x-p.x);for(let radius of [20,40,60,80,100,140,180])for(let i=0;i<32;i++){let angle=toward+(i%2?1:-1)*Math.ceil(i/2)*Math.PI/16,q={x:p.x+Math.cos(angle)*radius,y:p.y+Math.sin(angle)*radius};if(clear(q))return q}return null}
function get(id){if(id===undefined||id===null)return;return state.entities.find(e=>e.id===id&&e.hp>0)}
let navigationMemory=new WeakMap();
let harvesterDeliveries=new WeakMap();
function recordHarvesterDelivery(e,amount){if(e.team!==0||e.type!=='harvester'||e.hp<=0||!Number.isFinite(amount)||amount<=0)return;let previous=harvesterDeliveries.get(e);harvesterDeliveries.set(e,{trips:(previous?.trips||0)+1,total:(previous?.total||0)+amount,lastAt:state.t})}
function harvesterDeliveryDescription(e){if(!e||e.team!==0||e.type!=='harvester'||e.hp<=0)return'';let record=harvesterDeliveries.get(e),prefix='交矿记录（本次开局/载入后）：';if(!record)return prefix+'尚未交矿';return prefix+record.trips+'趟 · 累计'+Math.round(record.total*100)/100+'\n距上次交矿 '+(Math.floor(Math.max(0,state.t-record.lastAt)*10)/10).toFixed(1)+' 游戏秒'}
function movementSegmentClear(a,b,r,walls){let dx=b.x-a.x,dy=b.y-a.y,len=dx*dx+dy*dy,minX=Math.min(a.x,b.x),maxX=Math.max(a.x,b.x),minY=Math.min(a.y,b.y),maxY=Math.max(a.y,b.y);for(let wall of walls){let gap=r+wall.r+3;if(wall.x<minX-gap||wall.x>maxX+gap||wall.y<minY-gap||wall.y>maxY+gap)continue;let t=len?clamp(((wall.x-a.x)*dx+(wall.y-a.y)*dy)/len,0,1):0,x=a.x+t*dx-wall.x,y=a.y+t*dy-wall.y;if(x*x+y*y<gap*gap-1e-8)return false}return true}
